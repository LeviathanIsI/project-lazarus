<Window x:Class="Lazarus.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lazarus.Desktop.Views"
        xmlns:fx="clr-namespace:Lazarus.Desktop.Views.Effects"
        Title="Starting Lazarus"
        Width="840" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">
    <Border CornerRadius="14" Padding="22"
            Background="#0F0A15"
            BorderBrush="#45236B" BorderThickness="2">
        <Grid>
            <!-- Phoenix geometry resource -->
            <Grid.Resources>
                <Geometry x:Key="PhoenixGeometry">
                    M 100,140
                    C  80,110  80,90   100,70
                    C 120,90  120,110  100,140
                    M 100,90
                    C  92,70   96,50   110,35
                    C 124,50  128,70   120,90
                    M 30,80
                    C 70,40   130,40   170,80
                    M 35,95
                    C 75,60   125,60   165,95
                    M 60,125
                    C 90,115  110,115  140,125
                </Geometry>
            </Grid.Resources>

            <!-- Phoenix stroke (behind the title stack) -->
            <fx:PhoenixPath x:Name="Phoenix"
                            Panel.ZIndex="0"
                            Geometry="{StaticResource PhoenixGeometry}"
                            StrokeThickness="2.6"
                            GlowThickness="11"
                            Opacity="0.9"
                            Margin="0,36,0,0">
                <fx:PhoenixPath.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A900FF" Offset="0"/>
                        <GradientStop Color="#FF00E6" Offset="0.6"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </fx:PhoenixPath.Stroke>
            </fx:PhoenixPath>

            <!-- Particle layer -->
            <fx:ParticleCanvas x:Name="Fx"
                               Margin="0"
                               Panel.ZIndex="1" />

            <!-- Content -->
            <Grid Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title stack -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="LAZARUS"
                               HorizontalAlignment="Center"
                               FontSize="48" FontWeight="Black"
                               Foreground="#E900FF">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#E900FF" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="Powered by the Amity Framework."
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FontSize="14" Foreground="#C8B3E6">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#6A4FB9" Opacity="0.6"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Status -->
                <TextBlock x:Name="StatusText"
                           Grid.Row="1" Margin="0,18,0,6"
                           HorizontalAlignment="Center"
                           FontSize="18" FontFamily="Consolas"
                           Foreground="#C8B3E6" Text="Binding service wraiths..." />

                <!-- Progress -->
                <Grid Grid.Row="2" Margin="12,4,12,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Glow progress bar -->
                    <Border Height="18" CornerRadius="9"
                            Background="#1E0F2E" BorderBrush="#3B215E" BorderThickness="1">
                        <Grid ClipToBounds="True" x:Name="ProgressClip">
                            <Rectangle x:Name="ProgressFill" RadiusX="9" RadiusY="9"
                                       Height="18" HorizontalAlignment="Left" Width="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#A900FF" Offset="0" />
                                        <GradientStop Color="#E900FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                      Color="#E900FF" Opacity="0.9"/>
                                </Rectangle.Effect>
                            </Rectangle>

                            <!-- moving tracer -->
                            <Rectangle x:Name="Tracer" Width="120" Height="18"
                                       HorizontalAlignment="Left" Opacity="0.65">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="PercentText"
                               Grid.Row="1" Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas" FontSize="14"
                               Foreground="#8DE6FF" Text="0%" />
                </Grid>
            </Grid>

            <!-- Close handle (optional) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-8,0,0"
                    Width="56" Height="10" CornerRadius="2"
                    Background="#332244" BorderBrush="#553377" BorderThickness="1"/>
        </Grid>
    </Border>
</Window>