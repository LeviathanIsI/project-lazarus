<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lazarus.Desktop.Views"
        xmlns:fx="clr-namespace:Lazarus.Desktop.Views.Effects"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Lazarus.Desktop.Views.StartupWindow"
        Title="Lazarus - Digital Resurrection"
        Width="840" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">

    <!-- Main container with glassmorphic styling -->
    <Border CornerRadius="14"
            Padding="22"
            Background="#FF000000"
            BorderThickness="2">
        <Grid>
            <!-- Phoenix geometry fragments for assembly animation -->
            <Grid.Resources>
                <!-- Main phoenix path -->
                <Geometry x:Key="PhoenixGeometry">M 100,140 C 80,110 80,90 100,70 C 120,90 120,110 100,140 M 100,90 C 92,70 96,50 110,35 C 124,50 128,70 120,90 M 30,80 C 70,40 130,40 170,80 M 35,95 C 75,60 125,60 165,95 M 60,125 C 90,115 110,115 140,125</Geometry>

                <!-- Fragmented pieces for assembly -->
                <Geometry x:Key="PhoenixFragment1">M 100,140 C 80,110 80,90 100,70</Geometry>
                <Geometry x:Key="PhoenixFragment2">M 100,90 C 92,70 96,50 110,35</Geometry>
                <Geometry x:Key="PhoenixFragment3">M 30,80 C 70,40 130,40 170,80</Geometry>

                <!-- Corruption glitch storyboard -->
                <Storyboard x:Key="CorruptionPulse" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.3" Duration="0:0:0.1"
                                     AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                     From="1" To="1.02" Duration="0:0:0.15"
                                     AutoReverse="True">
                        <DoubleAnimation.EasingFunction>
                            <ElasticEase EasingMode="EaseOut" Oscillations="1"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <!-- Text glitch animation -->
                <Storyboard x:Key="TextGlitch">
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text"
                                                   Duration="0:0:2" RepeatBehavior="Forever">
                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="LAZARUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.1" Value="L4Z4RU5"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="LAZARUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.8" Value="LAZARUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:0.9" Value="0x4C415A"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:1" Value="LAZARUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:1.7" Value="LAZARUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:1.8" Value="LAZ?RUS"/>
                        <DiscreteObjectKeyFrame KeyTime="0:0:1.9" Value="LAZARUS"/>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </Grid.Resources>

            <!-- LAYER 0: Corrupted particle system -->
            <Grid Panel.ZIndex="0">
                <!-- Multiple glass fragment layers for depth -->
                <Canvas x:Name="GlassFragmentsLayer1">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                     From="320" To="-100" Duration="0:0:3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>

                    <!-- Corrupted memory fragments -->
                    <Border Width="18" Height="18" Canvas.Left="80" Canvas.Top="250"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowFlowBrush}"
                            BorderThickness="0.5" CornerRadius="3" Opacity="0.6">
                        <TextBlock Text="0xDE" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="12" Height="12" Canvas.Left="200" Canvas.Top="280"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderGradientBrush}"
                            BorderThickness="0.5" CornerRadius="2" Opacity="0.5">
                        <TextBlock Text="AmItY" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="22" Height="22" Canvas.Left="420" Canvas.Top="200"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowDiagonalFlowBrush}"
                            BorderThickness="0.5" CornerRadius="4" Opacity="0.7">
                        <TextBlock Text="lzrs" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="14" Height="14" Canvas.Left="600" Canvas.Top="220"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderGradientBrush}"
                            BorderThickness="0.5" CornerRadius="2" Opacity="0.55">
                        <TextBlock Text="ZO3Y" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="16" Height="16" Canvas.Left="150" Canvas.Top="260"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowFlowBrush}"
                            BorderThickness="0.5" CornerRadius="3" Opacity="0.65">
                        <TextBlock Text="wl32" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Canvas>

                <!-- Second layer moving at different speed -->
                <Canvas x:Name="GlassFragmentsLayer2">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                     From="320" To="-100" Duration="0:0:2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>

                    <!-- More hex fragments -->
                    <Border Width="20" Height="20" Canvas.Left="350" Canvas.Top="240"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowDiagonalFlowBrush}"
                            BorderThickness="0.5" CornerRadius="3" Opacity="0.7">
                        <TextBlock Text="0xFF" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="10" Height="10" Canvas.Left="520" Canvas.Top="290"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderGradientBrush}"
                            BorderThickness="0.5" CornerRadius="2" Opacity="0.5">
                        <TextBlock Text="BA" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="24" Height="24" Canvas.Left="250" Canvas.Top="210"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowFlowBrush}"
                            BorderThickness="0.5" CornerRadius="4" Opacity="0.8">
                        <TextBlock Text="FACE" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Border Width="15" Height="15" Canvas.Left="700" Canvas.Top="250"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderGradientBrush}"
                            BorderThickness="0.5" CornerRadius="2" Opacity="0.6">
                        <TextBlock Text="BE" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Canvas>

                <!-- Third layer with rainbow fragments -->
                <Canvas x:Name="GlassFragmentsLayer3">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                     From="320" To="-100" Duration="0:0:4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>

                    <!-- Larger corrupted blocks -->
                    <Border Width="30" Height="8" Canvas.Left="180" Canvas.Top="270"
                            Background="{StaticResource RainbowFlowBrush}" 
                            CornerRadius="2" Opacity="0.4"/>
                    <Border Width="25" Height="6" Canvas.Left="450" Canvas.Top="230"
                            Background="{StaticResource RainbowDiagonalFlowBrush}" 
                            CornerRadius="2" Opacity="0.3"/>
                    <Border Width="18" Height="18" Canvas.Left="50" Canvas.Top="190"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource RainbowFlowBrush}"
                            BorderThickness="1" CornerRadius="3" Opacity="0.6">
                        <TextBlock Text="?" Style="{StaticResource MonoTextStyle}" 
                                   FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Canvas>
            </Grid>

            <!-- LAYER 2: Title/Status/Progress -->
            <Grid Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title with corruption glitch -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <Grid>
                        <!-- Background corrupted text -->
                        <TextBlock Text="lzrus" Style="{StaticResource H1TextStyle}"
                                   HorizontalAlignment="Center" Opacity="0.1"
                                   Foreground="{StaticResource RainbowDiagonalFlowBrush}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="2" Y="2"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Main title -->
                        <TextBlock x:Name="TitleText" Text="LAZARUS"
                                   Style="{StaticResource H1TextStyle}"
                                   HorizontalAlignment="Center" FontSize="48">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <LinearGradientBrush.Transform>
                                        <TranslateTransform X="0"/>
                                    </LinearGradientBrush.Transform>
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FF7F00" Offset="0.14"/>
                                    <GradientStop Color="#FFFF00" Offset="0.28"/>
                                    <GradientStop Color="#00FF00" Offset="0.42"/>
                                    <GradientStop Color="#0000FF" Offset="0.57"/>
                                    <GradientStop Color="#4B0082" Offset="0.71"/>
                                    <GradientStop Color="#9400D3" Offset="0.85"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowColor}" 
                                                  BlurRadius="32" ShadowDepth="0" Opacity="0.8"/>
                            </TextBlock.Effect>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource TextGlitch}"/>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Powered by the Amity Framework."
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}" 
                                              BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,6">
                    <TextBlock x:Name="StatusTextCorrupted" 
                               Style="{StaticResource MonoTextStyle}"
                               HorizontalAlignment="Left" FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="0x42696E64696E672073657276696365..." Opacity="0.2" Margin="664,-66,0,66"/>
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource MonoTextStyle}"
                               HorizontalAlignment="Center" FontSize="18"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Binding service wraiths...">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="StatusTextCorrupted_Copy" 
                    Style="{StaticResource MonoTextStyle}"
                    HorizontalAlignment="Left" FontSize="18"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="0x42696E64696E672073657276696365..." Opacity="0.2" Margin="-130,-143,0,143"/>
                </Grid>

                <Grid Grid.Row="2" Margin="12,4,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="43*"/>
                        <ColumnDefinition Width="213*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Glass progress bar background -->
                    <Border Height="18" CornerRadius="9"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassBorderGradientBrush}"
                            BorderThickness="1" Grid.ColumnSpan="2">
                        <Grid ClipToBounds="True" x:Name="ProgressClip">

                            <!-- Corruption scanner tracer -->
                            <!-- Progress fill with rainbow flow -->
                            <Rectangle x:Name="ProgressFill" RadiusX="9" RadiusY="9"
                                       Height="18" HorizontalAlignment="Left" Width="0"
                                       Fill="{StaticResource RainbowFlowBrush}">
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="{StaticResource ShadowColor}"
                                                      BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                                </Rectangle.Effect>
                            </Rectangle>

                        </Grid>
                    </Border>

                    <!-- Percentage with glitch states -->
                    <Grid Grid.Row="1" Margin="239,8,0,0" HorizontalAlignment="Left" Grid.Column="1">
                        <TextBlock x:Name="PercentGlitch" Style="{StaticResource MonoTextStyle}"
                                   FontSize="14" Foreground="{StaticResource ErrorBrush}"
                                   Text="NaN%" Opacity="0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PercentText" Style="{StaticResource MonoTextStyle}"
                                   FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="0%" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Window control handle with glass style -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" 
                    Margin="0,-8,0,0" Width="56" Height="10" CornerRadius="2"
                    Background="{StaticResource GlassCardBrush}"
                    BorderBrush="{StaticResource GlassBorderGradientBrush}"
                    BorderThickness="1" Opacity="0.5"/>
        </Grid>
    </Border>
</Window>
