<Window x:Class="Lazarus.Desktop.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lazarus.Desktop.Views"
        xmlns:fx="clr-namespace:Lazarus.Desktop.Views.Effects"
        Title="Lazarus - Digital Resurrection"
        Width="840" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">

    <!-- Main container with theme-synced styling -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            Padding="22">
        <Grid>
            <!-- Phoenix geometry for reveal animation -->
            <Grid.Resources>
                <!-- Main phoenix path -->
                <Geometry x:Key="PhoenixGeometry">
                    M 100,140
                    C  80,110  80,90   100,70
                    C 120,90  120,110  100,140
                    M 100,90
                    C  92,70   96,50   110,35
                    C 124,50  128,70   120,90
                    M 30,80
                    C 70,40   130,40   170,80
                    M 35,95
                    C 75,60   125,60   165,95
                    M 60,125
                    C 90,115  110,115  140,125
                </Geometry>

                <!-- Tiny title flicker animation -->
                <Storyboard x:Key="TitleFlicker">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.85" Duration="0:0:0.06"
                                     AutoReverse="True"/>
                </Storyboard>
            </Grid.Resources>

            <!-- LAYER 0: Particle system background -->
            <fx:ParticleCanvas x:Name="Fx" Panel.ZIndex="0"/>

            <!-- LAYER 1: Phoenix reveal -->
            <Grid Panel.ZIndex="1">
                <!-- Clean phoenix with theme-synced stroke -->
                <fx:PhoenixPath x:Name="Phoenix" Height="180" Margin="32,24,32,0"
                                VerticalAlignment="Top" Panel.ZIndex="2"
                                StrokeThickness="2.6" GlowThickness="11" Opacity="0.95"
                                Geometry="{StaticResource PhoenixGeometry}">
                    <fx:PhoenixPath.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentBrush}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                        </LinearGradientBrush>
                    </fx:PhoenixPath.Stroke>
                    <fx:PhoenixPath.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="0.95" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </fx:PhoenixPath.Triggers>
                </fx:PhoenixPath>
            </Grid>

            <!-- LAYER 2: Title/Status/Progress -->
            <Grid Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Clean title with subtle flicker -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="LAZARUS"
                               Style="{StaticResource H1TextStyle}"
                               HorizontalAlignment="Center" FontSize="48">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource AccentBrush}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentBrush}"
                                              BlurRadius="32" ShadowDepth="0" Opacity="0.8"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="Powered by the Amity Framework."
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}" 
                                              BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Clean status text -->
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource MonoTextStyle}"
                           Grid.Row="1" Margin="0,18,0,6"
                           HorizontalAlignment="Center" FontSize="18"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Initializing..."/>

                <!-- Clean progress bar -->
                <Grid Grid.Row="2" Margin="12,4,12,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress bar background -->
                    <Border Height="18" CornerRadius="9"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Grid ClipToBounds="True" x:Name="ProgressClip">
                            <!-- Progress fill -->
                            <Rectangle x:Name="ProgressFill" RadiusX="9" RadiusY="9"
                                       Height="18" HorizontalAlignment="Left" Width="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource AccentBrush}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentBrush}"
                                                      BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                                </Rectangle.Effect>
                            </Rectangle>

                            <!-- Contained scanner tracer -->
                            <Rectangle x:Name="Tracer" Width="80" Height="18"
                                       HorizontalAlignment="Left" Opacity="0.6">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#60FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Percentage display -->
                    <TextBlock x:Name="PercentText" Grid.Row="1" Margin="0,8,0,0"
                               Style="{StaticResource MonoTextStyle}"
                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="0%" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Window control handle -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,-8,0,0" Width="56" Height="10" CornerRadius="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" Opacity="0.5"/>
        </Grid>
    </Border>
</Window>