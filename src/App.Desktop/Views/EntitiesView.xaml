<UserControl x:Class="Lazarus.Desktop.Views.EntitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Entity management content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Entity Recognition &amp; Knowledge Graphs" 
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Extract, analyze, and visualize entities and relationships from your data" 
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="Entities page description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Import Data"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Margin="0,0,12,0"
                                AutomationProperties.Name="Import data for analysis"
                                AutomationProperties.HelpText="Import documents or datasets for entity extraction"/>
                        
                        <Button Content="Create Entity"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                AutomationProperties.Name="Create new entity"
                                AutomationProperties.HelpText="Manually create a new entity definition"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Stats Cards -->
                <UniformGrid Grid.Row="1" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="Entity management statistics">
                    
                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Entities" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Relationships" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Knowledge Graphs" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Analysis Status" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{StaticResource InfoBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Ready" 
                                           Style="{StaticResource H2TextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Placeholder Content Area -->
                <Grid Grid.Row="2">
                    <Border Style="{StaticResource GlassCardStyle}"
                            Padding="40">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 2L2 7V17C2 17.5 2.2 18 2.6 18.3L12 22L21.4 18.3C21.8 18 22 17.5 22 17V7L12 2ZM12 4.8L18.9 8.5L12 12.2L5.1 8.5L12 4.8ZM4 9.5L11 13.2V20.1L4 16.4V9.5ZM13 20.1V13.2L20 9.5V16.4L13 20.1Z"
                                          Style="{StaticResource EmptyStateIconStyle}"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Header -->
                            <TextBlock Text="Knowledge Graph Engine Coming Soon"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            
                            <!-- Description -->
                            <TextBlock Style="{StaticResource EmptyStateDescriptionStyle}"
                                       TextAlignment="Center"
                                       AutomationProperties.Name="Entities feature description">
                                <TextBlock.Text>This intelligent entity workspace will extract and map relationships between people, places, concepts, and events from your documents, creating rich knowledge graphs for deeper understanding.</TextBlock.Text>
                            </TextBlock>
                            
                            <!-- Features Preview -->
                            <ItemsControl Margin="0,24,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Named Entity Recognition" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Relationship Mapping" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Knowledge Graphs" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Semantic Search" Margin="4"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
