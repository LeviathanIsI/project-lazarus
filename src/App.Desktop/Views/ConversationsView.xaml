<UserControl x:Class="Lazarus.App.Desktop.Views.ConversationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Lazarus.App.Desktop.Converters"
             xmlns:services="clr-namespace:Lazarus.App.Shared.Services;assembly=Lazarus.App.Shared">
    
    <UserControl.Resources>
        <converters:MessageRoleToAlignmentConverter x:Key="MessageRoleToAlignmentConverter" />
        <converters:MessageRoleToBackgroundConverter x:Key="MessageRoleToBackgroundConverter" />
        <converters:MessageRoleToVisibilityConverter x:Key="MessageRoleToVisibilityConverter" />
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <!-- Message bubble style for user messages - Enhanced -->
        <Style x:Key="UserMessageBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="18,18,6,18" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="60,6,12,6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MaxWidth" Value="450" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="6" ShadowDepth="2" Opacity="0.3" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0.8" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.8" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.0" To="1.0" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.02" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.02" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.0" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.0" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Message bubble style for assistant messages - Enhanced -->
        <Style x:Key="AssistantMessageBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18,18,18,6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="12,6,60,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="450" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#15000000" BlurRadius="4" ShadowDepth="1" Opacity="0.2" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                             From="0.8" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                             From="0.8" To="1.0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.0" To="1.0" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.02" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.02" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 To="1.0" Duration="0:0:0.1" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 To="1.0" Duration="0:0:0.1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Runner Status -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       Text="AI Chat" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryForegroundBrush}" />
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Runner Status Indicator -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8,4"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Enhanced Healthy Status Indicator -->
                        <Ellipse x:Name="HealthyIndicator"
                                 Width="10" Height="10" 
                                 Fill="{DynamicResource SuccessBrush}"
                                 Visibility="{Binding RunnerStatus.IsHealthy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,8,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunnerStatus.IsHealthy}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.5" Duration="0:0:2.0"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- Enhanced Warning Status Indicator -->
                        <Ellipse x:Name="WarningIndicator"
                                 Width="10" Height="10" 
                                 Fill="{DynamicResource WarningBrush}"
                                 Margin="0,0,8,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RunnerStatus.IsConnected}" Value="True" />
                                                <Condition Binding="{Binding RunnerStatus.IsHealthy}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                         From="1.0" To="1.3" Duration="0:0:1.0"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                         From="1.0" To="1.3" Duration="0:0:1.0"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- Enhanced Error Status Indicator -->
                        <Ellipse x:Name="ErrorIndicator"
                                 Width="10" Height="10" 
                                 Fill="{DynamicResource DangerBrush}"
                                 Margin="0,0,8,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RunnerStatus.IsConnected}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.2" Duration="0:0:0.6"
                                                                         AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding RunnerStatus.StatusMessage}" 
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" />
                    </StackPanel>
                </Border>
                
                <Button Command="{Binding NewConversationCommand}"
                        Content="New Chat" 
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="12,6" />
            </StackPanel>
        </Grid>

        <!-- Main Chat Interface -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Conversations Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource LazarusTextBoxStyle}"
                             Margin="12,12,12,8"
                             Padding="10,8"
                             FontSize="13"
                             Tag="Search conversations..." />

                    <!-- Conversations List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" 
                                        Margin="0,0,0,2"
                                        Background="Transparent"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LastMessagePreview}" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding LastActivity, StringFormat={}{0:HH:mm}}" 
                                                       FontSize="10" 
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       HorizontalAlignment="Right" />
                                            <Ellipse Width="6" 
                                                     Height="6" 
                                                     Fill="{DynamicResource AccentBrush}"
                                                     Visibility="{Binding HasUnreadMessages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     HorizontalAlignment="Right"
                                                     Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          Width="4" 
                          Background="Transparent"
                          HorizontalAlignment="Stretch" />

            <!-- Chat Area -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Chat Header -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue='Select a conversation'}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}" />
                                <TextBlock Text="{Binding StatusMessage}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            
                            <Button Grid.Column="1"
                                    Command="{Binding DeleteConversationCommand}"
                                    CommandParameter="{Binding SelectedConversation}"
                                    Content="🗑"
                                    FontSize="14"
                                    Width="32"
                                    Height="32"
                                    Style="{DynamicResource DangerButtonStyle}"
                                    Visibility="{Binding SelectedConversation, Converter={StaticResource NotNullToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Messages Area -->
                    <ScrollViewer Grid.Row="1" 
                                  Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,8,8,0">
                        <ItemsControl ItemsSource="{Binding SelectedConversation.Messages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Skip system messages in UI -->
                                    <Border Visibility="{Binding Role, Converter={StaticResource MessageRoleToVisibilityConverter}}">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource UserMessageBubble}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="{x:Static services:MessageRole.Assistant}">
                                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                            <Setter Property="CornerRadius" Value="12,12,12,4" />
                                                            <Setter Property="Margin" Value="8,4,40,4" />
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            
                                            <StackPanel>
                                                <TextBlock Text="{Binding Content}" 
                                                           TextWrapping="Wrap"
                                                           FontSize="14"
                                                           LineHeight="20">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static services:MessageRole.Assistant}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                
                                                <!-- Enhanced Streaming indicator -->
                                                <!-- Enhanced Streaming indicator with simpler animation -->
                                                <StackPanel Orientation="Horizontal" 
                                                            Margin="0,6,0,0"
                                                            Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" 
                                                             Fill="{DynamicResource SecondaryForegroundBrush}" 
                                                             Margin="0,0,4,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                     From="0.3" To="1.0" Duration="0:0:0.6"
                                                                                                     AutoReverse="True" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6" Height="6" 
                                                             Fill="{DynamicResource SecondaryForegroundBrush}" 
                                                             Margin="0,0,4,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                     From="0.3" To="1.0" Duration="0:0:0.6"
                                                                                                     AutoReverse="True" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6" Height="6" 
                                                             Fill="{DynamicResource SecondaryForegroundBrush}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.4">
                                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                     From="0.3" To="1.0" Duration="0:0:0.6"
                                                                                                     AutoReverse="True" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                                
                                                <!-- Error indicator -->
                                                <TextBlock Text="{Binding Error}" 
                                                           FontSize="11"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding Error, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                
                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" 
                                                           FontSize="10"
                                                           Margin="0,4,0,0"
                                                           Opacity="0.7">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="{x:Static services:MessageRole.Assistant}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Message Input -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource LazarusTextBoxStyle}"
                                     Margin="0,0,10,0"
                                     Padding="12,10"
                                     FontSize="14"
                                     MinHeight="40"
                                     MaxHeight="120"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Tag="Type your message..."
                                     IsEnabled="{Binding RunnerStatus.IsConnected}"
                                     Name="MessageInputTextBox"
                                     AutomationProperties.Name="Chat message input"
                                     AutomationProperties.HelpText="Type your message here and press Enter to send"
                                     SpellCheck.IsEnabled="True">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Command="{Binding SendMessageCommand}"
                                    Content="Send"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Padding="16,8"
                                    MinWidth="60"
                                    IsDefault="True" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>