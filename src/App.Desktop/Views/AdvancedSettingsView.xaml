<UserControl x:Class="Lazarus.Desktop.Views.AdvancedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdvancedSettingsViewModel}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Section Header -->
            <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SectionDescription}" FontSize="14"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"/>

            <!-- Warning Banner -->
            <Border Background="#44FF6B00" BorderBrush="#FF6B00" BorderThickness="1" 
                   CornerRadius="4" Padding="16,12" Margin="0,0,0,24">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="⚠" FontSize="18"/>
                    <Run Text="Warning:" FontWeight="SemiBold"/>
                    <Run Text="These settings are for advanced users. Incorrect configuration may cause instability, reduced performance, or data loss. Proceed with caution."/>
                </TextBlock>
            </Border>

            <!-- Experimental Features Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Experimental Features" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Enable Experimental Features" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding ExperimentalFeatures, Mode=TwoWay}"
                                 Content="Enable features still in development"
                                 ToolTip="Activate experimental features that may be unstable or incomplete"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Beta Updates" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding BetaUpdates, Mode=TwoWay}"
                                 Content="Receive beta version updates"
                                 ToolTip="Get early access to new features and improvements"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Developer Mode" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding DeveloperMode, Mode=TwoWay}"
                                 Content="Enable developer tools and diagnostics"
                                 ToolTip="Show advanced debugging information and development tools"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Performance Tuning Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Performance Tuning" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Memory Limit Override" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Slider Grid.Column="1" 
                               Value="{Binding MemoryLimitOverrideGB, Mode=TwoWay}"
                               Minimum="0" Maximum="256"
                               TickFrequency="8" IsSnapToTickEnabled="True"
                               ToolTip="Override automatic memory management (0 = auto)"/>
                        
                        <TextBlock Grid.Column="2" 
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MemoryLimitOverrideGB}" Value="0">
                                            <Setter Property="Text" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Text" Value="{Binding MemoryLimitOverrideGB, StringFormat='{}{0} GB'}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Thread Pool Size" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Slider Grid.Column="1" 
                               Value="{Binding ThreadPoolSize, Mode=TwoWay}"
                               Minimum="0" Maximum="128"
                               TickFrequency="4" IsSnapToTickEnabled="True"
                               ToolTip="Number of worker threads (0 = auto)"/>
                        
                        <TextBlock Grid.Column="2" 
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThreadPoolSize}" Value="0">
                                            <Setter Property="Text" Value="Auto"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Text" Value="{Binding ThreadPoolSize, StringFormat='{}{0} threads'}"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Process Priority" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="250" HorizontalAlignment="Left"
                                 SelectedItem="{Binding ProcessPriority, Mode=TwoWay}"
                                 ToolTip="Process scheduling priority">
                            <ComboBoxItem Content="Idle"/>
                            <ComboBoxItem Content="Below Normal"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Above Normal"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Realtime"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="CPU Affinity Mask" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding CpuAffinityMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Hexadecimal CPU affinity mask (empty = all cores)"
                                MaxWidth="250" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GPU Configuration Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GPU Configuration" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="GPU Compute Mode" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="250" HorizontalAlignment="Left"
                                 SelectedItem="{Binding GpuComputeMode, Mode=TwoWay}"
                                 ToolTip="GPU compute configuration">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="Exclusive Process"/>
                            <ComboBoxItem Content="Exclusive Thread"/>
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Prohibited"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="CUDA Device Selection" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding CudaDevices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Comma-separated CUDA device IDs (e.g., 0,1)"
                                MaxWidth="250" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="GPU Memory Reserve" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding GpuMemoryReserveMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Reserved GPU memory in MB (0 = none)"
                                MaxWidth="250" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Enable CUDA Graphs" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableCudaGraphs, Mode=TwoWay}"
                                 Content="Use CUDA graphs for optimization"
                                 ToolTip="Enable CUDA graph capture for reduced kernel launch overhead"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Configuration Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Network Configuration" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Proxy URL" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding ProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Proxy server URL for network requests (leave empty for direct connection)"
                                MaxWidth="400" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Connection Timeout" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding ConnectionTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Network connection timeout in seconds"
                                MaxWidth="100" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Max Retry Attempts" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding MaxRetryAttempts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Maximum number of network retry attempts"
                                MaxWidth="100" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="SSL Certificate Validation" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding ValidateSslCertificates, Mode=TwoWay}"
                                 Content="Validate SSL certificates"
                                 ToolTip="Verify SSL certificate authenticity (disable for self-signed certs)"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Debugging & Diagnostics Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Debugging &amp; Diagnostics" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Enable Profiling" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableProfiling, Mode=TwoWay}"
                                 Content="Collect performance profiling data"
                                 ToolTip="Enable detailed performance metrics collection"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Memory Leak Detection" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableMemoryLeakDetection, Mode=TwoWay}"
                                 Content="Monitor for memory leaks"
                                 ToolTip="Enable memory leak detection (impacts performance)"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Crash Dump Generation" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="250" HorizontalAlignment="Left"
                                 SelectedItem="{Binding CrashDumpType, Mode=TwoWay}"
                                 ToolTip="Type of crash dump to generate">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Mini"/>
                            <ComboBoxItem Content="Full"/>
                            <ComboBoxItem Content="With Heap"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Telemetry Collection" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableTelemetry, Mode=TwoWay}"
                                 Content="Send anonymous usage statistics"
                                 ToolTip="Help improve the application by sending anonymous telemetry"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Security Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Secure Storage" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding UseSecureStorage, Mode=TwoWay}"
                                 Content="Encrypt sensitive data at rest"
                                 ToolTip="Use Windows Data Protection API for sensitive information"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Sandbox Runner Processes" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding SandboxRunners, Mode=TwoWay}"
                                 Content="Run inference engines in restricted environment"
                                 ToolTip="Isolate runner processes with reduced privileges"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="API Key Storage" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="250" HorizontalAlignment="Left"
                                 SelectedItem="{Binding ApiKeyStorage, Mode=TwoWay}"
                                 ToolTip="Where to store API keys and tokens">
                            <ComboBoxItem Content="Windows Credential Manager"/>
                            <ComboBoxItem Content="Encrypted File"/>
                            <ComboBoxItem Content="Environment Variables"/>
                            <ComboBoxItem Content="Plain Text (Not Recommended)"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Reset Section to Defaults" 
                       Command="{Binding ResetToDefaultCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="16,8"
                       ToolTip="Reset all advanced settings to their default values"/>
                
                <Button Content="Export Diagnostics" 
                       Command="{Binding ExportDiagnosticsCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="16,8"
                       ToolTip="Export system diagnostics for troubleshooting"/>
                
                <Button Content="Clear Cache" 
                       Command="{Binding ClearCacheCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="16,8"
                       ToolTip="Clear all application caches and temporary data"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>