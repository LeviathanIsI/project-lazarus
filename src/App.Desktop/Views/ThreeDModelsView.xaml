<UserControl x:Class="Lazarus.Desktop.Views.ThreeDModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="3D model management content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="3D Model Generation &amp; Visualization" 
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Create, import, and visualize 3D models with AI-powered generation tools" 
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="3D models page description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Import Models"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Margin="0,0,12,0"
                                AutomationProperties.Name="Import 3D model files"
                                AutomationProperties.HelpText="Import existing 3D models for viewing and editing"/>
                        
                        <Button Content="Generate Model"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                AutomationProperties.Name="Generate new 3D model"
                                AutomationProperties.HelpText="Create new 3D models using AI generation"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Stats Cards -->
                <UniformGrid Grid.Row="1" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="3D model statistics">
                    
                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Models" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Generated Today" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Render Status" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{StaticResource SuccessBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Ready" 
                                           Style="{StaticResource H2TextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Storage Used" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0 MB" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Placeholder Content Area -->
                <Grid Grid.Row="2">
                    <Border Style="{StaticResource GlassCardStyle}"
                            Padding="40">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 2L13.09 8.26L22 9.27L17 14.14L18.18 23.02L12 19.77L5.82 23.02L7 14.14L2 9.27L10.91 8.26L12 2ZM8.5 5.5L12 2.5L15.5 5.5L18.5 8.5L15.5 11.5L12 8.5L8.5 11.5L5.5 8.5L8.5 5.5Z"
                                          Style="{StaticResource EmptyStateIconStyle}"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Header -->
                            <TextBlock Text="3D Model Workshop Coming Soon"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            
                            <!-- Description -->
                            <TextBlock Style="{StaticResource EmptyStateDescriptionStyle}"
                                       TextAlignment="Center"
                                       AutomationProperties.Name="3D models feature description">
                                <TextBlock.Text>This advanced 3D workspace will enable you to generate stunning three-dimensional models from text descriptions, import existing models, and create interactive visualizations for any project.</TextBlock.Text>
                            </TextBlock>
                            
                            <!-- Features Preview -->
                            <ItemsControl Margin="0,24,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Text-to-3D Generation" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Model Viewer" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Texture Mapping" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Animation Tools" Margin="4"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
