<UserControl x:Class="Lazarus.Desktop.Views.ThreeDModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:conv="clr-namespace:Lazarus.Desktop.Converters">

    
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" Collapse="True"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" Collapse="True"/>

        <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TertiaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryGlassButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>

        <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryGlassButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryGlassButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
            <Setter Property="Background" Value="#190000"/>
        </Style>
    </UserControl.Resources><Grid Background="{StaticResource BackgroundBrush}">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="3D Model Generation &amp; Visualization"
                               Style="{StaticResource H1TextStyle}"/>
                    <TextBlock Text="Create, import, and visualize 3D models with AI-powered tools."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Import Models"
                            Command="{Binding ImportModelsCommand}"
                            Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,12,0"/>
                    <Button Content="Generate Model"
                            Command="{Binding GenerateModelCommand}"
                            Style="{StaticResource RainbowAccentButton.AutoFit}"/>
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Models" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding TotalModels}" Style="{StaticResource H1TextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Generated Today" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding GeneratedToday}" Style="{StaticResource H1TextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Render Status" Style="{StaticResource SecondaryTextStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRenderReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding RenderStatusText}" Style="{StaticResource H2TextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Storage Used" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding StorageUsedText}" Style="{StaticResource H1TextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Body -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Library / Sidebar -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource SearchBox.GlassWatermark}"
         Tag="Search models..." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Name" Command="{Binding SortByNameCommand}" Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Date" Command="{Binding SortByDateCommand}" Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Size" Command="{Binding SortBySizeCommand}" Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <ListView ItemsSource="{Binding ModelsView}"
                                  SelectedItem="{Binding Selected}"
                                  Style="{StaticResource GlassListViewStyle}"
                                  ItemContainerStyle="{StaticResource GlassListViewItemStyle}"
                                  BorderThickness="0" DockPanel.Dock="Bottom">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextStyle}"/>
                                            <TextBlock Text="{Binding Extension}" Style="{StaticResource TertiaryTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LastWrite, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" 
                                                       Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Reveal in Explorer" Command="{Binding DataContext.RevealInExplorerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <MenuItem Header="Delete" Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Spacer -->
                <Grid Grid.Column="1"/>

                <!-- Preview / Details -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview host: HelixToolkit Viewport (injected from code-behind) -->
                        <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                            <Grid x:Name="HelixHost" />
                            <!-- Overlay text hints -->
                            <StackPanel x:Name="PreviewOverlay" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewHint" Text="Preview supports OBJ/STL/FBX" Style="{StaticResource TertiaryTextStyle}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                            

                        <!-- Details -->
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Text="Details" Style="{StaticResource BodyStrongTextStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Path" Style="{StaticResource TertiaryTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Selected.FullPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.FullPath}"/>

                                <TextBlock Grid.Row="1" Text="Extension" Style="{StaticResource TertiaryTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Extension}"/>

                                <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource TertiaryTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.SizeText}"/>

                                <TextBlock Grid.Row="3" Text="Modified" Style="{StaticResource TertiaryTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.LastWrite, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>

                                <TextBlock Grid.Row="4" Text="Origin" Style="{StaticResource TertiaryTextStyle}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.Origin}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Open in Folder" Command="{Binding RevealInExplorerCommand}" 
                                        Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" 
                                        Style="{StaticResource DestructiveButtonStyle}"/>
                                <Button Content="Reset View" Click="OnResetView" 
                                        Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0"/>
                                <ToggleButton x:Name="WireframeToggle" Content="Wireframe" IsChecked="False"
                                              Checked="OnToggleWireframe" Unchecked="OnToggleWireframe"
                                              Style="{StaticResource GlassToggleButtonStyle}" Margin="8,0,0,0"/>
                                <ToggleButton x:Name="GridToggle" Content="Grid" IsChecked="True"
                                              Checked="OnToggleGrid" Unchecked="OnToggleGrid"
                                              Style="{StaticResource GlassToggleButtonStyle}" Margin="8,0,0,0"/>
                                <ToggleButton x:Name="AxisToggle" Content="Axis" IsChecked="True"
                                              Checked="OnToggleAxis" Unchecked="OnToggleAxis"
                                              Style="{StaticResource GlassToggleButtonStyle}" Margin="8,0,0,0"/>
                                <Button Content="Front" Click="OnViewFront" Style="{StaticResource SubtleButtonStyle}" Margin="12,0,0,0"/>
                                <Button Content="Top" Click="OnViewTop" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0"/>
                                <Button Content="Iso" Click="OnViewIso" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0"/>
                                <Button Content="Capture" Click="OnCaptureView" Style="{StaticResource SubtleButtonStyle}" Margin="12,0,0,0"/>
                                <Button Content="Turntable" Click="OnCaptureTurntable" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0"/>

                                <!-- Model edit gestures: Left-drag = Rotate, Right-drag = Move; W/E/R while dragging to force Translate/Rotate/Scale; Shift modifies vertical/roll -->
                                <Separator Width="12" Opacity="0"/>
                                <Button Content="Reset Xform" Click="OnResetTransform" Style="{StaticResource SubtleButtonStyle}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>




