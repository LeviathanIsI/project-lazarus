<UserControl x:Class="Lazarus.Desktop.Views.VideosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Video processing content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Video Generation &amp; Analysis" 
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Create, edit, and analyze videos with advanced AI capabilities" 
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="Videos page description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Import Videos"
                                Style="{StaticResource SecondaryGlassButtonStyle}"
                                Margin="0,0,12,0"
                                AutomationProperties.Name="Import video files"
                                AutomationProperties.HelpText="Import existing videos for processing"/>
                        
                        <Button Content="Create Video"
                                Style="{StaticResource RainbowBorderButton}"
                                AutomationProperties.Name="Create new video"
                                AutomationProperties.HelpText="Generate new videos using AI models"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Stats Cards -->
                <UniformGrid Grid.Row="1" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="Video processing statistics">
                    
                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Videos" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Generated Today" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Processing Queue" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{StaticResource SuccessBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Ready" 
                                           Style="{StaticResource H2TextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Storage Used" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0 GB" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Placeholder Content Area -->
                <Grid Grid.Row="2">
                    <Border Style="{StaticResource GlassCardStyle}"
                            Padding="40">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M8 5V19L19 12L8 5ZM2 3H22C23.1 3 24 3.9 24 5V19C24 20.1 23.1 21 22 21H2C0.9 21 0 20.1 0 19V5C0 3.9 0.9 3 2 3Z"
                                          Style="{StaticResource EmptyStateIconStyle}"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Header -->
                            <TextBlock Text="Video Processing Suite Coming Soon"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            
                            <!-- Description -->
                            <TextBlock Style="{StaticResource EmptyStateDescriptionStyle}"
                                       TextAlignment="Center"
                                       AutomationProperties.Name="Videos feature description">
                                <TextBlock.Text>This comprehensive video workspace will provide powerful tools for generating, editing, and analyzing videos using state-of-the-art AI models and computer vision techniques.</TextBlock.Text>
                            </TextBlock>
                            
                            <!-- Features Preview -->
                            <ItemsControl Margin="0,24,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="AI Video Generation" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Motion Analysis" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Auto Editing" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Frame Extraction" Margin="4"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
