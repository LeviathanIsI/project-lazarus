<UserControl x:Class="Lazarus.Desktop.Views.PathsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Paths Settings View LOADED"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,0,0,12"
               Foreground="{StaticResource TextPrimaryBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Models Directory" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" Text="{Binding ModelsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseModelsDirectoryCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Cache Directory" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" Text="{Binding CacheDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseCacheDirectoryCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Exported Chats Folder" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" ToolTip="Where your exported chat files will be saved by default" Text="{Binding ExportedChatsDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseExportedChatsDirectoryCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
