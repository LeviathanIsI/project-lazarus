<UserControl x:Class="Lazarus.Desktop.Views.AvatarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AvatarsSettingsViewModel}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Section Header -->
            <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SectionDescription}" FontSize="14"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"/>

            <!-- Avatar Selection Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Avatar Selection" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Current Avatar" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                                 SelectedItem="{Binding SelectedAvatar, Mode=TwoWay}"
                                 ToolTip="Select the active avatar">
                            <ComboBoxItem Content="Default Assistant"/>
                            <ComboBoxItem Content="Professional"/>
                            <ComboBoxItem Content="Casual"/>
                            <ComboBoxItem Content="Technical Expert"/>
                            <ComboBoxItem Content="Creative"/>
                            <ComboBoxItem Content="Custom Avatar 1"/>
                            <ComboBoxItem Content="Custom Avatar 2"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Choose the avatar style you prefer. 'None' hides visuals but keeps voice."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Avatar Model" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                                 SelectedItem="{Binding AvatarModel, Mode=TwoWay}"
                                 ToolTip="3D model or 2D representation">
                            <ComboBoxItem Content="2D Animated"/>
                            <ComboBoxItem Content="3D Realistic"/>
                            <ComboBoxItem Content="3D Stylized"/>
                            <ComboBoxItem Content="Minimalist"/>
                            <ComboBoxItem Content="Abstract"/>
                            <ComboBoxItem Content="None (Voice Only)"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Where the avatar appears on screen."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Enable Avatar Display" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableAvatarDisplay, Mode=TwoWay}"
                                 Content="Show avatar during interactions"
                                 ToolTip="Display the avatar in the interface"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Lower opacity makes the avatar less distracting; higher is more visible."/>
                </StackPanel>
            </Border>

            <!-- Appearance Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Avatar Size" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding AvatarSize, Mode=TwoWay}"
                                 ToolTip="Display size of the avatar">
                            <ComboBoxItem Content="Small"/>
                            <ComboBoxItem Content="Medium"/>
                            <ComboBoxItem Content="Large"/>
                            <ComboBoxItem Content="Full Screen"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Match the avatar’s colors to your theme or pick a custom scheme."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Avatar Position" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding AvatarPosition, Mode=TwoWay}"
                                 ToolTip="Screen position of the avatar">
                            <ComboBoxItem Content="Bottom Right"/>
                            <ComboBoxItem Content="Bottom Left"/>
                            <ComboBoxItem Content="Top Right"/>
                            <ComboBoxItem Content="Top Left"/>
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Floating"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Turns on motion for the avatar. Disable if you prefer a static look."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Opacity" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Slider Grid.Column="1" 
                               Value="{Binding AvatarOpacity, Mode=TwoWay}"
                               Minimum="0.1" Maximum="1.0"
                               TickFrequency="0.1" IsSnapToTickEnabled="True"
                               ToolTip="Avatar transparency level"/>
                        
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding AvatarOpacity, StringFormat='{}{0:P0}'}"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="How the avatar moves — natural and smooth are good defaults."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Color Theme" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding AvatarColorTheme, Mode=TwoWay}"
                                 ToolTip="Avatar color scheme">
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Purple"/>
                            <ComboBoxItem Content="Orange"/>
                            <ComboBoxItem Content="Monochrome"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Faster feels more lively; slower feels calmer."/>
                </StackPanel>
            </Border>

            <!-- Animation Settings Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Animation Settings" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Enable Animations" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableAnimations, Mode=TwoWay}"
                                 Content="Animate avatar movements"
                                 ToolTip="Enable avatar animation effects"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Choose subtle idle motions to keep the avatar feeling present."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Animation Style" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding AnimationStyle, Mode=TwoWay}"
                                 ToolTip="Type of animation behavior">
                            <ComboBoxItem Content="Natural"/>
                            <ComboBoxItem Content="Smooth"/>
                            <ComboBoxItem Content="Energetic"/>
                            <ComboBoxItem Content="Minimal"/>
                            <ComboBoxItem Content="Robotic"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Mouth movement synced to speech for a more lifelike effect."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Animation Speed" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Slider Grid.Column="1" 
                               Value="{Binding AnimationSpeed, Mode=TwoWay}"
                               Minimum="0.5" Maximum="2.0"
                               TickFrequency="0.1" IsSnapToTickEnabled="True"
                               ToolTip="Speed of avatar animations"/>
                        
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding AnimationSpeed, StringFormat='{}{0:F1}x'}"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Idle Behavior" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding IdleBehavior, Mode=TwoWay}"
                                 ToolTip="Avatar behavior when idle">
                            <ComboBoxItem Content="Breathing"/>
                            <ComboBoxItem Content="Looking Around"/>
                            <ComboBoxItem Content="Blinking"/>
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="None"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Lip Sync" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableLipSync, Mode=TwoWay}"
                                 Content="Synchronize lip movements with speech"
                                 ToolTip="Match avatar mouth movements to audio output"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behavior & Personality Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Behavior &amp; Personality" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Personality Type" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding PersonalityType, Mode=TwoWay}"
                                 ToolTip="Avatar personality characteristics">
                            <ComboBoxItem Content="Professional"/>
                            <ComboBoxItem Content="Friendly"/>
                            <ComboBoxItem Content="Enthusiastic"/>
                            <ComboBoxItem Content="Calm"/>
                            <ComboBoxItem Content="Humorous"/>
                            <ComboBoxItem Content="Serious"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Greeting Message" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding GreetingMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Custom greeting when avatar appears"
                                MaxWidth="400" HorizontalAlignment="Left"
                                TextWrapping="Wrap" MaxHeight="60"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Response Delay" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <TextBox Grid.Column="1" 
                                Text="{Binding ResponseDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Delay before avatar responds (milliseconds)"
                                MaxWidth="100" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Eye Contact" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding MaintainEyeContact, Mode=TwoWay}"
                                 Content="Avatar maintains eye contact"
                                 ToolTip="Avatar looks at camera/user during interaction"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Gesture Frequency" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding GestureFrequency, Mode=TwoWay}"
                                 ToolTip="How often avatar uses gestures">
                            <ComboBoxItem Content="Never"/>
                            <ComboBoxItem Content="Rarely"/>
                            <ComboBoxItem Content="Sometimes"/>
                            <ComboBoxItem Content="Often"/>
                            <ComboBoxItem Content="Always"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Voice Integration Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Voice Integration" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Voice Profile" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                                 SelectedItem="{Binding VoiceProfile, Mode=TwoWay}"
                                 ToolTip="Voice characteristics for the avatar">
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Male - Deep"/>
                            <ComboBoxItem Content="Male - Medium"/>
                            <ComboBoxItem Content="Female - High"/>
                            <ComboBoxItem Content="Female - Medium"/>
                            <ComboBoxItem Content="Neutral"/>
                            <ComboBoxItem Content="Custom Voice 1"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Voice Pitch" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Slider Grid.Column="1" 
                               Value="{Binding VoicePitch, Mode=TwoWay}"
                               Minimum="-12" Maximum="12"
                               TickFrequency="1" IsSnapToTickEnabled="True"
                               ToolTip="Adjust voice pitch (semitones)"/>
                        
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding VoicePitch, StringFormat='{}{0:+#;-#;0} semitones'}"
                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Emotion Expression" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <CheckBox Grid.Column="1" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 IsChecked="{Binding EnableEmotionExpression, Mode=TwoWay}"
                                 Content="Express emotions in voice and face"
                                 ToolTip="Avatar shows emotional responses"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Custom Avatar Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Custom Avatar" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Custom Model Path" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="400"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                    Text="{Binding CustomModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Path to custom 3D model file"/>
                            
                            <Button Grid.Column="1" Content="Browse..." 
                                   Command="{Binding BrowseCustomModelCommand}"
                                   Style="{StaticResource SecondaryGlassButtonStyle}"
                                   Margin="8,0,0,0" Padding="8,4"/>
                        </Grid>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Select a custom model file (e.g., GLB/FBX)."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Custom Texture Path" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="400"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" 
                                    Text="{Binding CustomTexturePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Path to custom texture file"/>
                            
                            <Button Grid.Column="1" Content="Browse..." 
                                   Command="{Binding BrowseCustomTextureCommand}"
                                   Style="{StaticResource SecondaryGlassButtonStyle}"
                                   Margin="8,0,0,0" Padding="8,4"/>
                        </Grid>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                               Text="Optional: supply a texture image for your custom model."/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Animation Set" 
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                        
                        <ComboBox Grid.Column="1" MaxWidth="200" HorizontalAlignment="Left"
                                 SelectedItem="{Binding CustomAnimationSet, Mode=TwoWay}"
                                 ToolTip="Animation set for custom avatar">
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Humanoid"/>
                            <ComboBoxItem Content="Robot"/>
                            <ComboBoxItem Content="Animal"/>
                            <ComboBoxItem Content="Fantasy"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                               Text="Pick an animation set that matches your custom rig."/>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Preview Avatar" 
                       Command="{Binding PreviewAvatarCommand}"
                       Style="{StaticResource PrimaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="16,8"
                       ToolTip="Preview current avatar settings"/>
                
                <Button Content="Import Avatar" 
                       Command="{Binding ImportAvatarCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="16,8"
                       ToolTip="Import avatar from file"/>
                
                <Button Content="Export Avatar" 
                       Command="{Binding ExportAvatarCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="16,8"
                       ToolTip="Export current avatar settings"/>
                
                <Button Content="Reset to Default" 
                       Command="{Binding ResetToDefaultCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="16,8"
                       ToolTip="Reset avatar to default settings"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
