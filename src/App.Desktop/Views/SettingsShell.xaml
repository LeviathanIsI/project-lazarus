<UserControl x:Class="Lazarus.Desktop.Views.SettingsShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left"
                    Width="220"
                    Background="{StaticResource CardBackgroundBrush}">
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="16,24,16,16"/>
            <ListBox ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSectionVm, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource TextPrimaryBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="12,6"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <Border Background="{StaticResource GlassCardBrush}" Padding="24" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}" CornerRadius="8">
            <Border.Resources>
                <!-- Safe template that always presents content; shows placeholder only when Content is null -->
                <ControlTemplate x:Key="SafeContentControlTemplate" TargetType="ContentControl">
                    <Grid>
                        <TextBlock x:Name="Empty"
                                   Text="No content"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,8"/>
                        <ContentPresenter x:Name="Presenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Empty" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Border.Resources>

            <ContentControl x:Name="SettingsContent"
                            Content="{Binding SelectedSectionVm, PresentationTraceSources.TraceLevel=High}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Template="{StaticResource SafeContentControlTemplate}">
                <!-- Debug ContentTemplate to prove layout and type; inner ContentPresenter applies VM->View templates -->
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border Padding="12" BorderThickness="2" BorderBrush="Tomato" Background="#20FF6347" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="DEBUG: ContentTemplate is actually applied" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Path=., StringFormat=VM Type: {0}}"/>
                                <ContentPresenter Content="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </DockPanel>
</UserControl>
