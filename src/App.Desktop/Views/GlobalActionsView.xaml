<UserControl x:Class="Lazarus.Desktop.Views.GlobalActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GlobalActionsViewModel}">
    <UserControl.Resources>
        <!-- Brush fallbacks for safety -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2D2D"/>
        <Style x:Key="SecondaryGlassButtonStyle" TargetType="Button" BasedOn="{x:Null}">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="PrimaryGlassButtonStyle" TargetType="Button" BasedOn="{x:Null}">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="GlassCardStyle" TargetType="Border" BasedOn="{x:Null}">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Section Header -->
            <TextBlock Text="Global Actions" FontSize="24" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Quick access to system-wide operations and utilities" FontSize="14"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24"/>

            <!-- System Operations Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="System Operations" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Updates Card -->
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🔄 Updates" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Check for application updates" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Check for Updates" 
                                       Command="{Binding CheckUpdatesCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Check for new version updates"/>
                                <Button Content="View Changelog" 
                                       Command="{Binding ViewChangelogCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="View recent changes and updates"/>
                            </StackPanel>
                        </Border>

                        <!-- Orchestrator Card -->
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🎛️ Orchestrator" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Control the orchestrator service" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Start" 
                                           Command="{Binding StartOrchestratorCommand}"
                                           Style="{StaticResource PrimaryGlassButtonStyle}"
                                           Padding="16,6" Margin="0,0,4,0"
                                           ToolTip="Start the orchestrator service"/>
                                    <Button Content="Stop" 
                                           Command="{Binding StopOrchestratorCommand}"
                                           Style="{StaticResource SecondaryGlassButtonStyle}"
                                           Padding="16,6" Margin="0,0,4,0"
                                           ToolTip="Stop the orchestrator service"/>
                                    <Button Content="Restart" 
                                           Command="{Binding RestartOrchestratorCommand}"
                                           Style="{StaticResource SecondaryGlassButtonStyle}"
                                           Padding="16,6"
                                           ToolTip="Restart the orchestrator service"/>
                                </StackPanel>
                                <Button Content="View Status" 
                                       Command="{Binding ViewOrchestratorStatusCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="View detailed orchestrator status"/>
                            </StackPanel>
                        </Border>

                        <!-- Runner Card -->
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🚀 Inference Runner" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Manage model inference runner" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Load Last Model" 
                                       Command="{Binding LoadLastModelCommand}"
                                       Style="{StaticResource PrimaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Load the most recently used model"/>
                                <Button Content="Unload Model" 
                                       Command="{Binding UnloadRunnerCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Unload the current model from memory"/>
                                <Button Content="View Runners" 
                                       Command="{Binding ViewRunnersCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="View all available runners"/>
                            </StackPanel>
                        </Border>

                        <!-- Health Monitoring Card -->
                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="💓 Health Monitoring" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="System health and diagnostics" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Run Health Check" 
                                       Command="{Binding RunHealthCheckCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Run comprehensive system health check"/>
                                <Button Content="View Metrics" 
                                       Command="{Binding ViewMetricsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="View system performance metrics"/>
                            </StackPanel>
                        </Border>

                        <!-- Maintenance Card -->
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🔧 Maintenance" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="System maintenance tools" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Clear Cache" 
                                       Command="{Binding ClearCacheCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Clear all temporary files and caches"/>
                                <Button Content="Optimize Database" 
                                       Command="{Binding OptimizeDatabaseCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Optimize and vacuum the database"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup & Restore Card -->
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource GlassCardStyle}" 
                               Padding="16">
                            <StackPanel>
                                <TextBlock Text="💾 Backup &amp; Restore" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Protect your data and settings" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Create Backup" 
                                       Command="{Binding CreateBackupCommand}"
                                       Style="{StaticResource PrimaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Create a full system backup"/>
                                <Button Content="Restore Backup" 
                                       Command="{Binding RestoreBackupCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Restore from a previous backup"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- File Management Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="File Management" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Quick Folders Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="📁 Quick Folders" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Access important directories" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Open Logs" 
                                       Command="{Binding OpenLogsFolderCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Open the logs directory"/>
                                <Button Content="Open Settings" 
                                       Command="{Binding OpenSettingsFolderCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Open the settings directory"/>
                                <Button Content="Open Models" 
                                       Command="{Binding OpenModelsFolderCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Open the models directory"/>
                                <Button Content="Open Data" 
                                       Command="{Binding OpenDataFolderCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Open the data directory"/>
                            </StackPanel>
                        </Border>

                        <!-- Import/Export Card -->
                        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="📋 Import/Export" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Transfer data and configurations" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Import Settings" 
                                       Command="{Binding ImportSettingsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Import settings from JSON file"/>
                                <Button Content="Export Settings" 
                                       Command="{Binding ExportSettingsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Export settings to JSON file"/>
                                <Button Content="Import Models" 
                                       Command="{Binding ImportModelsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Import model files"/>
                                <Button Content="Export Conversations" 
                                       Command="{Binding ExportConversationsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Export conversation history"/>
                            </StackPanel>
                        </Border>

                        <!-- Data Management Card -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" 
                               Padding="16">
                            <StackPanel>
                                <TextBlock Text="🗄️ Data Management" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Manage application data" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Clear Conversations" 
                                       Command="{Binding ClearConversationsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Delete all conversation history"/>
                                <Button Content="Compact Database" 
                                       Command="{Binding CompactDatabaseCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Compact and optimize database storage"/>
                                <Button Content="Reset Settings" 
                                       Command="{Binding ResetSettingsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Reset all settings to defaults"/>
                                <Button Content="Clean Temp Files" 
                                       Command="{Binding CleanTempFilesCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Remove temporary files"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced Tools Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Advanced Tools" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Developer Tools Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🛠️ Developer Tools" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Advanced debugging tools" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Open Console" 
                                       Command="{Binding OpenConsoleCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Open developer console"/>
                                <Button Content="Export Logs" 
                                       Command="{Binding ExportLogsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Export debug logs for analysis"/>
                                <Button Content="Performance Monitor" 
                                       Command="{Binding OpenPerfMonitorCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Open performance monitoring tools"/>
                            </StackPanel>
                        </Border>

                        <!-- Network Tools Card -->
                        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" 
                               Margin="0,0,8,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🌐 Network Tools" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Network and connectivity tools" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Test Connection" 
                                       Command="{Binding TestConnectionCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Test network connectivity"/>
                                <Button Content="Configure Proxy" 
                                       Command="{Binding ConfigureProxyCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Configure proxy settings"/>
                                <Button Content="API Monitor" 
                                       Command="{Binding OpenApiMonitorCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Monitor API requests and responses"/>
                            </StackPanel>
                        </Border>

                        <!-- System Integration Card -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" 
                               Padding="16">
                            <StackPanel>
                                <TextBlock Text="⚙️ System Integration" FontSize="14" FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="System-level integrations" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                         TextWrapping="Wrap"/>
                                <Button Content="Shell Extension" 
                                       Command="{Binding ConfigureShellExtensionCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6"
                                       ToolTip="Configure Windows shell integration"/>
                                <Button Content="File Associations" 
                                       Command="{Binding ConfigureFileAssociationsCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Manage file type associations"/>
                                <Button Content="Startup Options" 
                                       Command="{Binding ConfigureStartupCommand}"
                                       Style="{StaticResource SecondaryGlassButtonStyle}"
                                       HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0"
                                       ToolTip="Configure application startup behavior"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Help & Support Section -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" 
                   Padding="0,0,0,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Help &amp; Support" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    
                    <WrapPanel>
                        <Button Content="📖 Documentation" 
                               Command="{Binding OpenDocumentationCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="Open online documentation"/>
                        
                        <Button Content="❓ Help Center" 
                               Command="{Binding OpenHelpCenterCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="Access help resources"/>
                        
                        <Button Content="🐛 Report Issue" 
                               Command="{Binding ReportIssueCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="Report a bug or issue"/>
                        
                        <Button Content="💬 Community Forum" 
                               Command="{Binding OpenForumCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="Visit community forums"/>
                        
                        <Button Content="📧 Contact Support" 
                               Command="{Binding ContactSupportCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="Contact technical support"/>
                        
                        <Button Content="ℹ️ About" 
                               Command="{Binding ShowAboutCommand}"
                               Style="{StaticResource SecondaryGlassButtonStyle}"
                               Margin="0,0,8,8" Padding="16,8"
                               ToolTip="About this application"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Emergency Actions -->
            <Border Background="#44FF6B00" BorderBrush="#FF6B00" BorderThickness="1" 
                   CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚠️ Emergency Actions" FontSize="16" FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Use these actions only when experiencing critical issues" FontSize="12"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"
                              TextWrapping="Wrap"/>
                    
                    <WrapPanel>
                        <Button Content="Kill All Processes" 
                               Command="{Binding KillAllProcessesCommand}"
                               Background="#CCFF0000"
                               Margin="0,0,8,0" Padding="16,8"
                               ToolTip="Forcefully terminate all runner processes"/>
                        
                        <Button Content="Safe Mode" 
                               Command="{Binding EnterSafeModeCommand}"
                               Background="#CCFF8800"
                               Margin="0,0,8,0" Padding="16,8"
                               ToolTip="Restart in safe mode with minimal features"/>
                        
                        <Button Content="Factory Reset" 
                               Command="{Binding FactoryResetCommand}"
                               Background="#CCFF0000"
                               Padding="16,8"
                               ToolTip="Reset everything to factory defaults (WARNING: Deletes all data)"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>