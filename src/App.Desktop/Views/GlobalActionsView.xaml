<UserControl x:Class="Lazarus.Desktop.Views.GlobalActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Quick Global Actions" Style="{StaticResource H3TextStyle}"/>

    <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,0" Rows="3">
      <!-- Updates -->
      <Border Style="{StaticResource GlassCardStyle}" Margin="6" Padding="12">
        <StackPanel>
          <TextBlock Text="Updates" Style="{StaticResource SmallTextStyle}"/>
          <Button Content="Check for updates now" Command="{Binding CheckUpdatesCommand}" Margin="0,8,0,0" Style="{StaticResource SecondaryGlassButtonStyle}"/>
        </StackPanel>
      </Border>

      <!-- Orchestrator -->
      <Border Style="{StaticResource GlassCardStyle}" Margin="6" Padding="12">
        <StackPanel>
          <TextBlock Text="Orchestrator" Style="{StaticResource SmallTextStyle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Start" Command="{Binding StartOrchestratorCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
            <Button Content="Stop" Command="{Binding StopOrchestratorCommand}" Margin="8,0,0,0" Style="{StaticResource SecondaryGlassButtonStyle}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Runner -->
      <Border Style="{StaticResource GlassCardStyle}" Margin="6" Padding="12">
        <StackPanel>
          <TextBlock Text="Runner" Style="{StaticResource SmallTextStyle}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Load last model" Command="{Binding LoadLastModelCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
            <Button Content="Unload" Command="{Binding UnloadRunnerCommand}" Margin="8,0,0,0" Style="{StaticResource SecondaryGlassButtonStyle}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Folders -->
      <Border Style="{StaticResource GlassCardStyle}" Margin="6" Padding="12">
        <StackPanel>
          <TextBlock Text="Folders" Style="{StaticResource SmallTextStyle}"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Open Logs" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,8" Style="{StaticResource SecondaryGlassButtonStyle}"/>
            <Button Content="Open Settings" Command="{Binding OpenSettingsFolderCommand}" Margin="0,0,8,8" Style="{StaticResource SecondaryGlassButtonStyle}"/>
            <Button Content="Open Models" Command="{Binding OpenModelsFolderCommand}" Margin="0,0,8,8" Style="{StaticResource SecondaryGlassButtonStyle}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </UniformGrid>
  </Grid>
</UserControl>

