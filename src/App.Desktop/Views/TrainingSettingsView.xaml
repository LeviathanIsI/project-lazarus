<UserControl x:Class="Lazarus.Desktop.Views.TrainingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TrainingSettingsViewModel}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,20,0">
            <!-- Section Header -->
            <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SectionDescription}" FontSize="12"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- Training Configuration Group -->
            <TextBlock Text="Training Configuration" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Training Method -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Training Method" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding TrainingMethod, Mode=TwoWay}"
                         ToolTip="Select the training method">
                    <ComboBoxItem Content="Fine-tuning"/>
                    <ComboBoxItem Content="LoRA"/>
                    <ComboBoxItem Content="QLoRA"/>
                    <ComboBoxItem Content="Adapters"/>
                    <ComboBoxItem Content="Prefix Tuning"/>
                    <ComboBoxItem Content="P-Tuning"/>
                    <ComboBoxItem Content="Full Training"/>
                </ComboBox>
            </Grid>

            <!-- Base Model -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Base Model" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding BaseModel, Mode=TwoWay}"
                        ToolTip="Path to base model for training"
                        Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="Browse" 
                       Command="{Binding BrowseBaseModelCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="8,4"/>
            </Grid>

            <!-- Dataset Path -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Dataset" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding DatasetPath, Mode=TwoWay}"
                        ToolTip="Path to training dataset"
                        Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="Browse" 
                       Command="{Binding BrowseDatasetCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="8,4"/>
            </Grid>

            <!-- Hyperparameters Group -->
            <TextBlock Text="Hyperparameters" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Learning Rate -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Learning Rate" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding LearningRate, Mode=TwoWay, StringFormat='{}{0:F6}'}"
                        ToolTip="Training learning rate"/>
                
                <TextBlock Grid.Column="2" 
                          Text="(1e-6 to 1e-3)"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="11"/>
            </Grid>

            <!-- Batch Size -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Batch Size" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding BatchSize, Mode=TwoWay}"
                       Minimum="1" Maximum="256"
                       TickFrequency="8" IsSnapToTickEnabled="True"
                       ToolTip="Number of samples per batch"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding BatchSize}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Gradient Accumulation -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Gradient Accumulation Steps" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding GradientAccumulationSteps, Mode=TwoWay}"
                       Minimum="1" Maximum="32"
                       TickFrequency="1" IsSnapToTickEnabled="True"
                       ToolTip="Steps to accumulate gradients"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding GradientAccumulationSteps}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Epochs -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Training Epochs" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding MaxEpochs, Mode=TwoWay}"
                       Minimum="1" Maximum="100"
                       TickFrequency="5" IsSnapToTickEnabled="True"
                       ToolTip="Maximum training epochs"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding MaxEpochs, StringFormat='{}{0} epochs'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Warmup Steps -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Warmup Steps" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding WarmupSteps, Mode=TwoWay}"
                       Minimum="0" Maximum="1000"
                       TickFrequency="50" IsSnapToTickEnabled="True"
                       ToolTip="Learning rate warmup steps"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding WarmupSteps}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Weight Decay -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Weight Decay" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding WeightDecay, Mode=TwoWay, StringFormat='{}{0:F4}'}"
                        ToolTip="Weight decay for regularization"/>
                
                <TextBlock Grid.Column="2" 
                          Text="(0.0 to 0.1)"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="11"/>
            </Grid>

            <!-- LoRA Settings Group -->
            <TextBlock Text="LoRA Configuration" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- LoRA Rank -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="LoRA Rank" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding LoraRank, Mode=TwoWay}"
                       Minimum="1" Maximum="256"
                       TickFrequency="8" IsSnapToTickEnabled="True"
                       ToolTip="LoRA matrix rank"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding LoraRank}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- LoRA Alpha -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="LoRA Alpha" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding LoraAlpha, Mode=TwoWay}"
                       Minimum="1" Maximum="512"
                       TickFrequency="16" IsSnapToTickEnabled="True"
                       ToolTip="LoRA scaling parameter"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding LoraAlpha}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- LoRA Dropout -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="LoRA Dropout" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding LoraDropout, Mode=TwoWay}"
                       Minimum="0" Maximum="0.5"
                       TickFrequency="0.05" IsSnapToTickEnabled="False"
                       ToolTip="Dropout rate for LoRA layers"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding LoraDropout, StringFormat='{}{0:F2}'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Target Modules -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Target Modules" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetQProj, Mode=TwoWay}"
                             Content="Query Projection (q_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetVProj, Mode=TwoWay}"
                             Content="Value Projection (v_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetKProj, Mode=TwoWay}"
                             Content="Key Projection (k_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetOProj, Mode=TwoWay}"
                             Content="Output Projection (o_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetGateProj, Mode=TwoWay}"
                             Content="Gate Projection (gate_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetUpProj, Mode=TwoWay}"
                             Content="Up Projection (up_proj)"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding TargetDownProj, Mode=TwoWay}"
                             Content="Down Projection (down_proj)"/>
                </StackPanel>
            </Grid>

            <!-- Optimization Group -->
            <TextBlock Text="Optimization" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Optimizer -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Optimizer" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding Optimizer, Mode=TwoWay}"
                         ToolTip="Optimization algorithm">
                    <ComboBoxItem Content="AdamW"/>
                    <ComboBoxItem Content="Adam"/>
                    <ComboBoxItem Content="SGD"/>
                    <ComboBoxItem Content="AdaGrad"/>
                    <ComboBoxItem Content="RMSprop"/>
                    <ComboBoxItem Content="AdaFactor"/>
                    <ComboBoxItem Content="Lion"/>
                </ComboBox>
            </Grid>

            <!-- LR Scheduler -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="LR Scheduler" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding LRScheduler, Mode=TwoWay}"
                         ToolTip="Learning rate scheduler">
                    <ComboBoxItem Content="Linear"/>
                    <ComboBoxItem Content="Cosine"/>
                    <ComboBoxItem Content="Cosine with Restarts"/>
                    <ComboBoxItem Content="Polynomial"/>
                    <ComboBoxItem Content="Constant"/>
                    <ComboBoxItem Content="Constant with Warmup"/>
                </ComboBox>
            </Grid>

            <!-- Mixed Precision -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Mixed Precision" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding MixedPrecision, Mode=TwoWay}"
                         ToolTip="Mixed precision training">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="FP16"/>
                    <ComboBoxItem Content="BF16"/>
                    <ComboBoxItem Content="FP8"/>
                </ComboBox>
            </Grid>

            <!-- Gradient Checkpointing -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Memory Optimization" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding GradientCheckpointing, Mode=TwoWay}"
                             Content="Enable gradient checkpointing"
                             ToolTip="Trade compute for memory"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding UseFlashAttention, Mode=TwoWay}"
                             Content="Use Flash Attention"
                             ToolTip="Memory-efficient attention"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding Use8BitOptimizer, Mode=TwoWay}"
                             Content="Use 8-bit optimizer"
                             ToolTip="Reduce optimizer memory usage"/>
                </StackPanel>
            </Grid>

            <!-- Checkpointing Group -->
            <TextBlock Text="Checkpointing" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Output Directory -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Output Directory" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding OutputDirectory, Mode=TwoWay}"
                        ToolTip="Where to save checkpoints"
                        Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="Browse" 
                       Command="{Binding BrowseOutputCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="8,4"/>
            </Grid>

            <!-- Checkpoint Frequency -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Save Every" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding CheckpointFrequencyMinutes, Mode=TwoWay}"
                       Minimum="5" Maximum="120"
                       TickFrequency="5" IsSnapToTickEnabled="True"
                       ToolTip="Save checkpoint interval"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding CheckpointFrequencyMinutes, StringFormat='{}{0} minutes'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Max Checkpoints -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Max Checkpoints" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding MaxCheckpoints, Mode=TwoWay}"
                       Minimum="1" Maximum="20"
                       TickFrequency="1" IsSnapToTickEnabled="True"
                       ToolTip="Maximum checkpoints to keep"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding MaxCheckpoints}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Resume from Checkpoint -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Resume Training" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <CheckBox Grid.Column="1" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsChecked="{Binding ResumeFromCheckpoint, Mode=TwoWay}"
                         Content="Resume from latest checkpoint"
                         ToolTip="Continue training from last checkpoint"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Monitoring Group -->
            <TextBlock Text="Monitoring" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Logging Steps -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Log Every" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding LoggingSteps, Mode=TwoWay}"
                       Minimum="1" Maximum="100"
                       TickFrequency="5" IsSnapToTickEnabled="True"
                       ToolTip="Steps between logging"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding LoggingSteps, StringFormat='{}{0} steps'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Evaluation Steps -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Evaluate Every" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                       Value="{Binding EvalSteps, Mode=TwoWay}"
                       Minimum="10" Maximum="1000"
                       TickFrequency="50" IsSnapToTickEnabled="True"
                       ToolTip="Steps between evaluations"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding EvalSteps, StringFormat='{}{0} steps'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Monitoring Options -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Monitoring" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding UseTensorboard, Mode=TwoWay}"
                             Content="Enable TensorBoard"
                             ToolTip="Log to TensorBoard"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding UseWandB, Mode=TwoWay}"
                             Content="Enable Weights &amp; Biases"
                             ToolTip="Log to W&amp;B"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogGradients, Mode=TwoWay}"
                             Content="Log gradients"
                             ToolTip="Track gradient statistics"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Start Training" 
                       Command="{Binding StartTrainingCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="12,6"/>
                
                <Button Content="Stop Training" 
                       Command="{Binding StopTrainingCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="12,6"/>
                
                <Button Content="View Logs" 
                       Command="{Binding ViewLogsCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="12,6"/>
                
                <Button Content="Reset to Defaults" 
                       Command="{Binding ResetToDefaultCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>