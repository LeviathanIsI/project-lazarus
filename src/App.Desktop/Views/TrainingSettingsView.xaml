<UserControl x:Class="Lazarus.Desktop.Views.TrainingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Default Trainer" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="200" Text="{Binding TrainingDefaultTrainer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Working Directory" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" Text="{Binding TrainingWorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseTrainingWorkingDirectoryCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
  </StackPanel>
</UserControl>

