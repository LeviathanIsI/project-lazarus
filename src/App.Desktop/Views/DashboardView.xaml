<UserControl x:Class="Lazarus.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Style="{StaticResource LoadingOverlayStyle}"
              Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl Template="{StaticResource RainbowLoadingSpinnerTemplate}"/>
                <TextBlock Text="Loading Dashboard..."
                           Style="{StaticResource EmptyStateHeaderStyle}"
                           Margin="0,20,0,16"
                           AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar Style="{StaticResource RainbowGlassProgressBarStyle}"
                             Width="200"
                             Height="8"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Dashboard content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Welcome Message for First Time Users -->
                <Grid x:Name="WelcomeSection" 
                      Grid.Row="0" 
                      Visibility="Collapsed"
                      Margin="0,0,0,32">
                    <ContentPresenter Content="{StaticResource WelcomeState}"/>
                </Grid>

                <!-- Stats Cards -->
                <UniformGrid Grid.Row="0" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="Dashboard statistics">
                    
                    <!-- Active Sessions Card -->
                    <Border Style="{StaticResource RainbowBorderCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20"
                            AutomationProperties.Name="Active sessions metric">
                        <StackPanel>
                            <TextBlock Text="Active Sessions" 
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="Active sessions label"/>
                            <TextBlock x:Name="ActiveSessionsValue"
                                       Text="3" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"
                                       AutomationProperties.Name="3 active sessions"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <!-- Tokens Generated Card -->
                    <Border Style="{StaticResource RainbowBorderCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20"
                            AutomationProperties.Name="Tokens generated today metric">
                        <StackPanel>
                            <TextBlock Text="Tokens Today" 
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="Tokens generated today label"/>
                            <TextBlock x:Name="TokensValue"
                                       Text="42.5K" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"
                                       AutomationProperties.Name="42,500 tokens generated today"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <!-- Model Status Card -->
                    <Border Style="{StaticResource RainbowBorderCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20"
                            AutomationProperties.Name="Model status indicator">
                        <StackPanel>
                            <TextBlock Text="Model Status" 
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="Model status label"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Style="{StaticResource RainbowStatusDotStyle}"
                                         Margin="0,0,8,0"
                                         AutomationProperties.Name="Status indicator: Ready"/>
                                <TextBlock x:Name="ModelStatusValue"
                                           Text="Ready" 
                                           Style="{StaticResource H2TextStyle}"
                                           AutomationProperties.Name="Model status: Ready"
                                           AutomationProperties.LiveSetting="Assertive"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Performance Card -->
                    <Border Style="{StaticResource RainbowBorderCardStyle}" 
                            Padding="20"
                            AutomationProperties.Name="Average response time metric">
                        <StackPanel>
                            <TextBlock Text="Avg Response" 
                                       Style="{StaticResource SecondaryTextStyle}"
                                       AutomationProperties.Name="Average response time label"/>
                            <TextBlock x:Name="ResponseTimeValue"
                                       Text="1.2s" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"
                                       AutomationProperties.Name="Average response time: 1.2 seconds"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Recent Activity Header -->
                <TextBlock Grid.Row="1" 
                           Text="Recent Activity" 
                           Style="{StaticResource RainbowTextStyle}"
                           Margin="0,0,0,16"
                           AutomationProperties.HeadingLevel="Level2"/>

                <!-- Activity Content Area -->
                <Grid Grid.Row="2">
                    <!-- Empty State for No Activity -->
                    <Grid x:Name="NoActivityEmptyState" 
                          Visibility="Collapsed">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Phoenix Logo for Empty Activity State -->
                            <ContentControl Width="64" 
                                            Height="64" 
                                            Margin="0,0,0,16"
                                            ContentTemplate="{StaticResource PhoenixLogoLargeTemplate}"/>
                            
                            <!-- Header -->
                            <TextBlock Text="No Recent Activity"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level3"/>
                            
                            <!-- Description -->
                            <TextBlock Text="Start a conversation to see your activity history here"
                                       Style="{StaticResource EmptyStateDescriptionStyle}"
                                       AutomationProperties.Name="No activity message"/>
                            
                            <!-- Action -->
                            <Button Content="Start New Chat"
                                    Style="{StaticResource RainbowAccentButton.AutoFit}"
                                    AutomationProperties.Name="Start new chat conversation"
                                    AutomationProperties.HelpText="Creates a new conversation to begin activity"/>
                        </StackPanel>
                    </Grid>

                    <!-- Activity List -->
                    <ItemsControl x:Name="ActivityList"
                                  AutomationProperties.Name="Recent activity list"
                                  Focusable="True"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Focusable" Value="True"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        
                        <!-- Sample Activity Item -->
                        <Border Style="{StaticResource InteractiveRainbowCardStyle}"
                                Padding="20"
                                Margin="0,0,0,12"
                                Focusable="True"
                                AutomationProperties.Name="Activity: New chat session started with Mistral-7B model, 2 minutes ago"
                                >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Activity Icon -->
                                <Border Grid.Column="0" 
                                        Width="40" 
                                        Height="40" 
                                        Background="{StaticResource RainbowRadialBrush}"
                                        CornerRadius="20"
                                        Margin="0,0,16,0">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M21 11.5C21 16.75 16.75 21 11.5 21C6.25 21 2 16.75 2 11.5C2 6.25 6.25 2 11.5 2M11.5 2C16.75 2 21 6.25 21 11.5V13C21 14.5 19.5 16 18 16C16.5 16 15 14.5 15 13V11.5"
                                                  Fill="White"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                
                                <!-- Activity Details -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="New chat session started" 
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Using Mistral-7B model" 
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                
                                <!-- Timestamp -->
                                <TextBlock Grid.Column="2" 
                                           Text="2 min ago" 
                                           Style="{StaticResource SmallTextStyle}"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Status Notifications Area -->
        <StackPanel x:Name="NotificationsArea"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="32,16"
                    Panel.ZIndex="5">
            
            <!-- Success Notification (Hidden by default) -->
            <Border x:Name="SuccessNotification"
                    Style="{StaticResource SuccessNotificationStyle}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" 
                          Data="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                          Fill="{StaticResource SuccessBrush}"
                          Width="16" Height="16"
                          Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="Operation completed successfully"
                               Style="{StaticResource BodyTextStyle}"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>
            
            <!-- Error Notification (Hidden by default) -->
            <Border x:Name="ErrorNotification"
                    Style="{StaticResource ErrorNotificationStyle}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" 
                          Data="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
                          Fill="{StaticResource ErrorBrush}"
                          Width="16" Height="16"
                          Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               x:Name="ErrorMessage"
                               Text="An error occurred"
                               Style="{StaticResource BodyTextStyle}"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
