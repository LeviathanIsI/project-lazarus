<UserControl x:Class="Lazarus.Desktop.Views.Training.VideosDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Videos" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <Border Grid.Row="1" Style="{StaticResource GlassPill}" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="🎬 No job selected — editing draft configuration" Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Video Files" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="No video files imported yet" 
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Video Configuration" Style="{StaticResource H3TextStyle}" Margin="0,0,0,12"/>
                        
                        <!-- Core Video Parameters -->
                        <TextBlock Text="Core Parameters" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                    
                        <!-- Base Model / Batch Size -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Width="160">
                                <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[BaseModel]}">
                                    <ComboBoxItem Content="stable-video-diffusion"/>
                                    <ComboBoxItem Content="animatediff"/>
                                    <ComboBoxItem Content="pika-labs"/>
                                    <ComboBoxItem Content="runway-gen2"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Batch Size (Clips)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[BatchSize]}">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="4"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Learning Rate with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-5" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="1e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-5" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-6" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-6" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Frame Settings Expander -->
                        <Expander Header="Frame and Sequence Settings" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Resolution" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Resolution]}">
                                            <ComboBoxItem Content="256x256"/>
                                            <ComboBoxItem Content="512x512"/>
                                            <ComboBoxItem Content="768x768"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Clip Length (frames)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[ClipLength]}">
                                            <ComboBoxItem Content="8"/>
                                            <ComboBoxItem Content="16"/>
                                            <ComboBoxItem Content="24"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Frame Rate (FPS)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[FrameRate]}">
                                            <ComboBoxItem Content="12"/>
                                            <ComboBoxItem Content="24"/>
                                            <ComboBoxItem Content="30"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Stride/Overlap" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[StrideOverlap]}">
                                            <ComboBoxItem Content="No Overlap"/>
                                            <ComboBoxItem Content="50% Overlap"/>
                                            <ComboBoxItem Content="75% Overlap"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Training Duration -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Training Duration" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Content="Epochs" IsChecked="{Binding UseEpochs}" GroupName="VideoDurationMode" Margin="8,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding Params[Epochs], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseEpochs}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Steps" IsChecked="{Binding UseSteps}" GroupName="VideoDurationMode" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding Params[MaxSteps], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseSteps}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Video Augmentations -->
                        <Expander Header="Video Augmentations" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <CheckBox Content="Temporal Jitter" IsChecked="{Binding Params[TemporalJitter], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Color Jitter" IsChecked="{Binding Params[ColorJitter], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Spatial Transforms" IsChecked="{Binding Params[SpatialTransforms], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Noise Injection" IsChecked="{Binding Params[NoiseInjection], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Loss & Regularization -->
                        <Expander Header="Loss and Regularization" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Loss Function / Temporal Smoothing -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Loss Function" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[LossFunction]}">
                                            <ComboBoxItem Content="Pixel (L2)"/>
                                            <ComboBoxItem Content="Perceptual (VGG)"/>
                                            <ComboBoxItem Content="Temporal Consistency"/>
                                            <ComboBoxItem Content="Combined"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Temporal Smoothing Weight" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[TemporalSmoothingWeight], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Regularization Dataset -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                        <TextBlock Text="Regularization Dataset (Natural Videos)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="📁" Style="{StaticResource SolidDarkButton}" Margin="8,0,0,0"/>
                                            <TextBox Text="{Binding Params[RegularizationDataset], UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Advanced Video Controls -->
                        <Expander Header="Advanced Video Controls" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Precision / Optimizer -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Precision" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Precision]}">
                                            <ComboBoxItem Content="FP16"/>
                                            <ComboBoxItem Content="BF16"/>
                                            <ComboBoxItem Content="FP32"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Optimizer" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Optimizer]}">
                                            <ComboBoxItem Content="adamw"/>
                                            <ComboBoxItem Content="adam"/>
                                            <ComboBoxItem Content="lion"/>
                                            <ComboBoxItem Content="sgd"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Gradient Accumulation / Checkpoint Frequency -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Gradient Accumulation Steps" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GradientAccumulation]}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="8"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Checkpoint Every (steps)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[CheckpointFrequency], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 3: Validation Split -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Validation Split %" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[ValidationSplit]}">
                                            <ComboBoxItem Content="0"/>
                                            <ComboBoxItem Content="0.1"/>
                                            <ComboBoxItem Content="0.15"/>
                                            <ComboBoxItem Content="0.2"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🎬 Import Videos" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
