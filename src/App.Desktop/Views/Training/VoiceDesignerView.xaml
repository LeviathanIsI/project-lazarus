<UserControl x:Class="Lazarus.Desktop.Views.Training.VoiceDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Voice" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <!-- Empty state banner -->
        <Border Grid.Row="1" 
                Style="{StaticResource GlassPill}" 
                Padding="12,8" 
                Margin="0,0,0,12">
            <TextBlock Text="🎙️ No job selected — editing draft configuration" 
                       Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Audio Library -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Audio Files" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    
                    <ItemsControl ItemsSource="{Binding Draft.AudioFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="🎵" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource SolidDarkButton}"/>
                                        <TextBlock Text="{Binding}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="No audio files imported yet" 
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Draft.AudioFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Right: Configuration -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Voice Configuration" Style="{StaticResource H3TextStyle}" Margin="0,0,0,12"/>
                        
                        <!-- Core Voice Settings -->
                        <TextBlock Text="Core Settings" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Row 1: Base Model / Training Type -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[BaseModel]}">
                                    <ComboBoxItem Content="whisper-large"/>
                                    <ComboBoxItem Content="whisper-medium"/>
                                    <ComboBoxItem Content="wav2vec2-large"/>
                                    <ComboBoxItem Content="tacotron2"/>
                                    <ComboBoxItem Content="vits"/>
                                    <ComboBoxItem Content="xtts-v2"/>
                                    <ComboBoxItem Content="piper-tts"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Training Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[TrainingType]}">
                                    <ComboBoxItem Content="TTS Fine-tune"/>
                                    <ComboBoxItem Content="Voice Cloning"/>
                                    <ComboBoxItem Content="Speech Enhancement"/>
                                    <ComboBoxItem Content="Speaker Verification"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Row 2: Sample Rate / Speaker Embedding -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Sample Rate (Hz)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[SampleRate]}">
                                    <ComboBoxItem Content="16000"/>
                                    <ComboBoxItem Content="22050"/>
                                    <ComboBoxItem Content="24000"/>
                                    <ComboBoxItem Content="44100"/>
                                    <ComboBoxItem Content="48000"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                <TextBlock Text="Speaker Embedding Size" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[EmbeddingSize]}">
                                    <ComboBoxItem Content="128"/>
                                    <ComboBoxItem Content="256"/>
                                    <ComboBoxItem Content="512"/>
                                    <ComboBoxItem Content="1024"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Row 3: Learning Rate with Quick-Select -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" 
                                             Width="120" 
                                             Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                             Margin="8,0,0,0"/>
                                    <WrapPanel>
                                        <Button Content="1e-3" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-3" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="5e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="1e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-4" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                        <Button Content="5e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-5" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="1e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-5" Style="{StaticResource SolidDarkButton}"/>
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                            
                            <!-- Row 4: Batch Size with Quick-Select -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <TextBlock Text="Batch Size (Audio Samples per Step)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" 
                                             Width="120" 
                                             Text="{Binding Params[BatchSize], UpdateSourceTrigger=PropertyChanged}" 
                                             Margin="8,0,0,0"/>
                                    <WrapPanel>
                                        <Button Content="1" Command="{Binding SetBatchSizeCommand}" CommandParameter="1" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="2" Command="{Binding SetBatchSizeCommand}" CommandParameter="2" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="4" Command="{Binding SetBatchSizeCommand}" CommandParameter="4" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                        <Button Content="8" Command="{Binding SetBatchSizeCommand}" CommandParameter="8" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="16" Command="{Binding SetBatchSizeCommand}" CommandParameter="16" Style="{StaticResource SolidDarkButton}"/>
                                    </WrapPanel>
                                </DockPanel>
                            </StackPanel>
                            
                            <!-- Row 5: Training Duration -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <TextBlock Text="Training Duration" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <RadioButton Content="Epochs" IsChecked="{Binding UseEpochs}" GroupName="VoiceDurationMode" Margin="8,0,8,0"/>
                                        <TextBox Width="80" Text="{Binding Params[Epochs], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseEpochs}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Steps" IsChecked="{Binding UseSteps}" GroupName="VoiceDurationMode" Margin="0,0,8,0"/>
                                        <TextBox Width="80" Text="{Binding Params[MaxSteps], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseSteps}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Advanced Voice Settings -->
                        <Expander Header="Advanced Voice Settings" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Optimizer / Loss Function -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Optimizer" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Optimizer]}">
                                            <ComboBoxItem Content="adamw"/>
                                            <ComboBoxItem Content="adam"/>
                                            <ComboBoxItem Content="sgd"/>
                                            <ComboBoxItem Content="adagrad"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Loss Function" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[LossFunction]}">
                                            <ComboBoxItem Content="mse"/>
                                            <ComboBoxItem Content="l1"/>
                                            <ComboBoxItem Content="perceptual"/>
                                            <ComboBoxItem Content="spectral"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Warmup / Scheduler -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Warmup Steps" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[WarmupSteps], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="LR Scheduler" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[LRScheduler]}">
                                            <ComboBoxItem Content="cosine"/>
                                            <ComboBoxItem Content="linear"/>
                                            <ComboBoxItem Content="exponential"/>
                                            <ComboBoxItem Content="step"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 3: Validation / Checkpoints -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Validation Split %" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[ValidationSplit]}">
                                            <ComboBoxItem Content="0.1"/>
                                            <ComboBoxItem Content="0.15"/>
                                            <ComboBoxItem Content="0.2"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Save Every (steps)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[SaveSteps], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 4: Audio Augmentation -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                        <TextBlock Text="Audio Augmentation" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" Content="Pitch Shift" IsChecked="{Binding Params[PitchShift], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,0,2"/>
                                            <CheckBox Grid.Column="1" Content="Time Stretch" IsChecked="{Binding Params[TimeStretch], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,0,2"/>
                                            <CheckBox Grid.Column="2" Content="Background Noise" IsChecked="{Binding Params[BackgroundNoise], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,0,2"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <CheckBox Grid.Column="0" Content="Volume Jitter" IsChecked="{Binding Params[VolumeJitter], Converter={StaticResource StringToBooleanConverter}}"/>
                                            <CheckBox Grid.Column="1" Content="Spectral Masking" IsChecked="{Binding Params[SpectralMasking], Converter={StaticResource StringToBooleanConverter}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🎵 Import Audio" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
