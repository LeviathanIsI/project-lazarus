<UserControl x:Class="Lazarus.Desktop.Views.Training.VoiceDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Voice" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <!-- Empty state banner -->
        <Border Grid.Row="1" 
                Style="{StaticResource GlassPill}" 
                Padding="12,8" 
                Margin="0,0,0,12">
            <TextBlock Text="🎙️ No job selected — editing draft configuration" 
                       Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Audio Library -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Audio Files" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                    
                    <ItemsControl ItemsSource="{Binding Draft.AudioFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="🎵" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource SolidDarkButton}"/>
                                        <TextBlock Text="{Binding}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="No audio files imported yet" 
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Draft.AudioFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Right: Parameters -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Voice Parameters" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GlassComboBoxStyle}">
                            <ComboBoxItem Content="whisper-large"/>
                            <ComboBoxItem Content="whisper-medium"/>
                            <ComboBoxItem Content="wav2vec2"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Sample Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Params[SampleRate], UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource GlassTextBoxStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource GlassTextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🎵 Import Audio" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
