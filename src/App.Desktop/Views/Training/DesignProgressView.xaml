<UserControl x:Class="Lazarus.Desktop.Views.Training.DesignProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource GlassPanelElevated}" Padding="16">
            <StackPanel>
                <TextBlock Text="Progress Mode — Charts &amp; Logs" 
                           Style="{StaticResource H2TextStyle}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,16"/>
                <TextBlock Text="Full-screen monitoring interface for active training jobs" 
                           Style="{StaticResource SecondaryTextStyle}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
