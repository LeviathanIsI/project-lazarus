<UserControl x:Class="Lazarus.Desktop.Views.Training.EntitiesDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Entities" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <Border Grid.Row="1" Style="{StaticResource GlassPill}" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="🏷️ No job selected — editing draft configuration" Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Entity Assets" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="No entity assets imported yet" 
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Entity Configuration" Style="{StaticResource H3TextStyle}" Margin="0,0,0,12"/>
                        
                        <!-- Core Entity Parameters -->
                        <TextBlock Text="Core Parameters" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                    
                        <!-- Base Models Selection -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Width="160">
                                <TextBlock Text="Base 3D Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[Base3DModel]}">
                                    <ComboBoxItem Content="human-rigged"/>
                                    <ComboBoxItem Content="character-base"/>
                                    <ComboBoxItem Content="anime-avatar"/>
                                    <ComboBoxItem Content="realistic-human"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Voice Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[VoiceModel]}">
                                    <ComboBoxItem Content="default-tts"/>
                                    <ComboBoxItem Content="natural-voice"/>
                                    <ComboBoxItem Content="expressive-voice"/>
                                    <ComboBoxItem Content="custom-trained"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Recognition Type Extended -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Recognition and Sync Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding Params[RecognitionType]}">
                                <ComboBoxItem Content="Lip-sync Only"/>
                                <ComboBoxItem Content="Gesture Recognition"/>
                                <ComboBoxItem Content="Emotion Mapping"/>
                                <ComboBoxItem Content="Full Multi-Modal"/>
                            </ComboBox>
                        </StackPanel>
                        
                        <!-- Learning Rate with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Learning Rate (Alignment)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1e-3" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-3" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-4" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="1e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-5" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Lip Sync Expander -->
                        <Expander Header="Lip Sync and Mouth Movement" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Viseme Set" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[VisemeSet]}">
                                            <ComboBoxItem Content="ARPAbet"/>
                                            <ComboBoxItem Content="IPA"/>
                                            <ComboBoxItem Content="Rhubarb"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Frame Rate (FPS)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[FrameRate]}">
                                            <ComboBoxItem Content="24"/>
                                            <ComboBoxItem Content="30"/>
                                            <ComboBoxItem Content="60"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        
                        <!-- Gesture Animation Expander -->
                        <Expander Header="Gesture and Body Animation" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <WrapPanel>
                                    <CheckBox Content="Hair Physics" IsChecked="{Binding Params[HairPhysics], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Cloth Physics" IsChecked="{Binding Params[ClothPhysics], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Secondary Motion" IsChecked="{Binding Params[SecondaryMotion], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🏷️ Import Entities" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
