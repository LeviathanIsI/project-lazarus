<UserControl x:Class="Lazarus.Desktop.Views.Training.ImagesDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Images" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <!-- Empty state banner -->
        <Border Grid.Row="1" 
                Style="{StaticResource GlassPill}" 
                Padding="12,8" 
                Margin="0,0,0,12">
            <TextBlock Text="🖼️ No job selected — editing draft configuration" 
                       Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Image Library -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Image Datasets" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    
                    <ItemsControl ItemsSource="{Binding Draft.ImageFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="🖼️" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource SolidDarkButton}"/>
                                        <TextBlock Text="{Binding}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="No image datasets imported yet" 
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Draft.ImageFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Right: Configuration -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Image Configuration" Style="{StaticResource H3TextStyle}" Margin="0,0,0,12"/>
                        
                        <!-- Core Image Settings -->
                        <TextBlock Text="Core Settings" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                        
                        <!-- Base Model / Training Type -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Width="160">
                                <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[BaseModel]}">
                                    <ComboBoxItem Content="stable-diffusion-xl"/>
                                    <ComboBoxItem Content="stable-diffusion-2.1"/>
                                    <ComboBoxItem Content="stable-diffusion-1.5"/>
                                    <ComboBoxItem Content="flux-dev"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Training Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[TrainingType]}">
                                    <ComboBoxItem Content="LoRA"/>
                                    <ComboBoxItem Content="DreamBooth"/>
                                    <ComboBoxItem Content="Textual Inversion"/>
                                    <ComboBoxItem Content="Style LoRA"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Resolution / Strategy -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Width="160">
                                <TextBlock Text="Resolution" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[Resolution]}">
                                    <ComboBoxItem Content="512x512"/>
                                    <ComboBoxItem Content="768x768"/>
                                    <ComboBoxItem Content="1024x1024"/>
                                    <ComboBoxItem Content="1536x1536"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Crop Strategy" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[ResolutionStrategy]}">
                                    <ComboBoxItem Content="Fixed"/>
                                    <ComboBoxItem Content="Random Crop"/>
                                    <ComboBoxItem Content="Center Crop"/>
                                    <ComboBoxItem Content="Aspect Ratio Bucket"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Learning Rate with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1e-3" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-3" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="1e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-4" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="5e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-5" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="1e-5" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-5" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Batch Size with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Batch Size (Images per Step - Affects VRAM)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[BatchSize], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1" Command="{Binding SetBatchSizeCommand}" CommandParameter="1" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="2" Command="{Binding SetBatchSizeCommand}" CommandParameter="2" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="4" Command="{Binding SetBatchSizeCommand}" CommandParameter="4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="8" Command="{Binding SetBatchSizeCommand}" CommandParameter="8" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Training Duration -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Training Duration" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton Content="Epochs" IsChecked="{Binding UseEpochs}" GroupName="ImageDurationMode" Margin="8,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding Params[Epochs], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseEpochs}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Steps" IsChecked="{Binding UseSteps}" GroupName="ImageDurationMode" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding Params[MaxSteps], UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseSteps}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Advanced Settings -->
                        <Expander Header="Advanced Image Settings" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <!-- Optimizer / Scheduler -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" Width="160">
                                        <TextBlock Text="Optimizer" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Optimizer]}">
                                            <ComboBoxItem Content="adamw"/>
                                            <ComboBoxItem Content="adamw_8bit"/>
                                            <ComboBoxItem Content="lion"/>
                                            <ComboBoxItem Content="prodigy"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="LR Scheduler" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[LRScheduler]}">
                                            <ComboBoxItem Content="constant_with_warmup"/>
                                            <ComboBoxItem Content="cosine"/>
                                            <ComboBoxItem Content="linear"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>
                                
                                <!-- Precision / Gradient Accumulation -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" Width="160">
                                        <TextBlock Text="Precision" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[Precision]}">
                                            <ComboBoxItem Content="FP16"/>
                                            <ComboBoxItem Content="FP32"/>
                                            <ComboBoxItem Content="bfloat16"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Gradient Accumulation" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GradientAccumulation]}">
                                            <ComboBoxItem Content="1"/>
                                            <ComboBoxItem Content="2"/>
                                            <ComboBoxItem Content="4"/>
                                            <ComboBoxItem Content="8"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>
                                
                                <!-- Augmentation -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Image Augmentation" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <CheckBox Content="Random Flip" IsChecked="{Binding Params[RandomFlip], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                        <CheckBox Content="Color Jitter" IsChecked="{Binding Params[ColorJitter], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                        <CheckBox Content="Random Blur" IsChecked="{Binding Params[RandomBlur], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                </StackPanel>
                                
                                <!-- Performance -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Performance Options" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <CheckBox Content="Gradient Checkpointing" IsChecked="{Binding Params[GradientCheckpointing], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                        <CheckBox Content="Cache Latents" IsChecked="{Binding Params[CacheLatents], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                        <CheckBox Content="EMA" IsChecked="{Binding Params[UseEMA], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🖼️ Import Images" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
