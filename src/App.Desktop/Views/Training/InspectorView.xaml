<UserControl x:Class="Lazarus.Desktop.Views.Training.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{StaticResource TextPrimaryBrush}">
        <StackPanel Margin="4">
            <TextBlock Text="Details / Inspector" Style="{StaticResource H3TextStyle}"/>
            <!-- TODO(training): bind to selection metadata -->
            <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
