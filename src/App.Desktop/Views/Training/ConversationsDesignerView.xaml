<UserControl x:Class="Lazarus.Desktop.Views.Training.ConversationsDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ Conversations" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <!-- Empty state banner -->
        <Border Grid.Row="1" 
                Style="{StaticResource GlassPill}" 
                Padding="12,8" 
                Margin="0,0,0,12"
                Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}, ConverterParameter=True}">
            <TextBlock Text="📝 No job selected — editing draft configuration" 
                       Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left: Datasets Library -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Conversation Datasets" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                    
                    <!-- Draft datasets (when no job) -->
                    <ItemsControl ItemsSource="{Binding Draft.Datasets}"
                                  Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}, ConverterParameter=True}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="📝" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource SolidDarkButton}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            <TextBlock Text="Draft dataset" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Job datasets (when job exists) -->
                    <ItemsControl ItemsSource="{Binding CurrentJob.DatasetIds}"
                                  Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="💬" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" FontWeight="Medium"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty state -->
                    <TextBlock Text="No datasets added yet" 
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Draft.Datasets.Count}" Value="0"/>
                                            <Condition Binding="{Binding HasJob}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Right: Configuration -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Configuration" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GlassComboBoxStyle}" SelectedValue="{Binding Params[BaseModel]}">
                            <ComboBoxItem Content="llama-2-7b-chat"/>
                            <ComboBoxItem Content="llama-2-13b-chat"/>
                            <ComboBoxItem Content="mistral-7b-instruct"/>
                            <ComboBoxItem Content="codellama-7b-instruct"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Training Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GlassComboBoxStyle}" SelectedValue="{Binding Params[TrainingType]}">
                            <ComboBoxItem Content="LoRA"/>
                            <ComboBoxItem Content="QLoRA"/>
                            <ComboBoxItem Content="Full Fine-tune"/>
                            <ComboBoxItem Content="DPO"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource GlassTextBoxStyle}"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Chat Template" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource GlassComboBoxStyle}" SelectedValue="{Binding Params[ChatTemplate]}">
                            <ComboBoxItem Content="ChatML"/>
                            <ComboBoxItem Content="Alpaca"/>
                            <ComboBoxItem Content="Vicuna"/>
                            <ComboBoxItem Content="ShareGPT"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="📁 Import JSONL" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
