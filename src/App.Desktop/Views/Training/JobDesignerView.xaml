<UserControl x:Class="Lazarus.Desktop.Views.Training.JobDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl Foreground="{StaticResource TextPrimaryBrush}" SelectedIndex="0">
            <!-- Datasets Tab -->
            <TabItem Header="Datasets">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Import Tools -->
                    <Border Grid.Row="0" Style="{StaticResource GlassPill}" Padding="12" Margin="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📁 Import JSONL" 
                                    Command="{Binding ImportConversationDatasetCommand}" 
                                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                                    Margin="0,0,8,0"
                                    ToolTip="Import conversation dataset from JSONL file"/>
                            <Button Content="💬 From Chat History" 
                                    Command="{Binding ImportChatHistoryCommand}" 
                                    Style="{StaticResource SolidDarkButton}" 
                                    Margin="0,0,8,0"
                                    ToolTip="Convert existing chat sessions to training data"/>
                            <Button Content="🔧 Create Template" 
                                    Command="{Binding CreateDatasetTemplateCommand}" 
                                    Style="{StaticResource SolidDarkButton}" 
                                    Margin="0,0,8,0"
                                    ToolTip="Create conversation dataset template"/>
                            <Button Content="✅ Validate Format" 
                                    Command="{Binding ValidateConversationFormatCommand}" 
                                    Style="{StaticResource SolidDarkButton}"
                                    ToolTip="Check conversation format and token counts"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Available datasets -->
                    <DockPanel Grid.Row="1" Margin="8,8,8,4">
                        <TextBlock Text="Available Conversation Datasets" Style="{StaticResource H4TextStyle}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="{Binding HasJob, Converter={StaticResource BoolToVis}, ConverterParameter='Job Mode|Draft Mode'}" 
                                       Style="{StaticResource SecondaryTextStyle}" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Content="Create Job" 
                                    Command="{Binding CreateJobCommand}" 
                                    Style="{StaticResource RainbowAccentButton.AutoFit}"/>
                        </StackPanel>
                    </DockPanel>
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding AvailableDatasets}"
                              Style="{StaticResource VirtualizedListView}"
                              Margin="8,0,8,8"
                              MinHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Vertical">
                                        <Button Content="Add" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"
                                                Margin="0,0,0,2"/>
                                        <Button Content="Preview" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.PreviewDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Stats.TotalTokens, StringFormat='{}{0:N0} tokens'}" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Stats.TotalItems, StringFormat='{}{0:N0} conversations'}" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="11" 
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Stats.AverageTokensPerItem, StringFormat='avg {0:N0} tokens/conv'}" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="11" 
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Path}" 
                                                   Style="{StaticResource SecondaryTextStyle}" 
                                                   FontSize="10" 
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Selected datasets -->
                    <TextBlock Grid.Row="3" Text="Selected for Training" 
                               Style="{StaticResource H4TextStyle}" 
                               Margin="8,8,8,4"/>
                    
                    <!-- Show job datasets when job exists -->
                    <ListView Grid.Row="4" 
                              ItemsSource="{Binding SelectedDatasets}"
                              Style="{StaticResource VirtualizedListView}"
                              Margin="8,0,8,8"
                              MinHeight="120"
                              Visibility="{Binding HasJob, Converter={StaticResource BoolToVis}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Edit" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.EditDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="Edit conversation format and templates"/>
                                        <Button Content="Sample" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.PreviewDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="Preview conversation samples"/>
                                        <Button Content="Remove" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="💬" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Stats.TotalItems, StringFormat='{}{0:N0} convs'}" 
                                                           Style="{StaticResource SecondaryTextStyle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Stats.TotalTokens}" 
                                                     Maximum="1000000" 
                                                     Style="{StaticResource MeterBar}" 
                                                     Height="4" 
                                                     Margin="0,4,0,0"/>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Stats.TotalTokens, StringFormat='Total: {0:N0} tokens'}" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding Stats.AverageTokensPerItem, StringFormat='Avg: {0:N0} tokens'}" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="10" 
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Show draft datasets when no job -->
                    <ListView Grid.Row="4" 
                              ItemsSource="{Binding Draft.Datasets}"
                              Style="{StaticResource VirtualizedListView}"
                              Margin="8,0,8,8"
                              MinHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Sample" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.PreviewDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"
                                                Margin="0,0,4,0"
                                                ToolTip="Preview conversation samples"/>
                                        <Button Content="Remove" 
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveDatasetCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SolidDarkButton}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="📝" Margin="0,0,4,0"/>
                                                <TextBlock Text="Draft" Style="{StaticResource SecondaryTextStyle}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="Draft dataset" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="10"/>
                                            <TextBlock Text="Ready to create job" 
                                                       Style="{StaticResource SecondaryTextStyle}" 
                                                       FontSize="10" 
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>
            
            <!-- Configuration Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- Model Configuration -->
                        <TextBlock Text="Base Model Configuration" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Chat Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource GlassComboBoxStyle}">
                                    <ComboBoxItem Content="llama-2-7b-chat"/>
                                    <ComboBoxItem Content="llama-2-13b-chat" IsSelected="True"/>
                                    <ComboBoxItem Content="mistral-7b-instruct"/>
                                    <ComboBoxItem Content="codellama-7b-instruct"/>
                                    <ComboBoxItem Content="openchat-3.5"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Training Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource GlassComboBoxStyle}" SelectedValue="{Binding Draft.TrainingType}">
                                    <ComboBoxItem Content="LoRA Fine-tuning" IsSelected="True"/>
                                    <ComboBoxItem Content="QLoRA Fine-tuning"/>
                                    <ComboBoxItem Content="Full Fine-tuning"/>
                                    <ComboBoxItem Content="DPO Training"/>
                                    <ComboBoxItem Content="RLHF Training"/>
                                </ComboBox>
                            </StackPanel>
                                      
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Output Path" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="📁" Style="{StaticResource SolidDarkButton}" Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding Draft.OutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Conversation Format Settings -->
                        <TextBlock Text="Conversation Format" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Chat Template" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource GlassComboBoxStyle}">
                                    <ComboBoxItem Content="ChatML" IsSelected="True"/>
                                    <ComboBoxItem Content="Alpaca"/>
                                    <ComboBoxItem Content="Vicuna"/>
                                    <ComboBoxItem Content="ShareGPT"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Max Sequence Length" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="2048" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="System Role" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource GlassComboBoxStyle}">
                                    <ComboBoxItem Content="Assistant" IsSelected="True"/>
                                    <ComboBoxItem Content="Helper"/>
                                    <ComboBoxItem Content="Expert"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Row 2: Advanced Format Options -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                <TextBlock Text="Turn Separator" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="&lt;|im_end|&gt;" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                <TextBlock Text="Response Prefix" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="&lt;|im_start|&gt;assistant" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                                <CheckBox Content="Add BOS/EOS tokens" 
                                          IsChecked="True" 
                                          Style="{StaticResource GlassCheckBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Training Parameters -->
                        <TextBlock Text="Training Hyperparameters" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Draft.LearningRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Epochs" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="3" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Warmup Steps" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="100" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Row 2: LoRA specific settings -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                <TextBlock Text="LoRA Rank" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="16" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                <TextBlock Text="LoRA Alpha" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="32" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,8,0,0">
                                <TextBlock Text="Dropout" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="0.1" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <!-- Row 3: Advanced options -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                <CheckBox Content="Use gradient checkpointing" 
                                          IsChecked="True" 
                                          Style="{StaticResource GlassCheckBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                <CheckBox Content="Use flash attention" 
                                          IsChecked="True" 
                                          Style="{StaticResource GlassCheckBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,8,0,0">
                                <CheckBox Content="Save intermediate checkpoints" 
                                          IsChecked="True" 
                                          Style="{StaticResource GlassCheckBoxStyle}"/>
                            </StackPanel>
                    </Grid>
                        
                        <!-- Prompt Engineering -->
                        <TextBlock Text="Prompt Engineering" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource GlassPanel}" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="System Prompt Template" Style="{StaticResource SecondaryTextStyle}" DockPanel.Dock="Left"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="Load Template" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                        <Button Content="Save Template" Style="{StaticResource SolidDarkButton}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Height="80" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True"
                                         Text="You are a helpful, harmless, and honest assistant. Respond conversationally and be concise."
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Resources Tab -->
            <TabItem Header="Resources">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- GPU Selection -->
                        <TextBlock Text="GPU Configuration" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="GPU" Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" 
                                      ItemsSource="{Binding Gpus}" 
                                      SelectedItem="{Binding SelectedGpu}"
                                      Style="{StaticResource GlassComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="10">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:N1} GB • {1:N0}% util">
                                                        <Binding Path="TotalMemoryBytes" Converter="{StaticResource BytesToGigabytesConverter}"/>
                                                        <Binding Path="UtilizationPercent"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            
                            <TextBlock Text="Precision" Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" 
                                      ItemsSource="{Binding Precisions}" 
                                      SelectedItem="{Binding SelectedPrecision}"
                                      Style="{StaticResource GlassComboBoxStyle}"/>
                        </Grid>
                        
                        <!-- Memory and Batch Settings -->
                        <TextBlock Text="Memory Settings" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Batch Size" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BatchSize}" Style="{StaticResource GlassTextBoxStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gradient Accumulation" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <TextBox Text="8" Style="{StaticResource GlassTextBoxStyle}"/>
                        </StackPanel>
                        </Grid>
                        
                        <!-- Resource Estimate -->
                        <TextBlock Text="Resource Estimate" Style="{StaticResource H4TextStyle}" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource ChartCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Estimated VRAM Usage" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding EstimatedVRAM, StringFormat='{}{0:N1} GB'}" 
                                               HorizontalAlignment="Right" 
                                               FontWeight="Medium"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource MeterBar}" 
                                             Minimum="0" Maximum="24" 
                                             Value="{Binding EstimatedVRAM, Converter={StaticResource BytesToGigabytesConverter}}"/>
                                <Button Content="Recalculate" 
                                        Command="{Binding EstimateResourcesCommand}" 
                                        Style="{StaticResource SolidDarkButton}"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Overview strip -->
        <Border Grid.Row="1" Style="{StaticResource GlassPill}" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <ContentControl Content="{Binding OverviewStatus}" 
                                Style="{StaticResource StatusChip.Default}" 
                                DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding OverviewEta}" 
                           DockPanel.Dock="Right" 
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="12,0">
                    <TextBlock Text="Progress: " Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource RainbowGlassProgressBarStyle}" 
                                 Minimum="0" Maximum="1" 
                                 Value="{Binding OverviewProgress}" 
                                 Height="8" Width="200" 
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OverviewProgress, StringFormat='{}{0:P1}'}" 
                               Style="{StaticResource SecondaryTextStyle}" 
                               Margin="8,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
