<UserControl x:Class="Lazarus.Desktop.Views.Training.JobDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Datasets">
                <!-- TODO(training): modality-aware dataset previews via DataTemplates -->
                <ContentControl Content="{Binding DatasetsPresenter}"/>
            </TabItem>
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryTextStyle}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/>
                        <TextBlock Text="Recipe" Grid.Row="0" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"/>
                        <TextBlock Text="Output Path" Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding OutputPath}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Resources">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="GPU" Style="{StaticResource SecondaryTextStyle}"/>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Width="200" Margin="0,0,8,0">
                            <TextBlock Text="Batch Size" Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBox Text="{Binding BatchSize}"/>
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="Precision" Style="{StaticResource SecondaryTextStyle}"/>
                            <ComboBox ItemsSource="{Binding Precisions}" SelectedItem="{Binding SelectedPrecision}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Overview strip -->
        <Border Grid.Row="1" Style="{StaticResource GlassPill}" Padding="8" Margin="0,8,0,0">
            <DockPanel>
                <ContentControl Content="{Binding OverviewStatus}" Style="{StaticResource StatusChip.Default}"/>
                <ProgressBar Style="{StaticResource RainbowGlassProgressBarStyle}" Minimum="0" Maximum="1" Value="{Binding OverviewProgress}" Height="10" Margin="12,0"/>
                <TextBlock Text="{Binding OverviewEta}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

