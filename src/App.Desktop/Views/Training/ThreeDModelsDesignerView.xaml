<UserControl x:Class="Lazarus.Desktop.Views.Training.ThreeDModelsDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Training ▸ 3D Models" Style="{StaticResource SecondaryTextStyle}" FontSize="12"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H2TextStyle}"/>
        </StackPanel>
        
        <Border Grid.Row="1" Style="{StaticResource GlassPill}" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="🗿 No job selected — editing draft configuration" Style="{StaticResource SecondaryTextStyle}"/>
        </Border>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12">
                <StackPanel>
                    <TextBlock Text="3D Model Files" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    
                    <ItemsControl ItemsSource="{Binding Draft.ModelFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassPanel}" Padding="8" Margin="0,0,0,4">
                                    <DockPanel>
                                        <TextBlock Text="🗿" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                        <Button Content="×" DockPanel.Dock="Right" Style="{StaticResource SolidDarkButton}"/>
                                        <TextBlock Text="{Binding}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <TextBlock Text="No 3D models imported yet" 
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Draft.ModelFiles.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="3D Model Configuration" Style="{StaticResource H3TextStyle}" Margin="0,0,0,12"/>
                        
                        <!-- Core 3D Settings -->
                        <TextBlock Text="Core Settings" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                    
                        <!-- Base Model / Training Type -->
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Width="160">
                                <TextBlock Text="Base Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[BaseModel]}">
                                    <ComboBoxItem Content="instant-ngp"/>
                                    <ComboBoxItem Content="nerf-base"/>
                                    <ComboBoxItem Content="gaussian-splatting"/>
                                    <ComboBoxItem Content="dreamfusion"/>
                                    <ComboBoxItem Content="threestudio"/>
                                    <ComboBoxItem Content="point-e"/>
                                    <ComboBoxItem Content="shap-e"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Training Type" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding Params[TrainingType]}">
                                    <ComboBoxItem Content="NeRF"/>
                                    <ComboBoxItem Content="Gaussian Splats"/>
                                    <ComboBoxItem Content="Mesh"/>
                                    <ComboBoxItem Content="Point Cloud"/>
                                    <ComboBoxItem Content="Voxel Grid"/>
                                    <ComboBoxItem Content="Text-to-3D"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                        
                        <!-- Learning Rate with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Learning Rate" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[LearningRate], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1e-2" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-2" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="5e-3" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-3" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="1e-3" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-3" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="5e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="5e-4" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="1e-4" Command="{Binding SetLearningRateCommand}" CommandParameter="1e-4" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Batch Size with Quick-Select -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Batch Size (Rays/Patches per Step)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" 
                                         Width="120" 
                                         Text="{Binding Params[BatchSize], UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="8,0,0,0"/>
                                <WrapPanel>
                                    <Button Content="1024" Command="{Binding SetBatchSizeCommand}" CommandParameter="1024" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="4096" Command="{Binding SetBatchSizeCommand}" CommandParameter="4096" Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,4,0"/>
                                    <Button Content="8192" Command="{Binding SetBatchSizeCommand}" CommandParameter="8192" Style="{StaticResource SolidDarkButton}" Margin="0,0,4,0"/>
                                    <Button Content="16384" Command="{Binding SetBatchSizeCommand}" CommandParameter="16384" Style="{StaticResource SolidDarkButton}"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                        
                        <!-- Advanced 3D Settings -->
                        <Expander Header="Advanced 3D Settings" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <!-- Comprehensive 3D training parameters here -->
                                <!-- NeRF (Neural Radiance Fields) Settings -->
                                <TextBlock Text="NeRF Settings" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Ray Batch Size / Near Clipping -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Ray Batch Size" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[RayBatchSize], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Near Clipping Plane" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[NearClipping], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Far Clipping / Scene Scale -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Far Clipping Plane" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[FarClipping], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Scene Scale" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[SceneScale], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Additional NeRF Settings -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Coarse→Fine Steps / Render Resolution -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Coarse→Fine Sampling Steps" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[CoarseFineSteps], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Render Resolution" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[RenderResolution]}">
                                            <ComboBoxItem Content="256x256"/>
                                            <ComboBoxItem Content="512x512"/>
                                            <ComboBoxItem Content="800x800"/>
                                            <ComboBoxItem Content="1024x1024"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 2: TV Loss Weight / Sparsity Loss Weight -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="TV Loss Weight" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[TVLossWeight], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Sparsity Loss Weight" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[SparsityLossWeight], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- NeRF Options -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="NeRF Regularization" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <CheckBox Content="TV Loss" IsChecked="{Binding Params[TVLoss], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                        <CheckBox Content="Sparsity Loss" IsChecked="{Binding Params[SparsityLoss], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                        <CheckBox Content="View Jitter" IsChecked="{Binding Params[ViewJitter], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    </WrapPanel>
                                </StackPanel>
                                
                                <!-- Mesh Training Settings -->
                                <TextBlock Text="Mesh Training" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Vertex Count / Texture Resolution -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Vertex Count Limit" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[VertexCountLimit]}">
                                            <ComboBoxItem Content="10K"/>
                                            <ComboBoxItem Content="50K"/>
                                            <ComboBoxItem Content="100K"/>
                                            <ComboBoxItem Content="500K"/>
                                            <ComboBoxItem Content="1M"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Texture Resolution (UV)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[TextureResolution]}">
                                            <ComboBoxItem Content="512x512"/>
                                            <ComboBoxItem Content="1024x1024"/>
                                            <ComboBoxItem Content="2048x2048"/>
                                            <ComboBoxItem Content="4096x4096"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Surface Loss / Laplacian Weight -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Surface Loss Function" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[SurfaceLossFunction]}">
                                            <ComboBoxItem Content="Chamfer Distance"/>
                                            <ComboBoxItem Content="Normal Consistency"/>
                                            <ComboBoxItem Content="Combined"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Laplacian Weight" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[LaplacianWeight], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 3: Checkpoint Frequency / Decimation -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Checkpoint Every (steps)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[MeshCheckpointFreq], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                        <CheckBox Content="Decimation Toggle (Simplify)" IsChecked="{Binding Params[DecimationToggle], Converter={StaticResource StringToBooleanConverter}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                
                                <WrapPanel Margin="0,0,0,12">
                                    <CheckBox Content="Surface Smoothing" IsChecked="{Binding Params[SurfaceSmoothing], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Laplacian Reg" IsChecked="{Binding Params[LaplacianReg], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Normal Consistency" IsChecked="{Binding Params[NormalConsistency], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                </WrapPanel>
                                
                                <!-- Point Cloud Training -->
                                <TextBlock Text="Point Cloud Training" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Number of Points / Point Radius -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Number of Points" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[NumberOfPoints]}">
                                            <ComboBoxItem Content="10K"/>
                                            <ComboBoxItem Content="50K"/>
                                            <ComboBoxItem Content="100K"/>
                                            <ComboBoxItem Content="500K"/>
                                            <ComboBoxItem Content="1M"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Point Radius/Kernel Size" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[PointRadius], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Distance Metric / Noise Injection -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Distance Metric" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[DistanceMetric]}">
                                            <ComboBoxItem Content="Chamfer Distance"/>
                                            <ComboBoxItem Content="Earth Mover's Distance"/>
                                            <ComboBoxItem Content="Hausdorff Distance"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Noise Injection (Gaussian)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[NoiseInjection], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <WrapPanel Margin="0,0,0,16">
                                    <CheckBox Content="Color Learning (XYZRGB)" IsChecked="{Binding Params[ColorLearning], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                    <CheckBox Content="Spatial Augmentations" IsChecked="{Binding Params[SpatialAugmentations], Converter={StaticResource StringToBooleanConverter}}" Margin="0,0,12,4"/>
                                </WrapPanel>
                                
                                <!-- General Advanced Controls (All 3D Types) -->
                                <TextBlock Text="General Advanced Controls" Style="{StaticResource H3TextStyle}" FontSize="14" Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Row 1: Optimizer / LR Scheduler -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Optimizer" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GeneralOptimizer]}">
                                            <ComboBoxItem Content="adam"/>
                                            <ComboBoxItem Content="adamw"/>
                                            <ComboBoxItem Content="rmsprop"/>
                                            <ComboBoxItem Content="sgd"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="LR Scheduler" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GeneralLRScheduler]}">
                                            <ComboBoxItem Content="linear"/>
                                            <ComboBoxItem Content="cosine"/>
                                            <ComboBoxItem Content="step"/>
                                            <ComboBoxItem Content="exponential"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 2: Gradient Clipping / Precision -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Gradient Clipping (norm)" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[GeneralGradClip], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Precision" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GeneralPrecision]}">
                                            <ComboBoxItem Content="FP32"/>
                                            <ComboBoxItem Content="FP16"/>
                                            <ComboBoxItem Content="bfloat16"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <!-- Row 3: Validation Split / Additional Training Controls -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Validation Split %" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <ComboBox SelectedValue="{Binding Params[GeneralValidationSplit]}">
                                            <ComboBoxItem Content="0"/>
                                            <ComboBoxItem Content="0.1"/>
                                            <ComboBoxItem Content="0.15"/>
                                            <ComboBoxItem Content="0.2"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Training Steps Override" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Params[GeneralTrainingSteps], UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="🗿 Import 3D Models" 
                    Command="{Binding ImportCommand}" 
                    Style="{StaticResource RainbowAccentButton.AutoFit}" 
                    Margin="0,0,8,0"/>
            <Button Content="Create Job" 
                    Command="{Binding CreateJobCommand}" 
                    Style="{StaticResource SolidDarkButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Clear" 
                    Command="{Binding ClearCommand}" 
                    Style="{StaticResource SolidDarkButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
