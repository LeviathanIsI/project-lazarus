<UserControl x:Class="Lazarus.Desktop.Views.Training.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Lazarus.Desktop.Views.Training"
             xmlns:viewstraining="clr-namespace:Lazarus.Desktop.Views.Training"
             xmlns:vmtraining="clr-namespace:Lazarus.Desktop.ViewModels.Training"
             mc:Ignorable="d">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.InputBindings>
            <!-- Global keyboard shortcuts -->
            <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding JobsSidebar.NewJobCommand}"/>
            <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding JobsSidebar.ImportDatasetCommand}"/>
            <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding StartCommand}"/>
            <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PauseCommand}"/>
            <KeyBinding Key="OemPeriod" Modifiers="Ctrl" Command="{Binding StopCommand}"/>
            <KeyBinding Key="OemTilde" Modifiers="Ctrl" Command="{Binding ToggleMonitorDockCommand}"/>
        </Grid.InputBindings>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top modality switch -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8">
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Conversations" Command="{Binding SetModalityCommand}" CommandParameter="Conversations" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Conversations}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Voice" Command="{Binding SetModalityCommand}" CommandParameter="Voice" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Voice}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Images" Command="{Binding SetModalityCommand}" CommandParameter="Images" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Images}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="3D Models" Command="{Binding SetModalityCommand}" CommandParameter="ThreeD" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=ThreeD}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Entities" Command="{Binding SetModalityCommand}" CommandParameter="Entities" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Entities}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Videos" Command="{Binding SetModalityCommand}" CommandParameter="Videos" IsChecked="{Binding SelectedModality, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Videos}"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" 
              Content="Design Progress"
              Command="{Binding SetModalityCommand}"
              CommandParameter="DesignProgress"
              IsChecked="{Binding SelectedModality, Mode=TwoWay, 
                         Converter={StaticResource StringToBooleanConverter}, 
                         ConverterParameter=DesignProgress}"/>

        </StackPanel>

        <!-- Main regions -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding SelectedModality, Converter={StaticResource ModalityToLeftHeaderConverter}}"
                               Style="{StaticResource H3TextStyle}"
                               Margin="0,0,0,8"/>
                    <views:JobsSidebarView DataContext="{Binding JobsSidebar}"/>
                </DockPanel>
            </Border>

            <!-- Center Surface: current designer or Design Progress via DataTemplates -->
            <!-- Replace your ContentControl section with this exact code -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource GlassPanelElevated}" Padding="8">
                    <ContentControl Content="{Binding ActiveDesigner}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vmtraining:ConversationsDesignerViewModel}">
                                <viewstraining:ConversationsDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:VoiceDesignerViewModel}">
                                <viewstraining:VoiceDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:ImagesDesignerViewModel}">
                                <viewstraining:ImagesDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:ThreeDModelsDesignerViewModel}">
                                <viewstraining:ThreeDModelsDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:EntitiesDesignerViewModel}">
                                <viewstraining:EntitiesDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:VideosDesignerViewModel}">
                                <viewstraining:VideosDesignerView/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vmtraining:DesignProgressViewModel}">
                                <viewstraining:DesignProgressView/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
            </Grid>

            <!-- Right Inspector -->
            <Border Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="8">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedModality, Converter={StaticResource ModalityToRightHeaderConverter}}"
                               Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    <views:InspectorView DataContext="{Binding Inspector}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom monitor dock -->
        <Grid Grid.Row="2" Margin="16,8,16,16" Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMonitorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource GlassPanel}" Padding="8">
                <views:MonitorDockView DataContext="{Binding MonitorDock}"/>
            </Border>
        </Grid>

        <!-- Global action row (floats above dock) -->
        <DockPanel Grid.Row="2" Margin="16,0,16,8" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Create Job (shown when no job selected) -->
                <Button Content="Create Job"   
                        Command="{Binding JobDesigner.CreateJobCommand}"   
                        Style="{StaticResource RainbowAccentButton.AutoFit}" 
                        Margin="0,0,8,0"
                        ToolTip="Create training job from current configuration"/>
                
                <!-- Job control buttons (shown when job exists) -->
                <Button Content="Start"   
                        Command="{Binding StartCommand}"   
                        IsEnabled="{Binding CanStart}"   
                        Style="{StaticResource RainbowAccentButton.AutoFit}" 
                        Margin="0,0,8,0"
                        ToolTip="Start selected training jobs (Ctrl+Enter)"/>
                <Button Content="Pause"   
                        Command="{Binding PauseCommand}"   
                        IsEnabled="{Binding CanPause}"   
                        Style="{StaticResource SolidDarkButton}" 
                        Margin="0,0,8,0"
                        ToolTip="Pause running jobs (Ctrl+P)"/>
                <Button Content="Stop"    
                        Command="{Binding StopCommand}"    
                        IsEnabled="{Binding CanStop}"    
                        Style="{StaticResource SolidDarkButton}" 
                        Margin="0,0,8,0"
                        ToolTip="Stop running/paused jobs (Ctrl+.)"/>
                <Button Content="Export"  
                        Command="{Binding ExportCommand}"  
                        IsEnabled="{Binding CanExport}"  
                        Style="{StaticResource SolidDarkButton}"
                        ToolTip="Export completed job results"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
