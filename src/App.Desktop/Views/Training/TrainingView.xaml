<UserControl x:Class="Lazarus.Desktop.Views.Training.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Lazarus.Desktop.Views.Training"
             mc:Ignorable="d">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.InputBindings>
            <!-- Global keyboard shortcuts -->
            <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding JobsSidebar.NewJobCommand}"/>
            <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding JobsSidebar.ImportDatasetCommand}"/>
            <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding StartCommand}"/>
            <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PauseCommand}"/>
            <KeyBinding Key="OemPeriod" Modifiers="Ctrl" Command="{Binding StopCommand}"/>
            <KeyBinding Key="OemTilde" Modifiers="Ctrl" Command="{Binding ToggleMonitorDockCommand}"/>
        </Grid.InputBindings>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top modality switch -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12,16,8">
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Conversations" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Conversations}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Voice" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Voice}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Images" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Images}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="3D Models" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=ThreeD}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Entities" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Entities}" Margin="0,0,8,0"/>
            <ToggleButton Style="{StaticResource GlassToggleButtonStyle}" Content="Videos" IsChecked="{Binding SelectedModality, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Videos}"/>
            <ToggleButton Content="Design  Progress" Style="{StaticResource GlassToggleButtonStyle}" Margin="16,0,0,0" IsChecked="{Binding IsProgressMode}" ToolTip="Toggle designer vs progress full-screen"/>
        </StackPanel>

        <!-- Main regions -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="💬 Conversation Models" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    <views:JobsSidebarView DataContext="{Binding JobsSidebar}"/>
                </DockPanel>
            </Border>

            <!-- Center Designer or Progress -->
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource GlassPanelElevated}" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Conversations Training" Style="{StaticResource H2TextStyle}" Margin="0,0,0,16"/>
                        <TextBlock Text="Configure conversation/chat model training settings, datasets, and parameters." TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <views:JobDesignerView DataContext="{Binding JobDesigner}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Full-screen Progress Surface (visible when IsProgressMode) -->
            <Grid Grid.Column="2" Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProgressMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource GlassPanelElevated}" Padding="8">
                    <!-- TODO(training): replace placeholder with charts+logs fullscreen composite -->
                    <TextBlock Text="Progress Mode — Charts &amp; Logs" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Right Inspector -->
            <Border Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="8">
                <StackPanel>
                    <TextBlock Text="Conversation Details" Style="{StaticResource H3TextStyle}" Margin="0,0,0,8"/>
                    <views:InspectorView DataContext="{Binding Inspector}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom monitor dock -->
        <Grid Grid.Row="2" Margin="16,8,16,16" Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMonitorOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource GlassPanel}" Padding="8">
                <views:MonitorDockView DataContext="{Binding MonitorDock}"/>
            </Border>
        </Grid>

        <!-- Global action row (floats above dock) -->
        <DockPanel Grid.Row="2" Margin="16,0,16,8" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Create Job (shown when no job selected) -->
                <Button Content="Create Job"   
                        Command="{Binding JobDesigner.CreateJobCommand}"   
                        Style="{StaticResource RainbowAccentButton.AutoFit}" 
                        Margin="0,0,8,0"
                        ToolTip="Create training job from current configuration"/>
                
                <!-- Job control buttons (shown when job exists) -->
                <Button Content="Start"   
                        Command="{Binding StartCommand}"   
                        IsEnabled="{Binding CanStart}"   
                        Style="{StaticResource RainbowAccentButton.AutoFit}" 
                        Margin="0,0,8,0"
                        ToolTip="Start selected training jobs (Ctrl+Enter)"
                        Visibility="{Binding JobDesigner.HasJob, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="Pause"   
                        Command="{Binding PauseCommand}"   
                        IsEnabled="{Binding CanPause}"   
                        Style="{StaticResource SolidDarkButton}" 
                        Margin="0,0,8,0"
                        ToolTip="Pause running jobs (Ctrl+P)"
                        Visibility="{Binding JobDesigner.HasJob, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="Stop"    
                        Command="{Binding StopCommand}"    
                        IsEnabled="{Binding CanStop}"    
                        Style="{StaticResource SolidDarkButton}" 
                        Margin="0,0,8,0"
                        ToolTip="Stop running/paused jobs (Ctrl+.)"
                        Visibility="{Binding JobDesigner.HasJob, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="Export"  
                        Command="{Binding ExportCommand}"  
                        IsEnabled="{Binding CanExport}"  
                        Style="{StaticResource SolidDarkButton}"
                        ToolTip="Export completed job results"
                        Visibility="{Binding JobDesigner.HasJob, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
