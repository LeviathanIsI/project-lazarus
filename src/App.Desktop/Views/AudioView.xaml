<UserControl x:Class="Lazarus.Desktop.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AudioViewModel, IsDesignTimeCreatable=True}">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Padding="32,32,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Audio Manager" 
                               Style="{StaticResource H1TextStyle}"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="Import, record, and manage your audio files" 
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Quick Stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalFiles}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Files" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,8">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalSizeDisplay}" Style="{StaticResource H2TextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Storage Used" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="32,0,32,16">
            <StackPanel Orientation="Horizontal" Margin="16,12">
                <!-- File Operations -->
                <Button Command="{Binding ImportCommand}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" Margin="0,0,6,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding RecordCommand}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎙️" Margin="0,0,6,0"/>
                        <TextBlock Text="Record"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,16,0"/>

                <!-- Playback Controls -->
                <Button Command="{Binding PlayPauseCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        IsEnabled="{Binding CanPlay}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶️"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="⏸️"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Play"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="Pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Command="{Binding StopCommand}"
                        IsEnabled="{Binding IsPlaying}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                        Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏹️" Margin="0,0,6,0"/>
                        <TextBlock Text="Stop"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,0,16,0"/>

                <!-- File Management -->
                <Button Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        IsEnabled="{Binding CanDelete}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️" Margin="0,0,6,0"/>
                        <TextBlock Text="Delete"/>
                    </StackPanel>
                </Button>

                <!-- Spacer -->
                <TextBlock Width="1" HorizontalAlignment="Stretch"/>

                <!-- Refresh -->
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                        HorizontalAlignment="Right"
                        Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="32,0,32,16">
            <!-- Empty State -->
            <Border Padding="60"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <StackPanel>
                    <!-- Icon -->
                    <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 3V21M9 3V21M18 8V16M6 10V14M15 4V20M21 10V14"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.5"
                                  Opacity="0.3"/>
                        </Canvas>
                    </Viewbox>
                    
                    <TextBlock Text="No audio files yet"
                               Style="{StaticResource H2TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    
                    <TextBlock Text="Import audio files or start recording to get started"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="400"/>
                    
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <Button Command="{Binding ImportCommand}"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,6,0"/>
                                <TextBlock Text="Import Files"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RecordCommand}"
                                Style="{StaticResource RainbowAccentButton.AutoFit}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙️" Margin="0,0,6,0"/>
                                <TextBlock Text="Start Recording"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Audio Items List -->
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{StaticResource GlassCardBrush}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                
                <DataGrid.Columns>
                    <!-- Playing Indicator -->
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="🔊" 
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- File Name -->
                    <DataGridTextColumn Header="Name" 
                                        Binding="{Binding FileName}" 
                                        Width="*"
                                        MinWidth="200"/>
                    
                    <!-- Duration -->
                    <DataGridTextColumn Header="Duration" 
                                        Binding="{Binding DurationDisplay}" 
                                        Width="100"/>
                    
                    <!-- File Size -->
                    <DataGridTextColumn Header="Size" 
                                        Binding="{Binding SizeDisplay}" 
                                        Width="100"/>
                    
                    <!-- Format -->
                    <DataGridTextColumn Header="Format" 
                                        Binding="{Binding Format}" 
                                        Width="80"/>
                    
                    <!-- Sample Rate -->
                    <DataGridTextColumn Header="Sample Rate" 
                                        Binding="{Binding SampleRateDisplay}" 
                                        Width="100"/>
                    
                    <!-- Last Modified -->
                    <DataGridTextColumn Header="Modified" 
                                        Binding="{Binding LastModifiedDisplay}" 
                                        Width="150"/>
                    
                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Play"
                                            Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RainbowAccentButton.AutoFit}"
                                            Margin="0,0,4,0"
                                            Padding="8,4"/>
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RainbowAccentButton.AutoFit}"
                                            Padding="8,4"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Style="{StaticResource GlassCardStyle}"
                Margin="32,0,32,32"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Current File Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Selected: " 
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedItemDisplay}" 
                               Style="{StaticResource PrimaryTextStyle}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Playback Progress -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal"
                            Margin="16,0"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CurrentPositionDisplay}" 
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" / " 
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentDurationDisplay}" 
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                    <ProgressBar Value="{Binding PlaybackProgress}" 
                                 Width="200"
                                 Height="4"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" 
                             Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" 
                               Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>