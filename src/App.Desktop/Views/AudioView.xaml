<UserControl x:Class="Lazarus.Desktop.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AudioViewModel, IsDesignTimeCreatable=True}">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Audio processing content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Audio Generation &amp; Processing" 
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Create, analyze, and process audio with advanced AI-powered tools" 
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="Audio page description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Import Audio"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Margin="0,0,12,0"
                                Command="{Binding ImportAudioCommand}"
                                AutomationProperties.Name="Import audio files"
                                AutomationProperties.HelpText="Import existing audio files for processing"/>
                        
                        <Button Content="Generate Audio"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Command="{Binding GenerateAudioCommand}"
                                AutomationProperties.Name="Generate new audio"
                                AutomationProperties.HelpText="Create new audio using AI synthesis"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Stats Cards -->
                <UniformGrid Grid.Row="1" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="Audio processing statistics">
                    
                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Audio Files" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="{Binding TotalFiles}" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Generated Today" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="{Binding GeneratedToday}" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Synthesis Status" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{StaticResource SuccessBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SynthesisStatus}" 
                                           Style="{StaticResource H2TextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Duration" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="{Binding TotalDurationDisplay}" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Items list + Placeholder Content Area -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Simple list of audio items -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Items}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Duration}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedLocal}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding FilePath}" Opacity="0.6"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Content="Open"
                                                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FilePath}"
                                                    Style="{StaticResource RainbowAccentButton.AutoFit}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FilePath}"
                                                    Style="{StaticResource RainbowAccentButton.AutoFit}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- keep existing placeholder below -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}"
                            Padding="40">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 3V21M9 3V21M18 8V16M6 10V14M15 4V20M21 10V14"
                                          Style="{StaticResource EmptyStateIconStyle}"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Header -->
                            <TextBlock Text="Audio Processing Studio Coming Soon"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            
                            <!-- Description -->
                            <TextBlock Style="{StaticResource EmptyStateDescriptionStyle}"
                                       TextAlignment="Center"
                                       AutomationProperties.Name="Audio feature description">
                                <TextBlock.Text>This comprehensive audio workspace will provide powerful capabilities for generating speech, music, and sound effects, along with advanced analysis and processing tools for all your audio needs.</TextBlock.Text>
                            </TextBlock>
                            
                            <!-- Features Preview -->
                            <ItemsControl Margin="0,24,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Speech Synthesis" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Music Generation" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Voice Cloning" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Audio Analysis" Margin="4"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
