<UserControl x:Class="Lazarus.Desktop.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:Lazarus.Desktop.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="800">

    <!-- If you already have theme resources (GlassSurface, Border, etc.), they’ll apply.
         If not, WPF defaults still render fine. -->

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Library -->
        <Border Grid.Row="0" Grid.Column="0"
                Style="{StaticResource GlassCardStyle}"
                Padding="12">
            <DockPanel LastChildFill="True">
                <!-- Toolbar (wraps on narrow widths) -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ItemHeight="32">
                    <Button Content="Upload audio" Command="{Binding ImportCmd}"
                            Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,8,8"/>
                    <Button Content="Record audio" Command="{Binding RecordCmd}"
                            Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,0,8,8"/>
                    <ToggleButton IsChecked="{Binding IsPreviewEnabled}" Content="👁 Preview"
                                  Margin="0,0,8,8" Style="{StaticResource GlassToggleButtonStyle}"/>
                    <TextBlock Text="Sort by:" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,6,8"/>
                    <ComboBox Width="140" SelectedItem="{Binding SortMode}" Margin="0,0,0,8">
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Date"/>
                        <ComboBoxItem Content="Size"/>
                        <ComboBoxItem Content="Duration"/>
                    </ComboBox>
                </WrapPanel>

                <!-- Search (WPF-compatible placeholder/watermark) -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource GlassTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Search audio…"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- List -->
                <ListView ItemsSource="{Binding Items}"
                          Style="{StaticResource GlassListViewStyle}"
                          ItemContainerStyle="{StaticResource GlassListViewItemStyle}"
                          behaviors:GridViewColumnResizeBehavior.EnableColumnFill="True"
                          SelectedItem="{Binding ActiveItem, Mode=TwoWay}"
                          SelectionMode="Extended"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.Resources>
                        <!-- Dark column header style -->
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="8,6"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="80" Header="Wave">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Height="16" Fill="{StaticResource RainbowFlowBrush}">
                                            <Rectangle.OpacityMask>
                                                <!-- Placeholder sparkline -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0.0" Color="Black"/>
                                                    <GradientStop Offset="0.2" Color="Transparent"/>
                                                    <GradientStop Offset="0.4" Color="Black"/>
                                                    <GradientStop Offset="0.6" Color="Transparent"/>
                                                    <GradientStop Offset="0.8" Color="Black"/>
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" behaviors:GridViewColumnResizeBehavior.FillColumn="True">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90" Header="Duration" DisplayMemberBinding="{Binding Duration}"/>
                            <GridViewColumn Width="85" Header="Size" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Width="140" Header="Modified">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Modified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource GlassBorderBrush}" CornerRadius="4"/>

        <!-- RIGHT: Details -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="12">
            <!-- Two-column layout: content + filters panel -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                <!-- Big Waveform (with empty-state dropzone overlay) -->
                <Border Grid.Row="0" CornerRadius="10" Padding="12" Style="{StaticResource GlassCardStyle}">
                    <Grid>
                        <!-- When an item is selected, show waveform placeholder -->
                        <Grid x:Name="WaveSection">
                            <TextBlock Text="{Binding ActiveItem.Name, FallbackValue=No Selection}"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Viewbox Stretch="Fill" Margin="0,24,0,0">
                                <Path StrokeThickness="2" Stroke="{StaticResource RainbowFlowBrush}"
                                      Data="M 0,50 L 40,30 80,55 120,10 160,60 200,35 240,50 280,20 320,70 360,50"/>
                            </Viewbox>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- Drag & Drop empty state overlay -->
                        <Grid x:Name="DropOverlay" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="12" Padding="24" Background="#0DFFFFFF">
                                <Grid>
                                    <!-- Dashed rectangle look -->
                                    <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="6 6"
                                               Stroke="{StaticResource RainbowFlowBrush}"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="☁" FontSize="36" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drag &amp; drop or choose your audio file"
                                                   Style="{StaticResource H2TextStyle}" Margin="0,8,0,2"/>
                                        <TextBlock Text="Supported formats:" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <ContentControl Style="{StaticResource RainbowBorderChip}" Content=".mp3" Margin="0,0,8,0"/>
                                            <ContentControl Style="{StaticResource RainbowBorderChip}" Content=".ogg" Margin="0,0,8,0"/>
                                            <ContentControl Style="{StaticResource RainbowBorderChip}" Content=".aiff" Margin="0,0,8,0"/>
                                            <ContentControl Style="{StaticResource RainbowBorderChip}" Content=".wav"/>
                                        </StackPanel>
                                        <Button Content="Choose file" Command="{Binding ImportCmd}"
                                                Style="{StaticResource RainbowAccentButton.AutoFit}" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </Grid>
                </Border>

                <!-- File Info -->
                <Border Grid.Row="1" Margin="0,12,0,8" Padding="12" CornerRadius="10"
                        Style="{StaticResource GlassCardStyle}">
                    <UniformGrid Columns="4" Rows="2">
                        <StackPanel>
                            <TextBlock Text="Duration" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Duration, FallbackValue=—}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Sample Rate" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.SampleRate, FallbackValue=44\,100 Hz}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Channels" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Channels, FallbackValue=Mono}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bitrate" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Bitrate, FallbackValue=256 kbps}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Format" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Format, FallbackValue=wav}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Size" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Size, FallbackValue=—}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Path" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Path, FallbackValue=—}" TextTrimming="CharacterEllipsis" Width="260"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SHA256" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Hash, FallbackValue=—}" TextTrimming="CharacterEllipsis" Width="260"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Actions -->
                <WrapPanel Grid.Row="2" ItemHeight="40" Margin="0,8,0,0">
                    <Button Content="Transcribe (ASR)" Command="{Binding TranscribeCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Noise-Reduce" Command="{Binding NoiseReduceCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="VAD Trim" Command="{Binding VadTrimCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Normalize" Command="{Binding NormalizeCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Convert…" Command="{Binding ConvertCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Split on Silence" Command="{Binding SplitOnSilenceCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Synthesize (TTS)" Command="{Binding SynthesizeCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Clone Voice" Command="{Binding CloneVoiceCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Open Folder" Command="{Binding OpenFolderCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                    <Button Content="Delete" Command="{Binding DeleteCmd}" Style="{StaticResource SolidDarkButton}" Margin="0,0,8,8"/>
                </WrapPanel>

                <!-- Jobs -->
                <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="10" Style="{StaticResource GlassCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Jobs" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}"/>
                                        <ProgressBar Value="{Binding ProgressPercent}" Height="12" Style="{StaticResource RainbowGlassProgressBarStyle}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding StatusText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                </Grid>

                <!-- Filters Panel -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="14">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Apply Filters" FontSize="16" FontWeight="SemiBold"/>
                            <Button Content="Reset" Style="{StaticResource SecondaryGlassButtonStyle}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        </DockPanel>
                        <TextBlock Text="Model" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/>

                        <TextBlock Text="Transpose" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,4"/>
                        <Slider Minimum="-12" Maximum="12" Value="{Binding Transpose}" Style="{StaticResource RainbowGlassSliderStyle}"/>

                        <TextBlock Text="No. of generations" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,4"/>
                        <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NumGenerations}" Style="{StaticResource RainbowGlassSliderStyle}"/>

                        <TextBlock Text="Algorithm" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}"/>

                        <CheckBox Content="Clean Vocals" IsChecked="{Binding CleanVocals}" Margin="0,12,0,0" Style="{StaticResource GlassCheckBoxStyle}"/>

                        <TextBlock Text="Harmony" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding Harmonies}" SelectedItem="{Binding SelectedHarmony}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BOTTOM: Transport -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Style="{StaticResource GlassCardStyle}"
                Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding PlayPauseCmd}" Content="{Binding PlayPauseLabel}" Style="{StaticResource SolidDarkButton}"/>
                    <Button Command="{Binding StopCmd}" Content="⏹" Style="{StaticResource SolidDarkButton}" Margin="8,0,0,0"/>
                </StackPanel>
                <Slider Margin="12,0" Style="{StaticResource RainbowGlassSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"/>
                <TextBlock Text="{Binding PositionText}" Margin="8,0"/>
                <TextBlock Text="/" Margin="4,0"/>
                <TextBlock Text="{Binding DurationText}" Margin="4,0"/>
                <ComboBox Width="220" Margin="12,0,0,0"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
