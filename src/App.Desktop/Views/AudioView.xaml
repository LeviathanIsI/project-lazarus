<UserControl x:Class="Lazarus.Desktop.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="800">

    <!-- If you already have theme resources (GlassSurface, Border, etc.), they’ll apply.
         If not, WPF defaults still render fine. -->

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Library -->
        <Border Grid.Row="0" Grid.Column="0"
                CornerRadius="12"
                Padding="12"
                Background="{DynamicResource GlassSurface}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- Toolbar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" >
                    <Button Command="{Binding RecordCmd}" Margin="0,0,8,0" Content="⏺ Record"/>
                    <Button Command="{Binding StopRecordCmd}" Margin="0,0,8,0" Content="⏹ Stop"/>
                    <Button Command="{Binding ImportCmd}" Margin="0,0,8,0" Content="⬆ Import"/>
                    <ToggleButton IsChecked="{Binding IsPreviewEnabled}" Content="👁 Preview" Margin="0,0,8,0"/>
                    <ComboBox Width="140" SelectedItem="{Binding SortMode}">
                        <ComboBoxItem Content="Name"/>
                        <ComboBoxItem Content="Date"/>
                        <ComboBoxItem Content="Size"/>
                        <ComboBoxItem Content="Duration"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search (WPF-compatible placeholder/watermark) -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Search audio…"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- List -->
                <ListView ItemsSource="{Binding Items}"
                          SelectedItem="{Binding ActiveItem, Mode=TwoWay}"
                          SelectionMode="Extended"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="80" Header="Wave">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Rectangle Height="16" Fill="{DynamicResource AccentBrush}">
                                            <Rectangle.OpacityMask>
                                                <!-- Placeholder sparkline -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0.0" Color="Black"/>
                                                    <GradientStop Offset="0.2" Color="Transparent"/>
                                                    <GradientStop Offset="0.4" Color="Black"/>
                                                    <GradientStop Offset="0.6" Color="Transparent"/>
                                                    <GradientStop Offset="0.8" Color="Black"/>
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="*" Header="Name" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Width="90" Header="Duration" DisplayMemberBinding="{Binding Duration}"/>
                            <GridViewColumn Width="85" Header="Size" DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Width="140" Header="Modified">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Modified, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BorderBrush}" CornerRadius="4"/>

        <!-- RIGHT: Details -->
        <Border Grid.Row="0" Grid.Column="2"
                CornerRadius="12"
                Padding="12"
                Background="{DynamicResource GlassSurfaceAlt}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- Big Waveform (placeholder) -->
                <Border Grid.Row="0" CornerRadius="10" Padding="12"
                        Background="{DynamicResource GlassSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding ActiveItem.Name, FallbackValue=No Selection}"
                                   FontSize="14" Foreground="{DynamicResource SubtleBrush}"/>
                        <Viewbox Stretch="Fill" Margin="0,24,0,0">
                            <Path StrokeThickness="2" Stroke="{DynamicResource AccentBrush}"
                                  Data="M 0,50 L 40,30 80,55 120,10 160,60 200,35 240,50 280,20 320,70 360,50"/>
                        </Viewbox>
                    </Grid>
                </Border>

                <!-- File Info -->
                <Border Grid.Row="1" Margin="0,12,0,8" Padding="12" CornerRadius="10"
                        Background="{DynamicResource GlassSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <UniformGrid Columns="4" Rows="2">
                        <StackPanel>
                            <TextBlock Text="Duration" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Duration, FallbackValue=—}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Sample Rate" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.SampleRate, FallbackValue=44\,100 Hz}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Channels" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Channels, FallbackValue=Mono}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bitrate" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Bitrate, FallbackValue=256 kbps}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Format" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Format, FallbackValue=wav}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Size" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Size, FallbackValue=—}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Path" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Path, FallbackValue=—}" TextTrimming="CharacterEllipsis" Width="260"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SHA256" Foreground="{DynamicResource SubtleBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding ActiveItem.Hash, FallbackValue=—}" TextTrimming="CharacterEllipsis" Width="260"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Actions -->
                <WrapPanel Grid.Row="2" ItemWidth="180" ItemHeight="40" Margin="0,8,0,0">
                    <Button Content="Transcribe (ASR)" Command="{Binding TranscribeCmd}" />
                    <Button Content="Noise-Reduce" Command="{Binding NoiseReduceCmd}" />
                    <Button Content="VAD Trim" Command="{Binding VadTrimCmd}" />
                    <Button Content="Normalize" Command="{Binding NormalizeCmd}" />
                    <Button Content="Convert…" Command="{Binding ConvertCmd}" />
                    <Button Content="Split on Silence" Command="{Binding SplitOnSilenceCmd}" />
                    <Button Content="Synthesize (TTS)" Command="{Binding SynthesizeCmd}" />
                    <Button Content="Clone Voice" Command="{Binding CloneVoiceCmd}" />
                    <Button Content="Open Folder" Command="{Binding OpenFolderCmd}" />
                    <Button Content="Delete" Command="{Binding DeleteCmd}" />
                </WrapPanel>

                <!-- Jobs -->
                <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="10"
                        Background="{DynamicResource GlassSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Jobs" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}"/>
                                        <ProgressBar Value="{Binding ProgressPercent}" Height="6"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                                                   Text="{Binding StatusText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BOTTOM: Transport -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                CornerRadius="12"
                Background="{DynamicResource GlassSurface}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding PlayPauseCmd}" Content="{Binding PlayPauseLabel}"/>
                    <Button Command="{Binding StopCmd}" Content="⏹" Margin="8,0,0,0"/>
                </StackPanel>
                <Slider Margin="12,0"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"/>
                <TextBlock Text="{Binding PositionText}" Margin="8,0"/>
                <TextBlock Text="/" Margin="4,0"/>
                <TextBlock Text="{Binding DurationText}" Margin="4,0"/>
                <ComboBox Width="220" Margin="12,0,0,0"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
