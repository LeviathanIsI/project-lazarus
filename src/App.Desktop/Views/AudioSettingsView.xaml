<UserControl x:Class="Lazarus.Desktop.Views.AudioSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <CheckBox Margin="0,6" Content="Enable TTS" IsChecked="{Binding AudioEnableTts, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Piper Executable" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" Text="{Binding AudioPiperExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowsePiperExecutableCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Piper Voice" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="200" Text="{Binding AudioPiperVoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <CheckBox Margin="0,6" Content="Enable ASR" IsChecked="{Binding AudioEnableAsr, Mode=TwoWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
    <StackPanel Orientation="Horizontal" Margin="0,6">
      <TextBlock Width="200" VerticalAlignment="Center" Text="Faster-Whisper Executable" Foreground="{StaticResource TextPrimaryBrush}"/>
      <TextBox Width="320" Text="{Binding AudioFasterWhisperExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseFasterWhisperExecutableCommand}" Style="{StaticResource SecondaryGlassButtonStyle}"/>
    </StackPanel>
  </StackPanel>
</UserControl>

