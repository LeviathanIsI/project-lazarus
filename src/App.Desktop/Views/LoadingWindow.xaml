<Window x:Class="Lazarus.Desktop.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lazarus Loading"
        Width="400"
        Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseCircle"
                           Storyboard.TargetProperty="Opacity"
                           From="0.3" To="1.0" Duration="0:0:1.5"
                           AutoReverse="True" />
        </Storyboard>
        
        <Storyboard x:Key="RotateAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RotateTransform"
                           Storyboard.TargetProperty="Angle"
                           From="0" To="360" Duration="0:0:2" />
        </Storyboard>
        
        <Storyboard x:Key="TypewriterAnimation" RepeatBehavior="Forever">
            <StringAnimationUsingKeyFrames Storyboard.TargetName="LoadingText"
                                         Storyboard.TargetProperty="Text">
                <DiscreteStringKeyFrame KeyTime="0:0:0" Value="" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.1" Value="I" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.2" Value="IN" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.3" Value="INI" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.4" Value="INIT" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.5" Value="INITI" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.6" Value="INITIA" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.7" Value="INITIAL" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.8" Value="INITIALI" />
                <DiscreteStringKeyFrame KeyTime="0:0:0.9" Value="INITIALIZ" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.0" Value="INITIALIZI" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.1" Value="INITIALIZIN" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.2" Value="INITIALIZING" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.3" Value="INITIALIZING " />
                <DiscreteStringKeyFrame KeyTime="0:0:1.4" Value="INITIALIZING L" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.5" Value="INITIALIZING LA" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.6" Value="INITIALIZING LAZ" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.7" Value="INITIALIZING LAZA" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.8" Value="INITIALIZING LAZAR" />
                <DiscreteStringKeyFrame KeyTime="0:0:1.9" Value="INITIALIZING LAZARU" />
                <DiscreteStringKeyFrame KeyTime="0:0:2.0" Value="INITIALIZING LAZARUS" />
                <DiscreteStringKeyFrame KeyTime="0:0:2.1" Value="INITIALIZING LAZARUS." />
                <DiscreteStringKeyFrame KeyTime="0:0:2.2" Value="INITIALIZING LAZARUS.." />
                <DiscreteStringKeyFrame KeyTime="0:0:2.3" Value="INITIALIZING LAZARUS..." />
                <DiscreteStringKeyFrame KeyTime="0:0:3.0" Value="" />
            </StringAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    
    <Border Background="#FF1A1A1A" 
            CornerRadius="10"
            BorderBrush="#FF333333"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                             Direction="270" 
                             ShadowDepth="10" 
                             Opacity="0.8" 
                             BlurRadius="20" />
        </Border.Effect>
        
        <Grid>
            <!-- Animated Background Elements -->
            <Canvas>
                <!-- Rotating Geometric Shape -->
                <Ellipse Canvas.Left="50" Canvas.Top="50"
                        Width="100" Height="100"
                        Stroke="#FF00D4AA"
                        StrokeThickness="2"
                        Fill="Transparent"
                        RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RotateTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                
                <!-- Pulsing Circle -->
                <Ellipse Canvas.Left="175" Canvas.Top="75"
                        Width="50" Height="50"
                        Fill="#FF00D4AA"
                        Opacity="0.3"
                        x:Name="PulseCircle" />
                
                <!-- Inner Rotating Ring -->
                <Path Canvas.Left="150" Canvas.Top="50"
                      Stroke="#FF00D4AA"
                      StrokeThickness="1"
                      Data="M 50,25 A 25,25 0 1,1 49.9,25">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="InnerRotateTransform" />
                    </Path.RenderTransform>
                </Path>
            </Canvas>
            
            <!-- Main Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Loading Text -->
                <TextBlock x:Name="LoadingText"
                          Text="INITIALIZING LAZARUS..."
                          FontFamily="Consolas"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="#FFFFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20" />
                
                <!-- Progress Text -->
                <TextBlock x:Name="ProgressText"
                          Text="Starting services..."
                          FontFamily="Segoe UI"
                          FontSize="10"
                          Foreground="#FFCCCCCC"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10" />
                
                <!-- Progress Bar -->
                <ProgressBar x:Name="ProgressBar"
                            Width="300"
                            Height="4"
                            Background="#FF333333"
                            Foreground="#FF00D4AA"
                            IsIndeterminate="True"
                            Margin="0,0,0,10" />
                
                <!-- Error Message (Hidden by default) -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorMessage"
                              Text="Initialization failed"
                              FontFamily="Segoe UI"
                              FontSize="10"
                              Foreground="#FFFF6B6B"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="RetryButton"
                               Content="Retry"
                               Width="60"
                               Height="25"
                               Margin="0,0,10,0"
                               Background="#FF00D4AA"
                               Foreground="White"
                               BorderThickness="0"
                               Click="RetryButton_Click" />
                        
                        <Button x:Name="ExitButton"
                               Content="Exit"
                               Width="60"
                               Height="25"
                               Background="#FFFF6B6B"
                               Foreground="White"
                               BorderThickness="0"
                               Click="ExitButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>