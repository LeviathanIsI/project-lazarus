<UserControl x:Class="Lazarus.Desktop.Views.ImageLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Lazarus.Shared;assembly=Lazarus.Shared">
    <UserControl.DataContext>
        <Binding Source="{StaticResource ViewModelLocator}" Path="ImageLabViewModel"/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Stats -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="24,24,24,8">
            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total Images" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding TotalImages}" Style="{StaticResource H1TextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Generated Today" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding GeneratedToday}" Style="{StaticResource H1TextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Storage Used" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock>
                        <Run Text="{Binding StorageUsedMb, StringFormat=F2}"/>
                        <Run Text=" MB"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Processing" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding ProcessingStatus}" Style="{StaticResource H2TextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Center: Preview + prompts + mode -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource GlassCardStyle}" Padding="8" Height="360">
                    <Grid>
                        <Image Source="{Binding PreviewImagePath}" Stretch="Uniform"/>
                        <TextBlock Text="No preview" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Prompt"/>
                        <TextBox Text="{Binding Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                        <TextBlock Text="Negative Prompt" Margin="0,8,0,0"/>
                        <TextBox Text="{Binding NegativePrompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Mode"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton GroupName="Mode" Content="Txt2Img" IsChecked="{Binding Mode, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Txt2Img}"/>
                            <RadioButton GroupName="Mode" Content="Img2Img" Margin="8,0,0,0" IsChecked="{Binding Mode, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Img2Img}"/>
                            <RadioButton GroupName="Mode" Content="Inpaint" Margin="8,0,0,0" IsChecked="{Binding Mode, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=Inpaint}"/>
                        </StackPanel>

                        <!-- Img2Img -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Img2Img">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Inpaint">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Init Image"/>
                            <TextBox Text="{Binding InitImagePath, Mode=TwoWay}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Strength"/>
                                <Slider Width="160" Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding Strength, Mode=TwoWay}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Inpaint-only mask -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Inpaint">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Mask Image"/>
                            <TextBox Text="{Binding MaskImagePath, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right rail: assets + params -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ControlNet"/>
                        <ComboBox ItemsSource="{Binding ControlNets}" SelectedItem="{Binding SelectedControlNet}"/>
                        <TextBlock Text="Style Preset" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding StylePresets}" SelectedItem="{Binding SelectedStylePreset}"/>
                        <TextBlock Text="Upscaler" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding Upscalers}" SelectedItem="{Binding SelectedUpscaler}"/>
                        <TextBlock Text="VAE" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding Vaes}" SelectedItem="{Binding SelectedVAE}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Seed"/>
                            <TextBox Text="{Binding Seed, Mode=TwoWay}" Width="120" Margin="8,0,0,0"/>
                            <Button Content="🎲" Width="32" Margin="8,0,0,0" Command="{Binding RandomizeSeedCommand}"/>
                            <Button Content="🔒" Width="32" Margin="8,0,0,0" Command="{Binding LockSeedCommand}"/>
                        </StackPanel>
                        <TextBlock Text="Steps" Margin="0,8,0,0"/>
                        <Slider Minimum="1" Maximum="200" Value="{Binding Steps, Mode=TwoWay}"/>
                        <TextBlock Text="CFG Scale" Margin="0,8,0,0"/>
                        <Slider Minimum="0" Maximum="20" SmallChange="0.1" Value="{Binding CfgScale, Mode=TwoWay}"/>
                        <TextBlock Text="Width" Margin="0,8,0,0"/>
                        <Slider Minimum="64" Maximum="2048" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding Width, Mode=TwoWay}"/>
                        <TextBlock Text="Height" Margin="0,8,0,0"/>
                        <Slider Minimum="64" Maximum="2048" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding Height, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom actions -->
        <Border Grid.Row="2" Margin="24" Padding="12" Style="{StaticResource GlassCardStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Generate" Style="{StaticResource RainbowAccentButton.AutoFit}" Command="{Binding GenerateCommand}"/>
                <TextBlock Text="{Binding JobLog}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

