<UserControl x:Class="Lazarus.Desktop.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Lazarus.Shared;assembly=Lazarus.Shared"
             xmlns:conv="clr-namespace:Lazarus.Desktop.Converters">
    <UserControl.DataContext>
        <Binding Source="{StaticResource ViewModelLocator}" Path="ModelsViewModel"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <conv:RunnerKindToStringConverter x:Key="RunnerKindToStringConverter"/>
        <conv:PathToFileNameConverter x:Key="PathToFileNameConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Models"
                                   Style="{StaticResource H1TextStyle}"/>
                        <TextBlock Text="Pick a base model, attach LoRA(s), choose tokenizer and embedding, tune parameters, then save/load presets"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Refresh"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selections -->
                    <StackPanel Grid.Column="0">
                        <!-- Base Model -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Base Model" Style="{StaticResource H3TextStyle}"/>
                                    <ComboBox ItemsSource="{Binding VisibleBaseModels}"
                                              SelectedItem="{Binding SelectedModel}"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="DisplayName"
                                              Margin="0,8,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                    <TextBlock Text="  "/>
                                                    <ContentControl Margin="8,0,0,0" Style="{StaticResource RainbowBorderChip}">
                                                        <ContentControl.Content>
                                                            <TextBlock>
                                                                <Run Text="{Binding Format}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="-  "/>
                                                                <Run Text="{Binding PreferredRunner, Converter={StaticResource RunnerKindToStringConverter}}"/>
                                                            </TextBlock>
                                                        </ContentControl.Content>
                                                    </ContentControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                <TextBlock Text="Path:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{x:Static shared:LazarusPaths+Models.BaseModels}" Style="{StaticResource SecondaryTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- LoRA Adapter (dropdown) -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="LoRA Adapter" Style="{StaticResource H3TextStyle}"/>
                                <ComboBox ItemsSource="{Binding LoraAdapters}"
                                          SelectedItem="{Binding SelectedLora, Mode=TwoWay}"
                                          MinWidth="360">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Path:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{x:Static shared:LazarusPaths+Models.LoRAAdapters}" Style="{StaticResource SecondaryTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Load" Style="{StaticResource RainbowAccentButton.AutoFit}" Command="{Binding LoadLoraCommand}"/>
                                    <Button Content="Unload" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="8,0,0,0" Command="{Binding UnloadLoraCommand}"/>
                                    <Button Content="Verify" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="8,0,0,0" Command="{Binding VerifyAdapterCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Loaded: " Style="{StaticResource SecondaryTextStyle}"/>
                                    <TextBlock Text="{Binding LoadedLoraDisplayName}" Style="{StaticResource SecondaryTextStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Influence:" Style="{StaticResource SecondaryTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Slider Width="180"
                                                Minimum="0" Maximum="1"
                                                SmallChange="0.01" LargeChange="0.1"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                IsEnabled="{Binding IsLoraLoaded}"
                                                Value="{Binding LoraScaleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding LoraScaleValue, StringFormat=F2}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tokenizer & Embedding -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Tokenizer" Style="{StaticResource H3TextStyle}"/>
                                    <ComboBox ItemsSource="{Binding Tokenizers}"
                                              SelectedItem="{Binding SelectedTokenizer}"
                                              Margin="0,8,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Path:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{x:Static shared:LazarusPaths+Models.Tokenizers}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Load" Style="{StaticResource RainbowAccentButton.AutoFit}" Command="{Binding LoadTokenizerCommand}"/>
                                        <Button Content="Unload" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="8,0,0,0" Command="{Binding UnloadTokenizerCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Grid.Column="1" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Embedding" Style="{StaticResource H3TextStyle}"/>
                                    <ComboBox ItemsSource="{Binding Embeddings}"
                                              SelectedItem="{Binding SelectedEmbedding}"
                                              Margin="0,8,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Path:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{x:Static shared:LazarusPaths+Models.Embeddings}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Load" Style="{StaticResource RainbowAccentButton.AutoFit}" Command="{Binding LoadEmbeddingCommand}"/>
                                        <Button Content="Unload" Style="{StaticResource SecondaryGlassButtonStyle}" Margin="8,0,0,0" Command="{Binding UnloadEmbeddingCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Parameters -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Parameters" Style="{StaticResource H3TextStyle}" Grid.Row="0" Grid.ColumnSpan="2"/>

                                <TextBlock Text="Temperature" Grid.Row="1"/>
                                <TextBox Text="{Binding Temperature, Mode=TwoWay, StringFormat=F2}"
                                         Grid.Row="1" Grid.Column="1"/>

                                <TextBlock Text="Top P" Grid.Row="2"/>
                                <TextBox Text="{Binding TopP, Mode=TwoWay, StringFormat=F2}"
                                         Grid.Row="2" Grid.Column="1"/>

                                <TextBlock Text="Top K" Grid.Row="3"/>
                                <TextBox Text="{Binding TopK, Mode=TwoWay}"
                                         Grid.Row="3" Grid.Column="1"/>

                                <TextBlock Text="Max Tokens" Grid.Row="4"/>
                                <TextBox Text="{Binding MaxTokens, Mode=TwoWay}"
                                         Grid.Row="4" Grid.Column="1"/>

                                <TextBlock Text="Repetition Penalty" Grid.Row="5"/>
                                <TextBox Text="{Binding RepetitionPenalty, Mode=TwoWay, StringFormat=F2}"
                                         Grid.Row="5" Grid.Column="1"/>

                                <TextBlock Text="Mirostat" Grid.Row="6"/>
                                <TextBox Text="{Binding Mirostat, Mode=TwoWay}"
                                         Grid.Row="6" Grid.Column="1"/>

                                <TextBlock Text="Seed" Grid.Row="7"/>
                                <TextBox Text="{Binding Seed, Mode=TwoWay}"
                                         Grid.Row="7" Grid.Column="1"/>

                                <TextBlock Text="Presence/Frequency" Grid.Row="8"/>
                                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="80" Margin="0,0,8,0" Text="{Binding PresencePenalty, Mode=TwoWay}"/>
                                    <TextBox Width="80" Text="{Binding FrequencyPenalty, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: Presets + Runner Control -->
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="16,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Save Preset" Style="{StaticResource H3TextStyle}"/>
                                <TextBox Text="{Binding NewPresetName, Mode=TwoWay}"
                                         Margin="0,8,0,8"/>
                                <Button Content="Save"
                                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                                        Command="{Binding SavePresetCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="16,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Load Preset" Style="{StaticResource H3TextStyle}"/>
                                <ComboBox ItemsSource="{Binding PresetNames}"
                                          SelectedItem="{Binding SelectedPresetName}"
                                          Margin="0,8,0,8"/>
                                <Button Content="Load"
                                        Style="{StaticResource RainbowAccentButton.AutoFit}"
                                        Command="{Binding LoadPresetCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Runner Control -->
                        <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="16,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Runner" Style="{StaticResource H3TextStyle}"/>
                                <!-- Runner selection: visible only when not running -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunnerRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox Width="260"
                                              ItemsSource="{Binding VisibleRunnerCatalog}"
                                              SelectedItem="{Binding SelectedRunner}"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="DisplayName">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Engine}"/>
                                                    <Run Text="  "/>
                                                    <Run Text="{Binding DisplayName}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- Hint when a model was chosen first -->
                                <TextBlock Margin="0,0,0,8" Text="Choose a runner for this model">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRunnerHint}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                    <Button Content="Load Selected"
                                            Command="{Binding LoadSelectedModelCommand}"
                                            Style="{StaticResource RainbowAccentButton.AutoFit}"/>
                                    <!-- Inline disabled-reason hint -->
                                    <TextBlock Margin="8,0,0,0" Text="{Binding LoadDisabledReason}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="Orchestrator offline">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="Runner already running">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="Choose a runner for this model">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="Choose a runner and model">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoadDisabledReason}" Value="Select a model to enable loading">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Unload"
                                            Margin="8,0,0,0"
                                            Command="{Binding UnloadRunnerCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RainbowAccentButton.AutoFit}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunnerRunning}" Value="True">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Refresh"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource RainbowAccentButton.AutoFit}"
                                            Command="{Binding RefreshRunnerStatusCommand}"/>
                                </StackPanel>
                                <!-- Empty state for runners -->
                                <TextBlock Margin="0,0,0,8"
                                           Text="No runners detected. Add engines under %LOCALAPPDATA%/Lazarus/Runners/.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunnerCatalog.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Status:" Style="{StaticResource SecondaryTextStyle}"/>
                                <TextBlock Text="{Binding IsRunnerRunning}"/>
                                <TextBlock Text="Model Path:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerModelPath}" TextWrapping="Wrap"/>
                                <TextBlock Text="PID:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerPid}"/>
                                
                                <!-- Diagnostics -->
                                <TextBlock Text="Binary:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerExePath}" TextWrapping="Wrap"/>
                                <TextBlock Text="Port:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerPort}"/>
                                <TextBlock Text="Err Log:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerErrLog}" TextWrapping="Wrap"/>
                                <TextBlock Text="Out Log:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerOutLog}" TextWrapping="Wrap"/>
                                <!-- LoRA diagnostics -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Padding="8,2" Background="#10A779">
                                        <TextBlock>
                                            <Run Text="LoRA applied "/>
                                            <Run Text="("/>
                                            <Run Text="{Binding LorasApplied, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                            <Run Text="  "/>
                                            <Run Text="[evidence:"/>
                                            <Run Text="{Binding LoraEvidenceCount, Mode=OneWay}"/>
                                            <Run Text="]"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Launch Args:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding LaunchArgs}" TextWrapping="Wrap"/>
                                <TextBlock Text="Launch .cmd:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding CmdPath}" TextWrapping="Wrap"/>
                                <TextBlock Text="Message:" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding RunnerStatusMessage}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid Style="{StaticResource LoadingOverlayStyle}"
              IsHitTestVisible="{Binding IsLoadingModel}"
              Panel.ZIndex="20"
              Visibility="{Binding IsLoadingModel, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource GlassCardStyle}"
                    Padding="32"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Model loading in progress">
                <StackPanel>
                    <ContentControl Template="{StaticResource RainbowLoadingSpinnerTemplate}"
                                    HorizontalAlignment="Center"/>
                    <TextBlock Text="Preparing inference runner..."
                               Style="{StaticResource H2TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="{Binding RunnerStatusMessage, TargetNullValue=Preparing model and adapters..., FallbackValue=Preparing model and adapters...}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,12,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Border Height="1"
                            Margin="0,20,0,16"
                            Background="{StaticResource GlassBorderBrush}"
                            Opacity="0.6"/>
                    <StackPanel>
                        <TextBlock Text="Base model"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding SelectedModel.DisplayName, TargetNullValue=None selected, FallbackValue=None selected}"
                                   Style="{StaticResource H3TextStyle}"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="LoRA adapter"
                                   Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock Text="{Binding LoadedLoraDisplayName, TargetNullValue=No adapter selected, FallbackValue=No adapter selected}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LoraScaleValue, StringFormat='Influence = {0:F2}'}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsLoraLoaded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>

