<UserControl x:Class="Lazarus.Desktop.Views.LoggingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoggingSettingsViewModel}">
    <UserControl.Resources>
        <!-- Local converters and brush fallbacks -->
        <local:StringToBooleanConverter x:Key="StringToBooleanConverter" xmlns:local="clr-namespace:Lazarus.Desktop.Converters"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2D2D"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,20,0">
            <!-- Section Header -->
            <TextBlock Text="Logging" FontSize="20" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Configure application logging and diagnostics" FontSize="12"
                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- General Logging Settings Group -->
            <TextBlock Text="General Settings" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Enable Logging -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Enable Logging" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <CheckBox Grid.Column="1" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsChecked="{Binding EnableLogging, Mode=TwoWay}"
                         Content="Enable application logging"
                         ToolTip="Enable or disable all logging functionality"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Log Level -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Log Level" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding LogLevel, Mode=TwoWay}"
                         ToolTip="Set the minimum severity level for log messages">
                    <ComboBoxItem Content="Verbose"/>
                    <ComboBoxItem Content="Debug"/>
                    <ComboBoxItem Content="Information"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Error"/>
                    <ComboBoxItem Content="Critical"/>
                </ComboBox>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                       Text="Choose how much detail to write to logs. Debug/Verbose are very chatty."/>

            <!-- Log Format -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Log Format" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="Plain Text" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               IsChecked="{Binding Path=LogFormat, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=PlainText}"
                               Margin="0,0,16,0" ToolTip="Simple text format"/>
                    <RadioButton Content="JSON" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               IsChecked="{Binding Path=LogFormat, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=JSON}"
                               Margin="0,0,16,0" ToolTip="Structured JSON format"/>
                    <RadioButton Content="XML" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               IsChecked="{Binding Path=LogFormat, Converter={StaticResource StringToBooleanConverter}, ConverterParameter=XML}"
                               ToolTip="Structured XML format"/>
                </StackPanel>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                       Text="Plain Text is easy to read. JSON/XML help with automated analysis."/>

            <!-- File Logging Settings Group -->
            <TextBlock Text="File Logging" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Enable File Logging -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Log to File" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <CheckBox Grid.Column="1" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsChecked="{Binding LogToFile, Mode=TwoWay}"
                         Content="Save logs to file"
                         ToolTip="Write log messages to disk"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Log File Path -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Log Directory" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBox Grid.Column="1" 
                        Text="{Binding LogDirectory, Mode=TwoWay}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>
                
                <Button Grid.Column="2" Content="Browse" 
                       Command="{Binding BrowseLogDirectoryCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="8,4"/>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                       Text="Where log files are saved on disk."/>

            <!-- Max File Size -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Max File Size" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                        Minimum="1" Maximum="100" 
                        Value="{Binding MaxFileSize, Mode=TwoWay}"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        ToolTip="Maximum size of each log file"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding MaxFileSize, StringFormat='{}{0} MB'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                       Text="Creates a new file when the current log reaches this size."/>

            <!-- File Rotation -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="File Rotation" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <ComboBox Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left"
                         SelectedItem="{Binding FileRotation, Mode=TwoWay}"
                         ToolTip="When to create new log files">
                    <ComboBoxItem Content="Never"/>
                    <ComboBoxItem Content="Daily"/>
                    <ComboBoxItem Content="Weekly"/>
                    <ComboBoxItem Content="Monthly"/>
                    <ComboBoxItem Content="When size limit reached"/>
                </ComboBox>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                       Text="How often to start a fresh log file."/>

            <!-- Retention Days -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Retention Period" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <Slider Grid.Column="1" 
                        Minimum="1" Maximum="365" 
                        Value="{Binding RetentionDays, Mode=TwoWay}"
                        TickFrequency="30" IsSnapToTickEnabled="True"
                        ToolTip="How long to keep old log files"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding RetentionDays, StringFormat='{}{0} days'}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                       Text="Old logs older than this will be removed automatically."/>

            <!-- Performance Logging Group -->
            <TextBlock Text="Performance &amp; Metrics" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Performance Metrics -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Performance Metrics" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogPerformanceMetrics, Mode=TwoWay}"
                             Content="Log performance metrics"
                             ToolTip="Track CPU, memory, and GPU usage"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogModelInference, Mode=TwoWay}"
                             Content="Log model inference times"
                             ToolTip="Track how long model predictions take"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogApiCalls, Mode=TwoWay}"
                             Content="Log API call details"
                             ToolTip="Track external API calls and responses"
                             Margin="0,0,0,4"/>
                </StackPanel>
            </Grid>

            <!-- Debug Logging Group -->
            <TextBlock Text="Debug &amp; Diagnostics" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Debug Options -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Debug Options" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding EnableVerboseLogging, Mode=TwoWay}"
                             Content="Enable verbose debug logging"
                             ToolTip="Log detailed debug information"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogStackTraces, Mode=TwoWay}"
                             Content="Include stack traces in errors"
                             ToolTip="Add full stack traces to error logs"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding LogSensitiveData, Mode=TwoWay}"
                             Content="Include sensitive data (CAUTION)"
                             ToolTip="WARNING: May log passwords and API keys"
                             Margin="0,0,0,4"/>
                </StackPanel>
            </Grid>

            <!-- Console Output -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Console Output" 
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <CheckBox Grid.Column="1" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         IsChecked="{Binding LogToConsole, Mode=TwoWay}"
                         Content="Show logs in console window"
                         ToolTip="Display log messages in the debug console"
                         VerticalAlignment="Center"/>
            </Grid>

            <!-- Crash Reporting Group -->
            <TextBlock Text="Crash Reporting" FontSize="16" FontWeight="SemiBold"
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,8"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

            <!-- Crash Reports -->
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Crash Reports" 
                          VerticalAlignment="Top" Margin="0,5,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <StackPanel Grid.Column="1">
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding SendCrashReports, Mode=TwoWay}"
                             Content="Send crash reports automatically"
                             ToolTip="Help improve stability by sending crash data"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding IncludeSystemInfo, Mode=TwoWay}"
                             Content="Include system information"
                             ToolTip="Include OS and hardware details in reports"
                             Margin="0,0,0,4"/>
                    <CheckBox Foreground="{StaticResource TextPrimaryBrush}"
                             IsChecked="{Binding CreateLocalDumps, Mode=TwoWay}"
                             Content="Create local crash dumps"
                             ToolTip="Save crash dumps locally for debugging"/>
                </StackPanel>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Open Log Folder" 
                       Command="{Binding OpenLogFolderCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="12,6"/>
                
                <Button Content="Clear All Logs" 
                       Command="{Binding ClearLogsCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Margin="0,0,8,0"
                       Padding="12,6"/>
                
                <Button Content="Reset to Defaults" 
                       Command="{Binding ResetToDefaultCommand}"
                       Style="{StaticResource SecondaryGlassButtonStyle}"
                       Padding="12,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
