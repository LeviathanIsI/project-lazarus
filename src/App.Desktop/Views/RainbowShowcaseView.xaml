<UserControl x:Class="Lazarus.Desktop.Views.RainbowShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Background="{StaticResource BackgroundBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Rainbow Text Showcase -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="FINEXA Rainbow Gradients Showcase" 
                       Style="{StaticResource AnimatedRainbowTextStyle}"
                       FontSize="28"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Advanced AI Analytics" 
                       Style="{StaticResource RainbowTextStyle}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Rainbow Border Cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,32">
            <Border Style="{StaticResource RainbowBorderCardStyle}" 
                    Margin="0,0,8,0"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Flowing Borders" 
                               Style="{StaticResource H3TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Rainbow gradients flow around card borders with smooth animations" 
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource InteractiveRainbowCardStyle}" 
                    Margin="8,0"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Interactive Elements" 
                               Style="{StaticResource H3TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Hover and click for enhanced rainbow interactions" 
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource RainbowBorderCardStyle}" 
                    Margin="8,0,0,0"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Status Indicators" 
                               Style="{StaticResource H3TextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Style="{StaticResource RainbowStatusDotStyle}" Margin="0,0,8,0"/>
                        <TextBlock Text="Rainbow Ready" Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Rainbow Buttons and Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
            <Button Content="Rainbow Button" 
                    Style="{StaticResource RainbowBorderButtonStyle}"
                    Margin="0,0,16,0"/>
            <ContentControl Style="{StaticResource RainbowChip}" Content="Status Pill"/>
        </StackPanel>

        <!-- Progress Demonstrations -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Rainbow Progress Elements" 
                       Style="{StaticResource RainbowTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>
            
            <StackPanel>
                <!-- Loading Spinner -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <ContentControl Template="{StaticResource RainbowLoadingSpinnerTemplate}"/>
                    <TextBlock Text="Rainbow Loading Spinner" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
                
                <!-- Progress Bar -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Rainbow Progress Bar" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <ProgressBar Style="{StaticResource RainbowGlassProgressBarStyle}"
                                 Width="300"
                                 Value="65"
                                 Maximum="100"/>
                </StackPanel>
                
                <!-- Indeterminate Progress -->
                <StackPanel>
                    <TextBlock Text="Indeterminate Rainbow Flow" 
                               Style="{StaticResource BodyTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <ProgressBar Style="{StaticResource RainbowProgressBarStyle}"
                                 Width="300"
                                 IsIndeterminate="True"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
