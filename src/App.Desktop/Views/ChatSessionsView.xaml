<UserControl x:Class="Lazarus.Desktop.Views.ChatSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- DataContext inherited from parent or set via ViewModelLocator -->
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Session List Panel -->
        <Border Grid.Column="0" 
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="16,16,8,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Session List Header -->
                <Border Grid.Row="0" 
                        Padding="20,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="Conversations" 
                                   Style="{StaticResource H3TextStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        
                        <Button Grid.Column="1"
                                Style="{StaticResource IconGlassButtonStyle}"
                                Command="{Binding NewChatCommand}"
                                ToolTip="Start new conversation"
                                AutomationProperties.Name="Start new conversation"
                                AutomationProperties.HelpText="Creates a new chat conversation">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 5V19M5 12H19" 
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Session List Content -->
                <Grid Grid.Row="1">
                    <!-- Empty State for No Conversations -->
                    <ContentControl Margin="12,8" Visibility="Collapsed">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConversations}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Content" Value="{StaticResource NoConversationsEmptyState}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- Conversations List -->
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8"
                             KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Style="{StaticResource InteractiveGlassCardStyle}" Padding="16,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Preview}"
                                                                   Style="{StaticResource SmallTextStyle}"
                                                                   Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:g}'}"
                                                                   Style="{StaticResource SmallTextStyle}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource IconGlassButtonStyle}"
                                                                ToolTip="Rename conversation"
                                                                Command="{Binding DataContext.BeginRenameChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z M20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Button Style="{StaticResource IconGlassButtonStyle}"
                                                                Command="{Binding DataContext.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Delete conversation">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Data="M19 7L18.1 19.9C17.9 21.1 16.8 22 15.6 22H8.4C7.2 22 6.1 21.1 5.9 19.9L5 7M10 11V17M14 11V17M15 7V4C15 3.4 14.6 3 14 3H10C9.4 3 9 3.4 9 4V7M4 7H20"
                                                                          StrokeThickness="2"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Column="1"
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="8,16,16,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat Header -->
                <Border Grid.Row="0"
                        Padding="24,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue=Chat Session}"
                                       Style="{StaticResource H3TextStyle}"
                                       AutomationProperties.HeadingLevel="Level3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" 
                                         Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
                                            <Setter Property="Text" Value="{Binding ModelName, FallbackValue='No model loaded'}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthy, FallbackValue=False}" Value="True">
                                                    <Setter Property="Text" Value="{Binding ModelName, StringFormat='{}{0} • Ready', FallbackValue='Loading...'}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHealthy, FallbackValue=False}" Value="False">
                                                    <Setter Property="Text" Value="{Binding ModelName, StringFormat='{}{0} • Not ready', FallbackValue='Not ready'}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="  •  " Style="{StaticResource SmallTextStyle}"/>
                                <TextBlock Text="{Binding AssistantDisplayName}" Style="{StaticResource SmallTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconGlassButtonStyle}"
                                    Margin="4,0"
                                    ToolTip="Clear conversation"
                                    AutomationProperties.Name="Clear conversation"
                                    AutomationProperties.HelpText="Removes all messages from this conversation">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19 7L18.1 19.9C17.9 21.1 16.8 22 15.6 22H8.4C7.2 22 6.1 21.1 5.9 19.9L5 7M10 11V17M14 11V17M15 7V4C15 3.4 14.6 3 14 3H10C9.4 3 9 3.4 9 4V7M4 7H20"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconGlassButtonStyle}"
                                    Margin="4,0"
                                    ToolTip="Export conversation"
                                    AutomationProperties.Name="Export conversation"
                                    AutomationProperties.HelpText="Downloads conversation as text or PDF">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M14 2V8H20M10 12V18M13 15L10 18L7 15M4 22H20C21.1 22 22 21.1 22 20V8L16 2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages Area -->
                <Grid Grid.Row="1">
                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage, FallbackValue=''}"
                               Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="24,12"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Messages List -->
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24"
                                  AutomationProperties.Name="Conversation messages"
                                  AutomationProperties.LiveSetting="Polite">
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,16">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource InteractiveGlassCardStyle}">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Margin" Value="0,0,40,0"/>
                                                <Setter Property="Padding" Value="20"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Margin" Value="40,0,0,0"/>
                                                        <!-- Harden against missing theme keys; both exist globally -->
                                                        <Setter Property="Background" Value="{StaticResource DarkGlassBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource RainbowFlowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Margin="0,0,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
                                                        <Setter Property="Text" Value="{Binding DataContext.AssistantDisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                                <Setter Property="Text" Value="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource BodyTextStyle}"/>
                                            <TextBlock Text="● Streaming..."
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SmallTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Input Area -->
                <Border Grid.Row="2" 
                        Padding="24,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Message Input -->
                        <TextBox Grid.Column="0"
                                  x:Name="MessageInput"
                                  Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                  IsEnabled="{Binding IsHealthy, FallbackValue=False}"
                                  Style="{StaticResource ValidatedGlassTextBoxStyle}"
                                  Margin="0,0,16,0"
                                  MinHeight="48"
                                  MaxHeight="120"
                                  TextWrapping="Wrap"
                                  AcceptsReturn="False"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Message input"
                                  AutomationProperties.HelpText="Type your message here. Press Enter to send"
                                  ToolTip="Type your message (Enter to send)">
                            
                        </TextBox>
                        
                        <!-- Send Button -->
                        <Button Grid.Column="1"
                                x:Name="SendButton"
                                Command="{Binding SendMessageCommand}"
                                Style="{StaticResource IconButton.Dark}"
                                IsDefault="True"
                                AutomationProperties.Name="Send message"
                                AutomationProperties.HelpText="Sends your message to the AI assistant">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2 21L23 12L2 3V10L17 12L2 14V21Z" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Typing Indicator -->
        <Border x:Name="TypingIndicator"
                Grid.Column="1"
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="32,0,32,80"
                Padding="16,12"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal">
                <Grid Width="24" Height="8" Margin="0,0,8,0">
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="AI is typing..."
                           Style="{StaticResource SmallTextStyle}"
                           AutomationProperties.Name="AI assistant is typing a response"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
