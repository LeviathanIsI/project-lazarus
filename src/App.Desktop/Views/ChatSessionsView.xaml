<UserControl x:Class="Lazarus.Desktop.Views.ChatSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Session List Panel -->
        <Border Grid.Column="0" 
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="16,16,8,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Session List Header -->
                <Border Grid.Row="0" 
                        Padding="20,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="Conversations" 
                                   Style="{StaticResource H3TextStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        
                        <Button Grid.Column="1"
                                Style="{StaticResource IconGlassButtonStyle}"
                                ToolTip="Start new conversation"
                                AutomationProperties.Name="Start new conversation"
                                AutomationProperties.HelpText="Creates a new chat conversation">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 5V19M5 12H19" 
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Session List Content -->
                <Grid Grid.Row="1">
                    <!-- Empty State for No Conversations -->
                    <Grid x:Name="NoConversationsState" 
                          Visibility="Collapsed">
                        <ContentPresenter Content="{StaticResource NoConversationsEmptyState}"
                                          Margin="20"/>
                    </Grid>

                    <!-- Session List -->
                    <ScrollViewer x:Name="SessionsScrollViewer" 
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12,8"
                                  AutomationProperties.Name="Conversations list">
                        <ItemsControl x:Name="SessionsList"
                                      KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Focusable" Value="True"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            
                            <!-- Sample Session Item -->
                            <Border Style="{StaticResource InteractiveGlassCardStyle}"
                                    Padding="16,12"
                                    Margin="0,4"
                                    Focusable="True"
                                    AutomationProperties.Name="Conversation: Model Architecture Discussion, Yesterday at 3:42 PM"
                                    >
                                <StackPanel>
                                    <TextBlock Text="Model Architecture Discussion" 
                                               Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Yesterday at 3:42 PM" 
                                               Style="{StaticResource SmallTextStyle}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="Last message: The attention mechanism allows..."
                                               Style="{StaticResource SmallTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Column="1"
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="8,16,16,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat Header -->
                <Border Grid.Row="0"
                        Padding="24,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Model Architecture Discussion"
                                       Style="{StaticResource H3TextStyle}"
                                       AutomationProperties.HeadingLevel="Level3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="8" Height="8" 
                                         Fill="{StaticResource SuccessBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Mistral-7B • Ready"
                                           Style="{StaticResource SmallTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconGlassButtonStyle}"
                                    Margin="4,0"
                                    ToolTip="Clear conversation"
                                    AutomationProperties.Name="Clear conversation"
                                    AutomationProperties.HelpText="Removes all messages from this conversation">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19 7L18.1 19.9C17.9 21.1 16.8 22 15.6 22H8.4C7.2 22 6.1 21.1 5.9 19.9L5 7M10 11V17M14 11V17M15 7V4C15 3.4 14.6 3 14 3H10C9.4 3 9 3.4 9 4V7M4 7H20"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconGlassButtonStyle}"
                                    Margin="4,0"
                                    ToolTip="Export conversation"
                                    AutomationProperties.Name="Export conversation"
                                    AutomationProperties.HelpText="Downloads conversation as text or PDF">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M14 2V8H20M10 12V18M13 15L10 18L7 15M4 22H20C21.1 22 22 21.1 22 20V8L16 2H4C2.9 2 2 2.9 2 4V20C2 21.1 2.9 22 4 22Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Messages Area -->
                <Grid Grid.Row="1">
                    <!-- Empty State for No Messages -->
                    <Grid x:Name="NoMessagesState" 
                          Visibility="Collapsed">
                        <ContentPresenter Content="{StaticResource NoMessagesEmptyState}"/>
                    </Grid>

                    <!-- Messages List -->
                    <ScrollViewer x:Name="MessagesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="24"
                                  AutomationProperties.Name="Conversation messages"
                                                                    AutomationProperties.LiveSetting="Polite">
                        <ItemsControl x:Name="MessagesList"
                                      ItemTemplate="{StaticResource ChatMessageTemplate}"
                                      KeyboardNavigation.TabNavigation="Continue">
                            
                            <!-- Sample User Message (Dark core + rainbow border) -->
                            <ContentControl Style="{StaticResource RainbowBorderChip}"
                                            HorizontalAlignment="Right"
                                            Margin="40,0,0,16"
                                            AutomationProperties.Name="Your message: Can you explain how transformer architecture works?"
                                            Content="Can you explain how transformer architecture works?"/>

                            <!-- Sample AI Response -->
                            <Border Style="{StaticResource InteractiveGlassCardStyle}"
                                    Margin="0,0,40,16"
                                    Padding="20"
                                    HorizontalAlignment="Left"
                                    Focusable="True"
                                    AutomationProperties.Name="AI response about transformer architecture"
                                    >
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- AI Avatar with Phoenix Logo -->
                                        <Border Grid.Column="0"
                                                Width="28" Height="28"
                                                Background="{StaticResource RainbowRadialBrush}"
                                                CornerRadius="14"
                                                Margin="0,0,12,0">
                                            <ContentControl Width="16" 
                                                            Height="16"
                                                            ContentTemplate="{StaticResource PhoenixLogoCompactTemplate}"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="1" 
                                                   Text="AI Assistant"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        
                                        <ContentControl Grid.Column="2"
                                                        Style="{StaticResource RainbowBorderChip}"
                                                        Content="Now"/>
                                    </Grid>
                                    
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource BodyTextStyle}"
                                               LineHeight="24">
                                        <TextBlock.Text>Transformer architecture is a neural network design that revolutionized NLP through self-attention mechanisms. Key components include:

• Self-Attention: Allows the model to weigh the importance of different words
• Multi-Head Attention: Parallel attention mechanisms for different representations  
• Positional Encoding: Adds sequence order information
• Feed-Forward Networks: Process attention outputs</TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Input Area -->
                <Border Grid.Row="2" 
                        Padding="24,16"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Message Input -->
                        <TextBox Grid.Column="0"
                                 x:Name="MessageInput"
                                 Style="{StaticResource ValidatedGlassTextBoxStyle}"
                                 Margin="0,0,16,0"
                                 MinHeight="48"
                                 MaxHeight="120"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Message input"
                                 AutomationProperties.HelpText="Type your message here. Press Ctrl+Enter to send"
                                 ToolTip="Type your message (Ctrl+Enter to send)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendMessageCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <!-- Send Button -->
                        <Button Grid.Column="1"
                                x:Name="SendButton"
                                Style="{StaticResource IconButton.Dark}"
                                IsDefault="True"
                                AutomationProperties.Name="Send message"
                                AutomationProperties.HelpText="Sends your message to the AI assistant">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2 21L23 12L2 3V10L17 12L2 14V21Z" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Typing Indicator -->
        <Border x:Name="TypingIndicator"
                Grid.Column="1"
                Style="{StaticResource StaticGlassCardStyle}"
                Margin="32,0,32,80"
                Padding="16,12"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Visibility="Collapsed"
                AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal">
                <Grid Width="24" Height="8" Margin="0,0,8,0">
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Width="4" Height="4" Fill="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.4">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.4"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="AI is typing..."
                           Style="{StaticResource SmallTextStyle}"
                           AutomationProperties.Name="AI assistant is typing a response"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
