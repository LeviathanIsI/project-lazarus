<UserControl x:Class="Lazarus.Desktop.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lazarus.Desktop.Views"
             Loaded="UserControl_Loaded"
             PreviewKeyDown="OnPreviewKeyDown"
             AllowDrop="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Local brushes (dark theme friendly) -->
        <SolidColorBrush x:Key="Img_Primary" Color="#3A7BFF"/>
        <SolidColorBrush x:Key="Img_PrimaryHover" Color="#4A86FF"/>
        <SolidColorBrush x:Key="Img_PrimarySolid" Color="#1F5AE2"/>
        <SolidColorBrush x:Key="Img_Fg" Color="#EDEDED"/>
        <SolidColorBrush x:Key="Img_Subtle" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="Img_Border" Color="#2A2A2A"/>

        <!-- Primary dark button (legacy) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Img_Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Img_Primary}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ContentPresenter x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Img_PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <!-- Running state: solid fill -->
                            <DataTrigger Binding="{Binding IsRunning, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Img_PrimarySolid}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Img_PrimarySolid}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Corruption-style primary button: Idle, Running, Success, Error -->
        <Style x:Key="PrimaryCorruptButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="360"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Outer stroke with animated gradient -->
                            <Border x:Name="Stroke" CornerRadius="12"
                                    BorderThickness="1"
                                    Background="Transparent">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
                                        <GradientStop x:Name="GS1" Color="#6AA0FF" Offset="0"/>
                                        <GradientStop x:Name="GS2" Color="#6AA0FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- Button content -->
                            <Border CornerRadius="10" Margin="1" Background="#0A000000">
                                <ContentPresenter x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="TextJitter" X="0" Y="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>

                            <!-- Scanline overlay (hidden by default) -->
                            <Border x:Name="Scanlines" IsHitTestVisible="False" Opacity="0" ClipToBounds="True" Margin="1" CornerRadius="10">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Grid>
                                    <Rectangle Height="2" VerticalAlignment="Top" Fill="#30FFFFFF" Margin="0,4,0,0"/>
                                    <Rectangle Height="1" VerticalAlignment="Center" Fill="#20FFFFFF"/>
                                    <Rectangle Height="2" VerticalAlignment="Bottom" Fill="#30FFFFFF" Margin="0,0,0,4"/>
                                </Grid>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="RunStates">
                                    <VisualState x:Name="Idle"/>
                                    <VisualState x:Name="Running">
                                        <Storyboard>
                                            <!-- Pulse stroke thickness -->
                                            <DoubleAnimation Storyboard.TargetName="Stroke" Storyboard.TargetProperty="BorderThickness.Top" From="1" To="2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="Stroke" Storyboard.TargetProperty="BorderThickness.Left" From="1" To="2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="Stroke" Storyboard.TargetProperty="BorderThickness.Right" From="1" To="2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="Stroke" Storyboard.TargetProperty="BorderThickness.Bottom" From="1" To="2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <!-- Scanlines fade in -->
                                            <DoubleAnimation Storyboard.TargetName="Scanlines" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                            <!-- Gradient drift -->
                                            <DoubleAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Offset" From="0" To="1" Duration="0:0:1.5" RepeatBehavior="Forever" AutoReverse="True"/>
                                            <DoubleAnimation Storyboard.TargetName="GS2" Storyboard.TargetProperty="Offset" From="1" To="0" Duration="0:0:1.5" RepeatBehavior="Forever" AutoReverse="True"/>
                                            <!-- Text jitter -->
                                            <DoubleAnimation Storyboard.TargetName="TextJitter" Storyboard.TargetProperty="X" From="0" To="0.7" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="Forever"/>
                                            <DoubleAnimation Storyboard.TargetName="TextJitter" Storyboard.TargetProperty="Y" From="0" To="0.7" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Success">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scanlines" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Error">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Color" To="#FF5A6A" Duration="0:0:0.2" AutoReverse="True"/>
                                            <ColorAnimation Storyboard.TargetName="GS2" Storyboard.TargetProperty="Color" To="#FF5A6A" Duration="0:0:0.2" AutoReverse="True"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost mini button for small actions -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Img_Fg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Img_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control button style (selected when Tag matches ModeString) -->
        <Style x:Key="SegmentedButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Img_Border}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ModeString, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Txt2Img"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Txt2Img"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ModeString, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Img2Img"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Img2Img"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ModeString, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Inpaint"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Inpaint"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Img_Primary}"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thin progress bar style -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource Img_Primary}"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: simple counters (bound to code-behind dummy values) -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="16,16,16,8">
            <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Images"/>
                    <TextBlock Text="{Binding TotalImages}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Generated Today"/>
                    <TextBlock Text="{Binding GeneratedToday}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Storage Used: "/>
                    <TextBlock>
                        <Run Text="{Binding StorageUsedMb, StringFormat=F2}"/>
                        <Run Text=" MB"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: inputs, actions and preview -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                    <StackPanel>
                        <!-- Prompts -->
                        <TextBlock Text="Prompt"/>
                        <TextBox x:Name="PromptTextBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding InputsEnabled}"/>

                        <TextBlock Text="Negative Prompt" Margin="0,8,0,0"/>
                        <TextBox x:Name="NegativeTextBox" Height="44" AcceptsReturn="True" TextWrapping="Wrap" IsEnabled="{Binding InputsEnabled}"/>

                        <!-- Mode segmented control -->
                        <TextBlock Text="Mode" Margin="0,8,0,6"/>
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Button Tag="Txt2Img" Content="_1 Txt2Img" Style="{StaticResource SegmentedButton}" Margin="0,0,6,0" Click="OnModeTxt2Img" IsEnabled="{Binding InputsEnabled}"/>
                            <Button Tag="Img2Img" Content="_2 Img2Img" Style="{StaticResource SegmentedButton}" Margin="0,0,6,0" Click="OnModeImg2Img" IsEnabled="{Binding InputsEnabled}"/>
                            <Button Tag="Inpaint" Content="_3 Inpaint" Style="{StaticResource SegmentedButton}" Click="OnModeInpaint" IsEnabled="{Binding InputsEnabled}"/>
                        </UniformGrid>

                        <!-- Seed tools -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Seed" VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="1" x:Name="SeedBox" Text="{Binding Seed}" Margin="8,0,8,0" VerticalContentAlignment="Center" PreviewTextInput="OnSeedPreviewTextInput" IsEnabled="{Binding InputsEnabled}"/>
                            <Button    Grid.Column="2" x:Name="DiceBtn" Content="🎲" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="OnRandomizeSeed" IsEnabled="{Binding InputsEnabled}"/>
                            <Button    Grid.Column="3" x:Name="LockBtn" Content="🔓" Style="{StaticResource GhostButton}" Click="OnToggleSeedLock" IsEnabled="True"/>
                        </Grid>

                        <!-- Generate primary button (center of gravity) -->
                        <Button x:Name="GenerateButton" Style="{StaticResource PrimaryCorruptButton}" Margin="0,10,0,6" Click="OnGenerateClick" IsEnabled="{Binding InputsEnabled}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="{Binding GenerateButtonText, Mode=OneWay}"/>
                            </TextBlock>
                        </Button>

                        <!-- Thin progress + cancel -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="JobProgress" Style="{StaticResource ThinProgress}" Grid.Column="0"
                                         IsIndeterminate="{Binding IsRunning}"
                                         Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
                            <Button Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                    Click="OnCancelClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview / Drop zone -->
                <Border Style="{StaticResource GlassCardStyle}" Padding="0" Margin="0,8,0,0">
                    <Grid x:Name="DropZone" AllowDrop="True"
                          PreviewMouseMove="OnDropZonePreviewMouseMove"
                          DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop" DragEnter="OnDropZoneDragEnter" DragLeave="OnDropZoneDragLeave">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="True">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="DropScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="DropTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Grid.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.4" RadiusX="0.85" RadiusY="0.85">
                                    <GradientStop x:Name="DZ1" Color="#101319" Offset="0"/>
                                    <GradientStop x:Name="DZ2" Color="#07090C" Offset="1"/>
                                </RadialGradientBrush>
                            </Grid.Background>
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Height="300"/>
                                <TextBlock x:Name="PlaceholderLabel" Text="Drop an image here to start"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="PNG with alpha while Inpaint = mask" Margin="4,6,0,0" Foreground="{StaticResource Img_Subtle}"/>
                    </Grid>
                </Border>

                <!-- Toasts overlay -->
                <Grid>
                    <ItemsControl x:Name="ToastItems" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202020" BorderBrush="#404040" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Text}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>

            <!-- Right: asset dropdowns -->
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- ControlNet label -->
                        <RowDefinition Height="Auto"/>  <!-- ControlNet combo -->
                        <RowDefinition Height="Auto"/>  <!-- LoRA label -->
                        <RowDefinition Height="Auto"/>  <!-- LoRA combo -->
                        <RowDefinition Height="Auto"/>  <!-- Embedding label -->
                        <RowDefinition Height="Auto"/>  <!-- Embedding combo -->
                        <RowDefinition Height="Auto"/>  <!-- Hypernetwork label -->
                        <RowDefinition Height="Auto"/>  <!-- Hypernetwork combo -->
                        <RowDefinition Height="Auto"/>  <!-- Upscaler label -->
                        <RowDefinition Height="Auto"/>  <!-- Upscaler combo -->
                        <RowDefinition Height="Auto"/>  <!-- VAE label -->
                        <RowDefinition Height="Auto"/>  <!-- VAE combo -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionControlNet">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M2,4 H14 M2,8 H14 M2,12 H14" StrokeThickness="1" Stroke="{StaticResource Img_Subtle}"/></Viewbox>
                        <TextBlock Text="ControlNet"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenControlNetFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="ControlNetCombo" Grid.Row="1" Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionLoRA">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M8,2 L14,8 L8,14 L2,8 Z"/></Viewbox>
                        <TextBlock Text="LoRA"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenLoRAFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="LoraCombo" Grid.Row="3" Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}" SelectionChanged="OnLoraSelectionChanged"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionEmbedding">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M8,1 L11,8 L8,15 L5,8 Z"/></Viewbox>
                        <TextBlock Text="Embedding"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenEmbeddingFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="EmbeddingCombo" Grid.Row="5" Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}" SelectionChanged="OnEmbeddingSelectionChanged"/>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionHyper">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M8,2 L12,5 L12,11 L8,14 L4,11 L4,5 Z"/></Viewbox>
                        <TextBlock Text="Hypernetwork"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenHyperFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="HyperCombo" Grid.Row="7" Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}" SelectionChanged="OnHyperSelectionChanged"/>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionUpscaler">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M8,1 L9,5 L13,6 L9,7 L8,11 L7,7 L3,6 L7,5 Z"/></Viewbox>
                        <TextBlock Text="Upscaler"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenUpscaleFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="UpscalerCombo" Grid.Row="9" Margin="0,4,0,8" IsEnabled="{Binding InputsEnabled}"/>

                    <StackPanel Grid.Row="10" Orientation="Horizontal" VerticalAlignment="Center" x:Name="SectionVae">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Fill="{StaticResource Img_Subtle}" Data="M5,4 L11,4 L14,8 L11,12 L5,12 L2,8 Z"/></Viewbox>
                        <TextBlock Text="VAE"/>
                        <Button Content="Open" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="OnOpenVaeFolder"/>
                    </StackPanel>
                    <ComboBox x:Name="VaeCombo" Grid.Row="11" Margin="0,4,0,0" IsEnabled="{Binding InputsEnabled}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
