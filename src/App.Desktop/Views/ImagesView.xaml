<UserControl x:Class="Lazarus.Desktop.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Background="{StaticResource BackgroundBrush}" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: simple counters (bound to code-behind dummy values) -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="16,16,16,8">
            <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Images"/>
                    <TextBlock Text="{Binding TotalImages}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Generated Today"/>
                    <TextBlock Text="{Binding GeneratedToday}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Storage Used: "/>
                    <TextBlock>
                        <Run Text="{Binding StorageUsedMb, StringFormat=F2}"/>
                        <Run Text=" MB"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: input + preview -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Border Style="{StaticResource GlassCardStyle}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Prompt"/>
                        <TextBox x:Name="PromptTextBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>

                        <TextBlock Text="Negative Prompt" Margin="0,8,0,0"/>
                        <TextBox x:Name="NegativeTextBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap"/>

                        <TextBlock Text="Mode" Margin="0,8,0,4"/>
                        <ComboBox x:Name="ModeCombo" Width="180">
                            <ComboBoxItem Content="Txt2Img"/>
                            <ComboBoxItem Content="Img2Img"/>
                            <ComboBoxItem Content="Inpaint"/>
                        </ComboBox>

                        <Button x:Name="GenerateButton" Content="Generate" Margin="0,12,0,0" Click="OnGenerateClick"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" Padding="8" Margin="0,8,0,0">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Height="256"/>
                        <TextBlock x:Name="PlaceholderLabel" Text="Click Generate to preview" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Right: asset dropdowns -->
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ControlNet"/>
                    <ComboBox x:Name="ControlNetCombo" Grid.Row="1" Margin="0,4,0,8"/>

                    <TextBlock Grid.Row="2" Text="Style Preset"/>
                    <ComboBox x:Name="StylePresetCombo" Grid.Row="3" Margin="0,4,0,8"/>

                    <TextBlock Grid.Row="4" Text="Upscaler"/>
                    <ComboBox x:Name="UpscalerCombo" Grid.Row="5" Margin="0,4,0,8"/>

                    <TextBlock Grid.Row="6" Text="VAE"/>
                    <ComboBox x:Name="VaeCombo" Grid.Row="7" Margin="0,4,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

