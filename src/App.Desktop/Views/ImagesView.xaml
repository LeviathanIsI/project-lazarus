<UserControl x:Class="Lazarus.Desktop.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- No local merges; rely on App.xaml global resources -->
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Images management content">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Image Generation &amp; Analysis" 
                                   Style="{StaticResource H1TextStyle}"
                                   AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock Text="Create, edit, and analyze images with AI-powered tools" 
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="Images page description"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Import Images"
                                Style="{StaticResource SecondaryGlassButtonStyle}"
                                Margin="0,0,12,0"
                                AutomationProperties.Name="Import image files"
                                AutomationProperties.HelpText="Import existing images for processing"/>
                        
                        <Button Content="Generate New"
                                Style="{StaticResource RainbowAccentButton.AutoFit}"
                                AutomationProperties.Name="Generate new image"
                                AutomationProperties.HelpText="Create new images using AI generation"/>
                    </StackPanel>
                </Grid>

                <!-- Quick Stats Cards -->
                <UniformGrid Grid.Row="1" 
                             Rows="1" 
                             Columns="4" 
                             Margin="0,0,0,24"
                             AutomationProperties.Name="Image management statistics">
                    
                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Total Images" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Generated Today" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Margin="0,0,12,0"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Processing" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="12" Height="12" 
                                         Fill="{StaticResource InfoBrush}" 
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Ready" 
                                           Style="{StaticResource H2TextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCardStyle}" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Storage Used" 
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="0 MB" 
                                       Style="{StaticResource H1TextStyle}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Placeholder Content Area -->
                <Grid Grid.Row="2">
                    <Border Style="{StaticResource GlassCardStyle}"
                            Padding="40">
                        <StackPanel Style="{StaticResource EmptyStateContainerStyle}">
                            <!-- Icon -->
                            <Viewbox Width="80" Height="80" Margin="0,0,0,24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4ZM4 6V18H20V6H4ZM8.5 11L11 14.5L15.5 9L20 15H4L8.5 11Z"
                                          Style="{StaticResource EmptyStateIconStyle}"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Header -->
                            <TextBlock Text="Image Generation &amp; Analysis Coming Soon"
                                       Style="{StaticResource EmptyStateHeaderStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            
                            <!-- Description -->
                            <TextBlock Style="{StaticResource EmptyStateDescriptionStyle}"
                                       TextAlignment="Center"
                                       AutomationProperties.Name="Images feature description">
                                <TextBlock.Text>This powerful image workspace will enable you to generate stunning visuals with AI models, analyze existing images, and perform advanced image editing tasks.</TextBlock.Text>
                            </TextBlock>
                            
                            <!-- Features Preview -->
                            <ItemsControl Margin="0,24,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="AI Generation" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Image Analysis" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Style Transfer" Margin="4"/>
                                    <ContentControl Style="{StaticResource RainbowBorderChip}" Content="Batch Processing" Margin="4"/>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
