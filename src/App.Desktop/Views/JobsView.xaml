<UserControl x:Class="Lazarus.App.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Jobs" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Margin="0,0,0,30"
                   Foreground="{DynamicResource PrimaryForegroundBrush}" />

        <!-- Content -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                Padding="40"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⚙️" 
                           FontSize="48" 
                           Margin="0,0,0,20" />
                <TextBlock Text="Jobs Management Coming Soon" 
                           FontSize="24" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           Margin="0,0,0,10" />
                <TextBlock Text="Advanced tools for job scheduling, monitoring, and management" 
                           FontSize="14" 
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,20" />
                <Button Content="Explore Features" 
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="20,10" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>