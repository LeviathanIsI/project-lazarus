<UserControl x:Class="Lazarus.App.Desktop.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Video" FontSize="28" FontWeight="Bold" Margin="0,0,0,30" Foreground="{DynamicResource PrimaryForegroundBrush}" />
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="40" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎬" FontSize="48" Margin="0,0,0,20" />
                <TextBlock Text="Video Processing Coming Soon" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,10" />
                <TextBlock Text="Advanced video analysis and generation capabilities" FontSize="14" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,20" />
                <Button Content="Explore Features" Style="{DynamicResource AccentButtonStyle}" Padding="20,10" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>