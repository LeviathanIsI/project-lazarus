<UserControl x:Class="Lazarus.Desktop.Views.Audio.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lazarus.Desktop.Controls">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/AudioTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="48"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT: Library -->
    <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource Border}" BorderThickness="1">
      <DockPanel>
        <!-- Search -->
        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Command="{Binding RecordCmd}" Style="{StaticResource PrimaryButton}" Content="Record"/>
          <Button Command="{Binding StopRecordCmd}" Content="Stop" Style="{StaticResource Button}" Margin="8,0,0,0"/>
          <Button Command="{Binding ImportCmd}" Content="Import" Style="{StaticResource Button}" Margin="8,0,0,0"/>
          <ToggleButton IsChecked="{Binding IsPreviewEnabled}" Content="👁 Preview" Style="{StaticResource ToggleButton}" Margin="8,0,0,0"/>
          <ComboBox Width="160" Margin="8,0,0,0" SelectedIndex="0">
            <ComboBoxItem>Name</ComboBoxItem>
            <ComboBoxItem>Date</ComboBoxItem>
            <ComboBoxItem>Size</ComboBoxItem>
            <ComboBoxItem>Duration</ComboBoxItem>
          </ComboBox>
        </StackPanel>

        <!-- List -->
        <ListView ItemsSource="{Binding Items}"
                  SelectionMode="Extended"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Width="80" Header="Waveform">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Image Source="{Binding WaveformSmall}" Height="16"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Width="*" Header="Name" DisplayMemberBinding="{Binding FileName}"/>
              <GridViewColumn Width="80" Header="Duration" DisplayMemberBinding="{Binding DurationDisplay}"/>
              <GridViewColumn Width="80" Header="Size" DisplayMemberBinding="{Binding SizeDisplay}"/>
              <GridViewColumn Width="130" Header="Modified">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding ModifiedDisplay}"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>
    </Border>

    <!-- Divider -->
    <Border Grid.Column="1" Background="{StaticResource Border}"/>

    <!-- RIGHT: Details -->
    <Grid Grid.Column="2" Background="{StaticResource SurfaceAlt}">
      <Grid.RowDefinitions>
        <RowDefinition Height="260"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="220"/>
      </Grid.RowDefinitions>

      <!-- Big Waveform -->
      <Border Grid.Row="0" Margin="12" Background="{StaticResource Surface}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Image Margin="6" Source="{Binding SelectedItem.WaveformLarge}" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>

      <!-- File Info -->
      <Border Grid.Row="1" Margin="12,0,12,8" Padding="12" Background="{StaticResource Surface}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <UniformGrid Columns="4" Rows="2">
          <TextBlock Text="Duration:"/><TextBlock Text="{Binding SelectedItem.DurationDisplay}" Margin="6,0,0,0"/>
          <TextBlock Text="Sample Rate:"/><TextBlock Text="{Binding SelectedItem.SampleRate}" Margin="6,0,0,0"/>
          <TextBlock Text="Channels:"/><TextBlock Text="{Binding SelectedItem.ChannelDisplay}" Margin="6,0,0,0"/>
          <TextBlock Text="Bitrate:"/><TextBlock Text="{Binding SelectedItem.Bitrate}" Margin="6,0,0,0"/>
        </UniformGrid>
      </Border>

      <!-- Actions -->
      <WrapPanel Grid.Row="2" Margin="12" ItemWidth="160" ItemHeight="40">
          <Button Content="Transcribe (ASR)" Command="{Binding AnalyzeCommand}" Style="{StaticResource Button}"/>
          <Button Content="Noise-Reduce" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="VAD Trim" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Normalize" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Convert" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Split on Silence" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Synthesize (TTS)" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Clone Voice" IsEnabled="False" Style="{StaticResource Button}"/>
          <Button Content="Open Folder" Command="{Binding OpenInFolderCommand}" Style="{StaticResource Button}"/>
          <Button Content="Delete" Command="{Binding DeleteCommand}" Background="{StaticResource Danger}"/>
      </WrapPanel>

      <!-- Jobs Panel -->
      <Border Grid.Row="3" Margin="12" Padding="12" Background="{StaticResource Surface}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Jobs" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ItemsControl Visibility="Collapsed" ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Title}"/>
                  <ProgressBar Value="{Binding Progress01}" Minimum="0" Maximum="1" Height="6"/>
                  <TextBlock FontSize="11" Foreground="{StaticResource Subtext}" Text="{Binding StatusText}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Bottom Transport -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1,1,1,0" Padding="8">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal">
          <Button Command="{Binding PlayPauseCommand}" Content="▶/⏸"/>
          <Button Command="{Binding StopCommand}" Content="■" Margin="8,0,0,0"/>
        </StackPanel>
        <Slider Minimum="0" Maximum="{Binding CurrentDuration.TotalSeconds}" Value="{Binding CurrentPosition.TotalSeconds, Mode=TwoWay}" Margin="12,0"/>
        <TextBlock Text="{Binding CurrentPosition, StringFormat=\{0:mm\\:ss\}}"/>
        <TextBlock Text=" / "/>
        <TextBlock Text="{Binding CurrentDuration, StringFormat=\{0:mm\\:ss\}}"/>
        <!-- Output device + meters are future add-ons for current v1 VM -->
        <!--<ComboBox Width="200" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" Margin="12,0,0,0"/>
        <local:AudioMeters Margin="12,0,0,0" PeakL="{Binding PeakL}" PeakR="{Binding PeakR}" RmsL="{Binding RmsL}" RmsR="{Binding RmsR}" />-->
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
