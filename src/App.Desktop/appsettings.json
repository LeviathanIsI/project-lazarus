{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": null,
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": false
  },
  "Orchestrator": {
    "BaseUrl": "http://127.0.0.1:11711",
    "HealthCheckInterval": "00:00:10",
    "RequestTimeout": "00:05:00"
  },
  "UI": {
    "Theme": "Dark",
    "StartupView": "Dashboard",
    "AutoSaveInterval": "00:00:30"
  },
  "BinaryValidation": {
    "BinariesPath": "D:\\project-lazarus\\binaries",
    "RunnersPath": "runners",
    "LlamaServerExecutable": "llama-server.exe",
    "LlamaRunnerDirectory": "llama-b6394-bin-win-cuda-12.4-x64",
    "ValidationTimeout": "00:00:02",
    "CheckCudaDriver": true
  },
  "Runners": {
    "LlamaCpp": {
      "ExecutablePath": "runners/llama-server.exe",
      "DefaultPort": 8080,
      "StartupTimeout": "00:00:30",
      "HealthCheckEndpoint": "/health"
    },
    "VLLM": {
      "PythonPath": "python",
      "ModulePath": "vllm.entrypoints.api_server",
      "DefaultPort": 8081,
      "StartupTimeout": "00:01:00"
    }
  }
}
