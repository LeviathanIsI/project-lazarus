<UserControl x:Class="Lazarus.Desktop.Controls.TypingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="14" MinWidth="36">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Dot 1 -->
        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=Root}" Margin="2">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1.0"
                                             Duration="0:0:0.6"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.0"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Dot 2 -->
        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=Root}" Margin="2">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1.0"
                                             Duration="0:0:0.6"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Dot 3 -->
        <Ellipse Width="6" Height="6" Fill="{Binding Foreground, ElementName=Root}" Margin="2">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.25" To="1.0"
                                             Duration="0:0:0.6"
                                             AutoReverse="True"
                                             BeginTime="0:0:0.4"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </StackPanel>
</UserControl>

