<UserControl x:Class="Lazarus.Desktop.Controls.AudioMeters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="80" MinHeight="24">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <!-- Left -->
    <Grid Grid.Column="0" Background="#16161A">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="LPeak" Grid.Row="0" Background="#59E68A" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0"/>
      <Border x:Name="LRms" Grid.Row="1" Background="#35AA60" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0"/>
    </Grid>
    <!-- Right -->
    <Grid Grid.Column="2" Background="#16161A">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border x:Name="RPeak" Grid.Row="0" Background="#59E68A" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0"/>
      <Border x:Name="RRms" Grid.Row="1" Background="#35AA60" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="0"/>
    </Grid>
  </Grid>
</UserControl>
