<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================
         RAINBOW COLORS & BRUSHES (no theme deps)
         ==================== -->

    <!-- Core Rainbow Colors - FULL SPECTRUM (100% Saturation) -->
    <Color x:Key="RainbowRed">#FF0000</Color>
    <Color x:Key="RainbowOrange">#FF8000</Color>
    <Color x:Key="RainbowYellow">#FFFF00</Color>
    <Color x:Key="RainbowGreen">#00FF00</Color>
    <Color x:Key="RainbowCyan">#00FFFF</Color>
    <Color x:Key="RainbowBlue">#0080FF</Color>
    <Color x:Key="RainbowPurple">#8000FF</Color>
    <Color x:Key="RainbowMagenta">#FF00FF</Color>

    <!-- Horizontal Rainbow Flow (seamless 0..2) -->
    <LinearGradientBrush x:Key="RainbowFlowBrush" StartPoint="0,0" EndPoint="2,0">
        <LinearGradientBrush.Transform>
            <TranslateTransform X="0"/>
        </LinearGradientBrush.Transform>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="0.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="0.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="0.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="0.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="0.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="0.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="0.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="1.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="1.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="1.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="1.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="1.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="1.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="1.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="1.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="2.0"/>
    </LinearGradientBrush>

    <!-- Vertical Rainbow Flow (seamless 0..2) -->
    <LinearGradientBrush x:Key="RainbowVerticalFlowBrush" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.Transform>
            <TranslateTransform Y="0"/>
        </LinearGradientBrush.Transform>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="0.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="0.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="0.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="0.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="0.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="0.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="0.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="1.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="1.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="1.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="1.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="1.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="1.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="1.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="1.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="2.0"/>
    </LinearGradientBrush>

    <!-- Diagonal Rainbow Flow (seamless 0..2) -->
    <LinearGradientBrush x:Key="RainbowDiagonalFlowBrush" StartPoint="0,0" EndPoint="2,2">
        <LinearGradientBrush.Transform>
            <TranslateTransform X="0" Y="0"/>
        </LinearGradientBrush.Transform>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="0.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="0.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="0.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="0.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="0.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="0.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="0.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="1.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="1.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="1.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="1.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="1.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="1.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="1.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="1.875"/>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="2.0"/>
    </LinearGradientBrush>

    <!-- Radial Rainbow Brush (with rotation transform) -->
    <RadialGradientBrush x:Key="RainbowRadialBrush" Center="0.5,0.5" RadiusX="1" RadiusY="1">
        <RadialGradientBrush.Transform>
            <RotateTransform Angle="0"/>
        </RadialGradientBrush.Transform>
        <GradientStop Color="{StaticResource RainbowRed}" Offset="0.0"/>
        <GradientStop Color="{StaticResource RainbowOrange}" Offset="0.125"/>
        <GradientStop Color="{StaticResource RainbowYellow}" Offset="0.25"/>
        <GradientStop Color="{StaticResource RainbowGreen}" Offset="0.375"/>
        <GradientStop Color="{StaticResource RainbowCyan}" Offset="0.5"/>
        <GradientStop Color="{StaticResource RainbowBlue}" Offset="0.625"/>
        <GradientStop Color="{StaticResource RainbowPurple}" Offset="0.75"/>
        <GradientStop Color="{StaticResource RainbowMagenta}" Offset="0.875"/>
    </RadialGradientBrush>

    <!-- ====================
         ANIMATIONS (no theme deps)
         ==================== -->
    <Storyboard x:Key="RainbowFlowAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(LinearGradientBrush.Transform).(TranslateTransform.X)"
                         From="0" To="-1" Duration="0:0:8"/>
    </Storyboard>

    <Storyboard x:Key="RainbowFlowFastAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(LinearGradientBrush.Transform).(TranslateTransform.X)"
                         From="0" To="-1" Duration="0:0:3"/>
    </Storyboard>

    <Storyboard x:Key="RainbowVerticalFlowAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(LinearGradientBrush.Transform).(TranslateTransform.Y)"
                         From="0" To="-1" Duration="0:0:8"/>
    </Storyboard>

    <Storyboard x:Key="RainbowVerticalFlowFastAnimation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(LinearGradientBrush.Transform).(TranslateTransform.Y)"
                         From="0" To="-1" Duration="0:0:3"/>
    </Storyboard>

    <Storyboard x:Key="RainbowRadialRotation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(RadialGradientBrush.Transform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:10"/>
    </Storyboard>

    <!-- Optional: Loading bar and status dot that do not depend on theme styles -->
    <Style x:Key="FlowingRainbowLoadingStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource RainbowFlowBrush}"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="RadiusX" Value="2"/>
        <Setter Property="RadiusY" Value="2"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-100"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                         From="-100" To="400" Duration="0:0:2">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(Rectangle.Fill).(LinearGradientBrush.Transform).(TranslateTransform.X)"
                                         From="0" To="-1" Duration="0:0:4"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RainbowStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource RainbowRadialBrush}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="(Ellipse.Fill).(RadialGradientBrush.Transform).(RotateTransform.Angle)"
                                         From="0" To="360" Duration="0:0:10"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

