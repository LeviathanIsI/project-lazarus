                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00FFFF" BlurRadius="5" ShadowDepth="0" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00FF41" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
