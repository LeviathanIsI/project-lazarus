<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Training-specific glass panels -->
    <Style x:Key="GlassPanelElevated" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPill" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#20FFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="#30FFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <!-- Status chips -->
    <Style x:Key="StatusChip.Default" TargetType="ContentControl">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="Draft">
                                        <Setter Property="Background" Value="#404040"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Queued">
                                        <Setter Property="Background" Value="#FFA500"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Running">
                                        <Setter Property="Background" Value="#00FF00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Paused">
                                        <Setter Property="Background" Value="#FFFF00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Completed">
                                        <Setter Property="Background" Value="#0080FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Failed">
                                        <Setter Property="Background" Value="#FF0000"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding}" FontSize="10" FontWeight="Medium" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rainbow glass progress bar -->
    <Style x:Key="RainbowGlassProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background" Value="#20FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="5">
                        <Grid>
                            <Rectangle Name="PART_Track" Fill="Transparent"/>
                            <Rectangle Name="PART_Indicator">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF6B46C1" Offset="0"/>
                                        <GradientStop Color="#FF3B82F6" Offset="0.33"/>
                                        <GradientStop Color="#FF10B981" Offset="0.66"/>
                                        <GradientStop Color="#FFF59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chart card container -->
    <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Meter bars -->
    <Style x:Key="MeterBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Background" Value="#20FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Rectangle Name="PART_Indicator" 
                                   Fill="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Virtualized list styles -->
    <Style x:Key="VirtualizedListView" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Data templates for dataset previews -->
    <DataTemplate x:Key="ConversationDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.TotalTokens, StringFormat='{}{0:N0} tokens'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="VoiceDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.TotalDuration, StringFormat='{}{0:hh\\:mm\\:ss}'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎙️" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="ImageDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.TotalItems, StringFormat='{}{0:N0} images'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🖼️" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="ThreeDDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.TotalVertices, StringFormat='{}{0:N0} verts'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗿" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="EntityDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.TotalItems, StringFormat='{}{0:N0} entities'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏷️" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="VideoDatasetTemplate">
        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Stats.AverageDuration, StringFormat='{}{0:mm\\:ss} avg'}" 
                       Style="{StaticResource SecondaryTextStyle}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎬" Margin="0,0,4,0" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
