    <!-- Enhanced Hover Glow Animation -->
    <Storyboard x:Key="LogoHoverGlow">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         To="1.05" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         To="1.05" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(RotateTransform.Angle)"
                         To="5" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <!-- REMOVED: Opacity animation - Keep sharp, consistent colors -->
    </Storyboard>

    <!-- Enhanced Hover Exit Animation -->
    <Storyboard x:Key="LogoHoverExit">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         To="1.0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         To="1.0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(RotateTransform.Angle)"
                         To="0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Enhanced Scale Animation (Thread-Safe Alternative) -->
    <Storyboard x:Key="LogoGlowEnhancement">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         From="1.0" To="1.03" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         From="1.0" To="1.03" Duration="0:0:0.3">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Scale Reset Animation (Thread-Safe Alternative) -->
    <Storyboard x:Key="LogoGlowReset">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                         To="1.0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                         To="1.0" Duration="0:0:0.4">
            <DoubleAnimation.EasingFunction>
                <QuadraticEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ====================
         ANIMATED PHOENIX LOGO STYLES
         ==================== -->

    <!-- Static Phoenix Logo - NO BREATHING/PULSING -->
    <Style x:Key="BreathingPhoenixLogoStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource PhoenixLogoTemplate}"/>
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <!-- REMOVED: Breathing animation - Keep static for sharp, consistent colors -->
            
            <!-- Enhanced hover interaction with glow -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource LogoHoverGlow}"/>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowEnhancement}"/>
            </EventTrigger>
            
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource LogoHoverExit}"/>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowReset}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Static Agent Activity Phoenix Logo - NO BREATHING/PULSING -->
    <Style x:Key="AgentActivityPhoenixLogoStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource PhoenixLogoTemplate}"/>
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <!-- REMOVED: Default breathing animation - Keep static -->
            <!-- REMOVED: Agent activity pulse - No pulsing allowed -->

            <!-- Enhanced hover interaction -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource LogoHoverGlow}"/>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowEnhancement}"/>
            </EventTrigger>
            
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource LogoHoverExit}"/>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowReset}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Static Sidebar Logo - NO BREATHING/PULSING -->
    <Style x:Key="SidebarBreathingLogoStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource PhoenixLogoCompactTemplate}"/>
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <!-- REMOVED: Breathing animation - Keep static -->
            <!-- REMOVED: Agent activity indication - No pulsing -->

            <!-- Hover enhancement for sidebar - NO OPACITY CHANGES -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- REMOVED: Opacity change -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.05" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.05" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowEnhancement}"/>
            </EventTrigger>
            
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- REMOVED: Opacity change -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowReset}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Legacy Animated Phoenix Logo - Preserved for Compatibility -->
    <Style x:Key="AnimatedPhoenixLogoStyle" TargetType="ContentControl" BasedOn="{StaticResource BreathingPhoenixLogoStyle}">
        <!-- Inherits breathing animation behavior -->
    </Style>

    <!-- Static Sidebar Collapsed Logo Style - NO OPACITY CHANGES -->
    <Style x:Key="SidebarCollapsedLogoStyle" TargetType="ContentControl" BasedOn="{StaticResource SidebarBreathingLogoStyle}">
        <!-- Inherits static behavior -->
        <Setter Property="Opacity" Value="1.0"/>
        <Style.Triggers>
            <!-- Override hover behavior for collapsed state - NO OPACITY CHANGES -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- REMOVED: Opacity change -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.08" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.08" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowEnhancement}"/>
            </EventTrigger>
            
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- REMOVED: Opacity change -->
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         To="1.0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         To="1.0" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard Storyboard="{StaticResource LogoGlowReset}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Static Loading Phoenix Logo - NO BREATHING/PULSING -->
    <Style x:Key="LoadingPhoenixLogoStyle" TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource PhoenixLogoTemplate}"/>
        <Setter Property="Opacity" Value="1.0"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <RotateTransform Angle="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <!-- REMOVED: Default breathing animation - Keep static -->
            <!-- REMOVED: Enhanced loading animation - No pulsing -->
            <!-- REMOVED: Enhanced scale during loading - Keep consistent scale -->
        </Style.Triggers>
    </Style>

</ResourceDictionary>