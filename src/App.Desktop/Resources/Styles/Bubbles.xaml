<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rainbow chat bubble with scrim and readable text; reuses existing rainbow brushes -->
    <Style x:Key="RainbowBubble" TargetType="ContentControl">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- Rainbow base -->
                        <Border Background="{StaticResource RainbowFlowBrush}"
                                CornerRadius="14"/>

                        <!-- Scrim for contrast -->
                        <Border Background="#33000000"
                                CornerRadius="12"
                                Margin="2"/>

                        <!-- Content -->
                        <ContentPresenter Margin="4,2"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"
                                          TextElement.FontWeight="SemiBold"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
