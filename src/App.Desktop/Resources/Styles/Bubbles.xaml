<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lazarus.Desktop.Controls">

    <!-- Rainbow chat bubble with scrim and readable text; reuses existing rainbow brushes -->
    <Style x:Key="RainbowBubble" TargetType="ContentControl">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- Rainbow base -->
                        <Border Background="{StaticResource RainbowFlowBrush}"
                                CornerRadius="14"/>

                        <!-- Scrim for contrast -->
                        <Border Background="#33000000"
                                CornerRadius="12"
                                Margin="2"/>

                        <!-- Content -->
                        <ContentPresenter Margin="4,2"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="Black"
                                          TextElement.FontWeight="SemiBold"
                                          TextOptions.TextFormattingMode="Display"
                                          TextOptions.TextRenderingMode="ClearType">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="White" BlurRadius="1.8" ShadowDepth="0" Opacity="0.95"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chat bubble with rainbow background (right/user) -->
    <Style x:Key="RainbowBubbleRight" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="40,0,0,16">
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="12"/>
                        <Border Background="#33000000" CornerRadius="10" Margin="2"/>
                        <controls:OutlineTextBlock Margin="20"
                                                   Text="{TemplateBinding Content}"
                                                   Foreground="Black"
                                                   FontWeight="Normal"
                                                   Stroke="White" StrokeThickness="1.4"
                                                   TextWrapping="Wrap"
                                                   SnapsToDevicePixels="True"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   TextOptions.TextHintingMode="Fixed">
                            <controls:OutlineTextBlock.Effect>
                                <DropShadowEffect Color="White"
                                                  ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextOutlineBlur}"
                                                  Opacity="{DynamicResource RainbowTextOutlineOpacity}"/>
                            </controls:OutlineTextBlock.Effect>
                        </controls:OutlineTextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
