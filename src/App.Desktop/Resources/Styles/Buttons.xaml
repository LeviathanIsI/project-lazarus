<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:controls="clr-namespace:Lazarus.Desktop.Controls">

    <!-- Shared outline constants for rainbow text legibility -->
    <sys:Double x:Key="RainbowTextOutlineBlur">2.6</sys:Double>
    <sys:Double x:Key="RainbowTextOutlineOpacity">0.96</sys:Double>

    <!-- Stroke + glow tuning for rainbow text -->
    <sys:Double x:Key="RainbowTextStroke">3.0</sys:Double>
    <sys:Double x:Key="RainbowTextGlowBlur">6</sys:Double>
    <sys:Double x:Key="RainbowTextGlowOpacity">0.35</sys:Double>

    <!-- Readable rainbow button -->
    <Style x:Key="RainbowButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Rainbow base -->
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="10"/>
                        <!-- Scrim for contrast -->
                        <Border Background="#33000000" CornerRadius="8" Margin="2"/>
                        <!-- White feather band (center stronger, edges transparent) -->
                        <Border CornerRadius="8" Margin="2" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="White" Opacity="0.16"/>
                            </Border.Background>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.00"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.20"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.80"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <!-- Content -->
                        <controls:OutlineTextBlock
                                                   Text="{TemplateBinding Content}"
                                                   Fill="Black"
                                                   Stroke="White"
                                                   StrokeThickness="{DynamicResource RainbowTextStroke}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                            <controls:OutlineTextBlock.Effect>
                                <DropShadowEffect Color="White" ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextGlowBlur}"
                                                  Opacity="{DynamicResource RainbowTextGlowOpacity}"/>
                            </controls:OutlineTextBlock.Effect>
                        </controls:OutlineTextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button (send) -->
    <Style x:Key="RainbowIconButton" TargetType="Button" BasedOn="{StaticResource RainbowButton}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="10"/>
                        <Border Background="#33000000" CornerRadius="8" Margin="2"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          TextOptions.TextFormattingMode="Display"
                                          TextOptions.TextRenderingMode="ClearType"
                                          TextOptions.TextHintingMode="Fixed">
                            <ContentPresenter.Effect>
                                <!-- Icon-only can look too glowy; keep effect for now -->
                                <DropShadowEffect Color="White" ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextOutlineBlur}"
                                                  Opacity="{DynamicResource RainbowTextOutlineOpacity}"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Optional tiny pill outline example (for reference in views) -->
    <DataTemplate x:Key="PillLabelOutlineSample">
        <Grid>
            <TextBlock Text="New" Foreground="Black" Margin="1,0,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="0,1,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="-1,0,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="0,-1,0,0"/>
            <TextBlock Text="New" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>
