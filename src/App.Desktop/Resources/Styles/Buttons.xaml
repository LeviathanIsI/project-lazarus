<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Readable rainbow button -->
    <Style x:Key="RainbowButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Rainbow base -->
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="10"/>
                        <!-- Scrim for contrast -->
                        <Border Background="#66000000" CornerRadius="8" Margin="2"/>
                        <!-- Content -->
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"
                                          TextElement.FontWeight="SemiBold">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button (send) -->
    <Style x:Key="RainbowIconButton" TargetType="Button" BasedOn="{StaticResource RainbowButton}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="10"/>
                        <Border Background="#66000000" CornerRadius="8" Margin="2"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="White" TextElement.FontWeight="SemiBold">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Optional tiny pill outline example (for reference in views) -->
    <DataTemplate x:Key="PillLabelOutlineSample">
        <Grid>
            <TextBlock Text="New" Foreground="Black" Margin="1,0,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="0,1,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="-1,0,0,0"/>
            <TextBlock Text="New" Foreground="Black" Margin="0,-1,0,0"/>
            <TextBlock Text="New" Foreground="White" FontWeight="Bold"/>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>
