<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reusable rainbow gradient button with scrim for readability -->
    <Style x:Key="RainbowButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Rainbow base (use existing gradient brush) -->
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="10"/>

                        <!-- Semi-transparent scrim to improve text contrast -->
                        <Border Background="#33000000" CornerRadius="8" Margin="2"/>

                        <!-- Content -->
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"
                                          TextElement.FontWeight="SemiBold">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black"
                                                  BlurRadius="3"
                                                  ShadowDepth="1"
                                                  Opacity="0.8"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- keep default interaction behavior; template is visually stable -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Optional sample: tiny pill label outline (e.g., "NEW") -->
    <DataTemplate x:Key="PillLabelOutlineSample">
        <Grid>
            <!-- Outline (shadow) -->
            <TextBlock Text="NEW"
                       Foreground="Black"
                       FontWeight="Bold"
                       Margin="1,1,0,0"/>
            <!-- Foreground label -->
            <TextBlock Text="NEW"
                       Foreground="White"
                       FontWeight="Bold"/>
        </Grid>
    </DataTemplate>
    
</ResourceDictionary>
