<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lazarus.Desktop.Controls">

    <!-- Rainbow chip/pill with scrim for text readability; reuses existing rainbow brushes -->
    <Style x:Key="RainbowChip" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="16"/>
                        <Border Background="#33000000" CornerRadius="14" Margin="2"/>
                        <controls:OutlineTextBlock Margin="12,6"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{TemplateBinding Content}"
                                                   Foreground="Black" FontWeight="SemiBold"
                                                   Stroke="White" StrokeThickness="1.4"
                                                   SnapsToDevicePixels="True"
                                                   TextOptions.TextFormattingMode="Display"
                                                   TextOptions.TextRenderingMode="ClearType"
                                                   TextOptions.TextHintingMode="Fixed">
                            <controls:OutlineTextBlock.Effect>
                                <DropShadowEffect Color="White" ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextOutlineBlur}"
                                                  Opacity="{DynamicResource RainbowTextOutlineOpacity}"/>
                            </controls:OutlineTextBlock.Effect>
                        </controls:OutlineTextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny New pill with faux outline -->
    <Style x:Key="RainbowNewPill" TargetType="ContentControl" BasedOn="{StaticResource RainbowChip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="12"/>
                        <Border Background="#33000000" CornerRadius="10" Margin="2"/>
                        <Grid Margin="10,4">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" Margin="1,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" Margin="0,1,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" Margin="-1,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" Margin="0,-1,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="Black" FontWeight="Bold"
                                       SnapsToDevicePixels="True"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"
                                       TextOptions.TextHintingMode="Fixed"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chips/Pills with rainbow border -->
    <Style x:Key="RainbowBorderChip" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="12" BorderThickness="2" Background="#1A1A1A">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFEF4444" Offset="0.00"/>
                                    <GradientStop Color="#FFF59E0B" Offset="0.25"/>
                                    <GradientStop Color="#FF10B981" Offset="0.50"/>
                                    <GradientStop Color="#FF06B6D4" Offset="0.75"/>
                                    <GradientStop Color="#FF3B82F6" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                        <TextBlock Margin="12,6" Text="{TemplateBinding Content}"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
