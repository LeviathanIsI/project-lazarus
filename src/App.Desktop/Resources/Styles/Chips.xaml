<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rainbow chip/pill with scrim for text readability; reuses existing rainbow brushes -->
    <Style x:Key="RainbowChip" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="16"/>
                        <Border Background="#66000000" CornerRadius="14" Margin="2"/>
                        <ContentPresenter Margin="12,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="White" TextElement.FontWeight="SemiBold">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny New pill with faux outline -->
    <Style x:Key="RainbowNewPill" TargetType="ContentControl" BasedOn="{StaticResource RainbowChip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="12"/>
                        <Border Background="#66000000" CornerRadius="10" Margin="2"/>
                        <Grid Margin="10,4">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="Black" Margin="1,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="Black" Margin="0,1,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="Black" Margin="-1,0,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="Black" Margin="0,-1,0,0"/>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
