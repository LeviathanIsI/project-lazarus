<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Rainbow chip/pill with scrim for text readability; reuses existing rainbow brushes -->
    <Style x:Key="RainbowChip" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="16"/>
                        <Border Background="#33000000" CornerRadius="14" Margin="2"/>
                        <ContentPresenter Margin="12,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="White" TextElement.FontWeight="SemiBold">
                            <ContentPresenter.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.8"/>
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
