<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lazarus.Desktop.Controls">

    <!-- Rainbow chip/pill with scrim for text readability; reuses existing rainbow brushes -->
    <Style x:Key="RainbowChip" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="16"/>
                        <Border Background="#33000000" CornerRadius="14" Margin="2"/>
                        <!-- White feather band (center stronger, edges transparent) -->
                        <Border CornerRadius="14" Margin="2" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="White" Opacity="0.16"/>
                            </Border.Background>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.00"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.20"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.80"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <controls:OutlineTextBlock Margin="12,6"
                                                   Text="{TemplateBinding Content}"
                                                   Fill="Black"
                                                   Stroke="White"
                                                   StrokeThickness="{DynamicResource RainbowTextStroke}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                            <controls:OutlineTextBlock.Effect>
                                <DropShadowEffect Color="White" ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextGlowBlur}"
                                                  Opacity="{DynamicResource RainbowTextGlowOpacity}"/>
                            </controls:OutlineTextBlock.Effect>
                        </controls:OutlineTextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny New pill with faux outline -->
    <Style x:Key="RainbowNewPill" TargetType="ContentControl" BasedOn="{StaticResource RainbowChip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource RainbowFlowBrush}" CornerRadius="12"/>
                        <Border Background="#33000000" CornerRadius="10" Margin="2"/>
                        <!-- White feather band (center stronger, edges transparent) -->
                        <Border CornerRadius="10" Margin="2" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="White" Opacity="0.16"/>
                            </Border.Background>
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0.00"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.20"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.80"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <controls:OutlineTextBlock Margin="12,6"
                                                   Text="{TemplateBinding Content}"
                                                   Fill="Black"
                                                   Stroke="White"
                                                   StrokeThickness="{DynamicResource RainbowTextStroke}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                            <controls:OutlineTextBlock.Effect>
                                <DropShadowEffect Color="White" ShadowDepth="0"
                                                  BlurRadius="{DynamicResource RainbowTextGlowBlur}"
                                                  Opacity="{DynamicResource RainbowTextGlowOpacity}"/>
                            </controls:OutlineTextBlock.Effect>
                        </controls:OutlineTextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
