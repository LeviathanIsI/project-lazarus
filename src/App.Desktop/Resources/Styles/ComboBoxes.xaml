<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base brushes for dark inputs -->
  <SolidColorBrush x:Key="InputDarkBackgroundBrush" Color="#222"/>
  <SolidColorBrush x:Key="InputDarkBorderBrush" Color="#444"/>
  <SolidColorBrush x:Key="InputDarkForegroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InputDarkHoverBrush" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="InputDarkSelectedBrush" Color="#333"/>

  <!-- Make TextBox dark by default (based on existing glass style if present) -->
  <Style TargetType="TextBox" BasedOn="{StaticResource GlassTextBoxStyle}"/>

  <!-- ComboBox item look -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource InputDarkForegroundBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputDarkBackgroundBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource InputDarkSelectedBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource InputDarkHoverBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dark ComboBox template -->
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource InputDarkForegroundBrush}"/>
    <Setter Property="Background" Value="{StaticResource InputDarkBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InputDarkBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"/>
            <DockPanel>
              <!-- Toggle Button -->
              <ToggleButton x:Name="ToggleButton"
                            DockPanel.Dock="Right"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Width="28">
                <Path Data="M 0 0 L 6 6 L 12 0 Z"
                      Fill="{StaticResource InputDarkForegroundBrush}"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </ToggleButton>

              <!-- Content presenter -->
              <ContentPresenter Margin="6,2,30,2"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                RecognizesAccessKey="True"/>

              <!-- Popup -->
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Border Background="{StaticResource InputDarkBackgroundBrush}"
                        BorderBrush="{StaticResource InputDarkBorderBrush}"
                        BorderThickness="1">
                  <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </DockPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
