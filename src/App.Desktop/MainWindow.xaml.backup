<Window x:Class="Lazarus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Lazarus.Desktop.Converters"
        mc:Ignorable="d"
        Title="Lazarus" 
        Height="720" 
        Width="1280"
        MinHeight="600"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource GlassmorphicWindowStyle}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons/LazarusLogo.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:ViewToTagConverter x:Key="ViewToTagConverter"/>
            
            <!-- Animations -->
        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarColumn" 
                             Storyboard.TargetProperty="Width.Value"
                             To="280" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoText" 
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="NavLabels" 
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.3"/>
        </Storyboard>
        
        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarColumn" 
                             Storyboard.TargetProperty="Width.Value"
                             To="64" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoText" 
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="NavLabels" 
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
        </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="12" 
                      CaptionHeight="64" 
                      ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>
    
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource BackgroundBrush}"
                Height="64"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Draggable Title Area -->
                <Border Grid.Column="0" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="False"/>
                
                <!-- Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,16,0">
                    <!-- Minimize Button -->
                    <Button x:Name="MinimizeButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 19H18V17H6V19Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    
                    <!-- Maximize/Restore Button -->
                    <Button x:Name="MaximizeRestoreButton" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Restore Down">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="MaximizeRestoreIcon"
                                      Data="M5 16H8V14H5V11H3V16H5ZM8 8V5H5V3H10V8H8ZM14 19H19V14H21V19H14ZM16 8V3H21V5H19V8H16Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    
                    <!-- Close Button -->
                    <Button x:Name="CloseButton" 
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Style="{StaticResource GlassCardStyle}"
                Margin="16,16,8,16"
                Padding="0"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lazarus Phoenix Logo - 24x24 for Sidebar with Breathing Animation -->
                        <ContentControl Grid.Column="0" 
                                        Width="24" 
                                        Height="24"
                                        ContentTemplate="{StaticResource PhoenixLogoCompactTemplate}"
                                        Style="{StaticResource SidebarBreathingLogoStyle}"
                                        DataContext="{Binding}"
                                        VerticalAlignment="Center"/>

                        <!-- Logo Text with proper spacing -->
                        <TextBlock Grid.Column="1" 
                                   x:Name="LogoText"
                                   Text="Lazarus" 
                                   Style="{StaticResource H2TextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                        <!-- Toggle Button -->
                        <Button Grid.Column="2" 
                                Style="{StaticResource IconGlassButtonStyle}"
                                Command="{Binding Navigation.ToggleSidebarCommand}">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3 12H21M3 6H21M3 18H21" 
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavLabels" Margin="0,8">
                        
                        <!-- Dashboard -->
                        <Button Style="{StaticResource NavGlassButtonStyle}"
                                Command="{Binding Navigation.NavigateCommand}"
                                CommandParameter="Dashboard"
                                Tag="{Binding Navigation.SelectedView, Converter={StaticResource ViewToTagConverter}, ConverterParameter=Dashboard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 13H11V3H3V13ZM3 21H11V15H3V21ZM13 21H21V11H13V21ZM13 3V9H21V3H13Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Chat Sessions -->
                        <Button Style="{StaticResource NavGlassButtonStyle}"
                                Command="{Binding Navigation.NavigateCommand}"
                                CommandParameter="ChatSessions"
                                Tag="{Binding Navigation.SelectedView, Converter={StaticResource ViewToTagConverter}, ConverterParameter=ChatSessions}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21 11.5C21 16.75 16.75 21 11.5 21C6.25 21 2 16.75 2 11.5C2 6.25 6.25 2 11.5 2M11.5 2C16.75 2 21 6.25 21 11.5V13C21 14.5 19.5 16 18 16C16.5 16 15 14.5 15 13V11.5" 
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                              StrokeThickness="2"
                                              Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Chat Sessions" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Model Management -->
                        <Button Style="{StaticResource NavGlassButtonStyle}"
                                Command="{Binding Navigation.NavigateCommand}"
                                CommandParameter="Models"
                                Tag="{Binding Navigation.SelectedView, Converter={StaticResource ViewToTagConverter}, ConverterParameter=Models}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M9 3V18H12V3H9M12 18H15V3H12M5 3V18H8V5H5" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Models" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- MEDIA TYPE CATEGORIES - Coming Soon -->
                        
                        <!-- Category Separator -->
                        <TextBlock Text="Media Processing" 
                                   Style="{StaticResource NavCategorySeparatorStyle}"
                                   Margin="24,16,24,8"/>

                        <!-- Images -->
                        <Button Style="{StaticResource DisabledNavAccessibilityStyle}"
                                AutomationProperties.Name="Images - Coming Soon">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ComingSoonTooltipStyle}"
                                         Content="Image processing and vision capabilities"/>
                            </Button.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 19 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Images" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Videos -->
                        <Button Style="{StaticResource DisabledNavAccessibilityStyle}"
                                AutomationProperties.Name="Videos - Coming Soon">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ComingSoonTooltipStyle}"
                                         Content="Video analysis and processing capabilities"/>
                            </Button.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M17 10.5V7C17 6.45 16.55 6 16 6H4C3.45 6 3 6.45 3 7V17C3 17.55 3.45 18 4 18H16C16.55 18 17 17.55 17 17V13.5L21 17.5V6.5L17 10.5Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Videos" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Entities -->
                        <Button Style="{StaticResource DisabledNavAccessibilityStyle}"
                                AutomationProperties.Name="Entities - Coming Soon">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ComingSoonTooltipStyle}"
                                         Content="Entity extraction and knowledge graphs"/>
                            </Button.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L12 2L3 7V9C3 10.1 3.9 11 5 11V22H7V16H9V22H11V11C11.6 11 12.1 10.9 12.5 10.6L18 14.5V22H20V14L14.8 10.2C15.4 9.8 16.1 9.5 16.8 9.3L21 9Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Entities" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 3D Models -->
                        <Button Style="{StaticResource DisabledNavAccessibilityStyle}"
                                AutomationProperties.Name="3D Models - Coming Soon">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ComingSoonTooltipStyle}"
                                         Content="3D asset management and processing"/>
                            </Button.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 2L2 7L12 12L22 7L12 2ZM12 4.84L16.47 7L12 9.16L7.53 7L12 4.84ZM5 9L11 12V21.5L5 18.5V9ZM13 12L19 9V18.5L13 21.5V12Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="3D Models" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Audio -->
                        <Button Style="{StaticResource DisabledNavAccessibilityStyle}"
                                AutomationProperties.Name="Audio - Coming Soon">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ComingSoonTooltipStyle}"
                                         Content="Audio processing and speech capabilities"/>
                            </Button.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 9V15H7L12 20V4L7 9H3ZM16.5 12C16.5 10.23 15.5 8.71 14 7.97V16.02C15.5 15.29 16.5 13.77 16.5 12ZM14 3.23V5.29C16.89 6.15 19 8.83 19 12C19 15.17 16.89 17.85 14 18.71V20.77C18.01 19.86 21 16.28 21 12C21 7.72 18.01 4.14 14 3.23Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Audio" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Training Jobs -->
                        <Button Style="{StaticResource NavGlassButtonStyle}"
                                Command="{Binding Navigation.NavigateCommand}"
                                CommandParameter="Training"
                                Tag="{Binding Navigation.SelectedView, Converter={StaticResource ViewToTagConverter}, ConverterParameter=Training}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 2L2 9L12 16L22 9L12 2ZM12 7L17 10.5L12 14L7 10.5L12 7ZM2 17L12 24L22 17L20 15.8L12 20.7L4 15.8L2 17Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Training" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- Separator -->
                        <Border Height="1" 
                                Background="{StaticResource GlassBorderBrush}" 
                                Margin="16,16"/>

                        <!-- Settings -->
                        <Button Style="{StaticResource NavGlassButtonStyle}"
                                Command="{Binding Navigation.NavigateCommand}"
                                CommandParameter="Settings"
                                Tag="{Binding Navigation.SelectedView, Converter={StaticResource ViewToTagConverter}, ConverterParameter=Settings}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 15.5C10.07 15.5 8.5 13.93 8.5 12C8.5 10.07 10.07 8.5 12 8.5C13.93 8.5 15.5 10.07 15.5 12C15.5 13.93 13.93 15.5 12 15.5M19.43 12.97C19.47 12.65 19.5 12.33 19.5 12C19.5 11.67 19.47 11.34 19.43 11L21.54 9.37C21.73 9.22 21.78 8.95 21.66 8.73L19.66 5.27C19.54 5.05 19.27 4.96 19.05 5.05L16.56 6.05C16.04 5.66 15.5 5.32 14.87 5.07L14.5 2.42C14.46 2.18 14.25 2 14 2H10C9.75 2 9.54 2.18 9.5 2.42L9.13 5.07C8.5 5.32 7.96 5.66 7.44 6.05L4.95 5.05C4.73 4.96 4.46 5.05 4.34 5.27L2.34 8.73C2.21 8.95 2.27 9.22 2.46 9.37L4.57 11C4.53 11.34 4.5 11.67 4.5 12C4.5 12.33 4.53 12.65 4.57 12.97L2.46 14.63C2.27 14.78 2.21 15.05 2.34 15.27L4.34 18.73C4.46 18.95 4.73 19.03 4.95 18.95L7.44 17.94C7.96 18.34 8.5 18.68 9.13 18.93L9.5 21.58C9.54 21.82 9.75 22 10 22H14C14.25 22 14.46 21.82 14.5 21.58L14.87 18.93C15.5 18.67 16.04 18.34 16.56 17.94L19.05 18.95C19.27 19.03 19.54 18.95 19.66 18.73L21.66 15.27C21.78 15.05 21.73 14.78 21.54 14.63L19.43 12.97Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Status -->
                <Border Grid.Row="2" 
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Model Status -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" 
                                     Width="8" 
                                     Height="8" 
                                     Fill="#10B981"/>
                            <TextBlock Grid.Column="1" 
                                       Text="Model Ready" 
                                       Style="{StaticResource SmallTextStyle}"
                                       Margin="8,0,0,0"/>
                        </Grid>
                        
                        <!-- Performance -->
                        <TextBlock Grid.Row="1" 
                                   Text="42 tokens/sec" 
                                   Style="{StaticResource SmallTextStyle}"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1"
                Style="{StaticResource GlassCardStyle}"
                Margin="8,16,16,16"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" 
                        Padding="24,20"
                        Height="64">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page Title -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Navigation.SelectedView}" 
                                   Style="{StaticResource H2TextStyle}"
                                   VerticalAlignment="Center"/>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconGlassButtonStyle}" Margin="4,0">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M10 21H14C14 22.1 13.1 23 12 23C10.9 23 10 22.1 10 21ZM21 19V20H3V19L5 17V11C5 7.9 7.03 5.17 10 4.29V4C10 2.9 10.9 2 12 2C13.1 2 14 2.9 14 4V4.29C16.97 5.17 19 7.9 19 11V17L21 19Z" 
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconGlassButtonStyle}" Margin="4,0">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" 
                                                 Width="20" Height="20"
                                                 Fill="{StaticResource PrimaryGradientBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Presenter -->
                <ContentPresenter Grid.Row="1" 
                                  x:Name="ContentArea"
                                  Content="{Binding Navigation.CurrentView}"
                                  Margin="24"/>
            </Grid>
        </Border>
        </Grid>
    </Grid>

</Window>