{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Database": {
    "EnableSensitiveDataLogging": true
  },
  "Orchestrator": {
    "HealthCheckInterval": "00:00:05"
  }
}