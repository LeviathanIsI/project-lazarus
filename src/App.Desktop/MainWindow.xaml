<Window x:Class="Lazarus.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lazarus.App.Desktop.Views"
        xmlns:services="clr-namespace:Lazarus.App.Desktop.Services"
        xmlns:converters="clr-namespace:Lazarus.App.Desktop.Converters"
        Title="{Binding WindowTitle}" 
        Height="800" 
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource LazarusWindowStyle}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NavigationStyleConverter x:Key="NavigationStyleConverter" />
        
        <!-- Navigation Content Templates -->
        <DataTemplate x:Key="DashboardTemplate">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate x:Key="ConversationsTemplate">
            <views:ConversationsView />
        </DataTemplate>
        <DataTemplate x:Key="ModelConfigurationTemplate">
            <views:ModelConfigurationView />
        </DataTemplate>
        <DataTemplate x:Key="RunnerManagerTemplate">
            <views:RunnerManagerView />
        </DataTemplate>
        <DataTemplate x:Key="JobsTemplate">
            <views:JobsView />
        </DataTemplate>
        <DataTemplate x:Key="DatasetsTemplate">
            <views:DatasetsView />
        </DataTemplate>
        <DataTemplate x:Key="ImagesTemplate">
            <views:ImagesView />
        </DataTemplate>
        <DataTemplate x:Key="VideoTemplate">
            <views:VideoView />
        </DataTemplate>
        <DataTemplate x:Key="VoiceTemplate">
            <views:VoiceView />
        </DataTemplate>
        <DataTemplate x:Key="ThreeDModelsTemplate">
            <views:ThreeDModelsView />
        </DataTemplate>
        <DataTemplate x:Key="EntitiesTemplate">
            <views:EntitiesView />
        </DataTemplate>
        <DataTemplate x:Key="TrainingTemplate">
            <views:TrainingView />
        </DataTemplate>
        
        <!-- Remove placeholder template - use actual views -->
        
        <!-- Content Template Selector -->
        <services:NavigationContentTemplateSelector x:Key="NavigationContentTemplateSelector" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" 
                Style="{DynamicResource NavigationPanelStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Logo/Header Section -->
                    <Border Style="{DynamicResource NavigationLogoStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧪" 
                                       FontSize="20" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Lazarus" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentBrush}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- CORE Section -->
                    <TextBlock Text="CORE" Style="{DynamicResource NavigationSectionHeaderStyle}" />
                    
                    <Button Content="Dashboard" 
                            Command="{Binding NavigateToDashboardCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Dashboard" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Conversations" 
                            Command="{Binding NavigateToConversationsCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Conversations" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>

                    <!-- MANAGEMENT Section -->
                    <TextBlock Text="MANAGEMENT" Style="{DynamicResource NavigationSectionHeaderStyle}" />
                    
                    <Button Content="Model Configuration" 
                            Command="{Binding NavigateToModelConfigurationCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Model Configuration" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Runner Manager" 
                            Command="{Binding NavigateToRunnerManagerCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Runner Manager" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Jobs" 
                            Command="{Binding NavigateToJobsCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Jobs" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Datasets" 
                            Command="{Binding NavigateToDatasetsCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Datasets" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>

                    <!-- MULTIMEDIA Section -->
                    <TextBlock Text="MULTIMEDIA" Style="{DynamicResource NavigationSectionHeaderStyle}" />
                    
                    <Button Content="Images" 
                            Command="{Binding NavigateToImagesCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Images" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Video" 
                            Command="{Binding NavigateToVideoCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Video" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Voice" 
                            Command="{Binding NavigateToVoiceCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Voice" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="3D Models" 
                            Command="{Binding NavigateToThreeDModelsCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="3D Models" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>
                    <Button Content="Entities" 
                            Command="{Binding NavigateToEntitiesCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Entities" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>

                    <!-- TRAINING Section -->
                    <TextBlock Text="TRAINING" Style="{DynamicResource NavigationSectionHeaderStyle}" />
                    
                    <Button Content="Training" 
                            Command="{Binding NavigateToTrainingCommand}">
                        <Button.Style>
                            <MultiBinding Converter="{StaticResource NavigationStyleConverter}">
                                <Binding Path="CurrentSection" />
                                <Binding Source="Training" />
                            </MultiBinding>
                        </Button.Style>
                    </Button>

                    <!-- Theme Selection at Bottom -->
                    <Border Margin="16,30,16,16" 
                            Padding="12" 
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Theme" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{DynamicResource LazarusComboBoxStyle}"
                                      FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dynamic Content Area -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource PrimaryBackgroundBrush}">
                <ContentPresenter x:Name="MainContentPresenter"
                                  Content="{Binding NavigationService.CurrentViewModel}"
                                  ContentTemplateSelector="{StaticResource NavigationContentTemplateSelector}"
                                  Style="{DynamicResource ContentAreaStyle}" />
            </Border>

            <!-- Status Bar -->
            <StatusBar Grid.Row="1" 
                       Background="{DynamicResource SecondaryBackgroundBrush}"
                       BorderThickness="0,1,0,0"
                       BorderBrush="{DynamicResource BorderBrush}">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{DynamicResource PrimaryForegroundBrush}" />
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="System Status: " 
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <Ellipse Width="8" 
                                 Height="8" 
                                 Fill="{Binding ApiStatusBrush}" 
                                 Margin="4,0,12,0" />
                        <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss}}" 
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>