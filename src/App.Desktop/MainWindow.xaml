<Window x:Class="Lazarus.App.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="600" 
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource LazarusWindowStyle}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryBrush}" 
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🧪" 
                               FontSize="24" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0" />
                    <TextBlock Text="Lazarus Training Platform" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Theme Selection -->
                    <TextBlock Text="Theme:" 
                               VerticalAlignment="Center" 
                               Foreground="White"
                               Margin="0,0,8,0" />
                    <ComboBox Name="ThemeSelectionComboBox"
                              ItemsSource="{Binding AvailableThemes}"
                              SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Theme"
                              Width="140"
                              VerticalAlignment="Center"
                              Style="{DynamicResource LazarusComboBoxStyle}"
                              Margin="0,0,15,0"
                              ToolTip="Select application theme" />
                    
                    <Button Content="Refresh" 
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="New Session" 
                            Command="{Binding CreateSessionCommand}"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" 
                    Margin="10"
                    Style="{DynamicResource LazarusTabControlStyle}">
            
            <!-- Training Sessions Tab -->
            <TabItem Header="Training Sessions" 
                     Style="{DynamicResource LazarusTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Controls -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource BackgroundBrush}" 
                            Padding="10" 
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filter by Status:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding StatusFilter}" 
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Width="150"
                                      Style="{DynamicResource LazarusComboBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- Sessions List -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TrainingSessions}"
                              SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Style="{DynamicResource LazarusDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" 
                                                Binding="{Binding Name}" 
                                                Width="200" />
                            <DataGridTextColumn Header="Status" 
                                                Binding="{Binding Status}" 
                                                Width="100" />
                            <DataGridTextColumn Header="Progress" 
                                                Binding="{Binding Progress, StringFormat={}{0:F1}%}" 
                                                Width="80" />
                            <DataGridTextColumn Header="Created" 
                                                Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                                Width="130" />
                            <DataGridTextColumn Header="Description" 
                                                Binding="{Binding Description}" 
                                                Width="*" />
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▶" 
                                                    Command="{Binding DataContext.StartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Start Session"
                                                    Margin="2"
                                                    Padding="5,2"
                                                    Style="{DynamicResource ActionButtonStyle}" />
                                            <Button Content="⏹" 
                                                    Command="{Binding DataContext.StopSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Stop Session"
                                                    Margin="2"
                                                    Padding="5,2"
                                                    Style="{DynamicResource ActionButtonStyle}" />
                                            <Button Content="🗑" 
                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete Session"
                                                    Margin="2"
                                                    Padding="5,2"
                                                    Style="{DynamicResource DangerButtonStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard" 
                     Style="{DynamicResource LazarusTabItemStyle}">
                <ScrollViewer>
                    <StackPanel Margin="20">
                        <TextBlock Text="System Overview" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Active Sessions Card -->
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource CardBackgroundBrush}" 
                                    Margin="0,0,10,0" 
                                    Padding="20" 
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Active Sessions" 
                                               FontSize="14" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding ActiveSessionsCount}" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Completed Sessions Card -->
                            <Border Grid.Column="1" 
                                    Background="{DynamicResource CardBackgroundBrush}" 
                                    Margin="5,0" 
                                    Padding="20" 
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Completed Sessions" 
                                               FontSize="14" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding CompletedSessionsCount}" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Total Sessions Card -->
                            <Border Grid.Column="2" 
                                    Background="{DynamicResource CardBackgroundBrush}" 
                                    Margin="10,0,0,0" 
                                    Padding="20" 
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="Total Sessions" 
                                               FontSize="14" 
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TotalSessionsCount}" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" 
                   Background="{DynamicResource BackgroundBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="API Status: " />
                    <Ellipse Width="10" 
                             Height="10" 
                             Fill="{Binding ApiStatusBrush}" 
                             Margin="2,0,10,0" />
                    <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH:mm:ss}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>