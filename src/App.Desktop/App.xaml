<Application x:Class="Lazarus.App.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dynamic theme resources will be loaded here by ThemeManager -->
                <!-- Default Dark theme loaded on startup -->
                <ResourceDictionary Source="Resources/Themes/DarkTheme.xaml" />
                
                <!-- Legacy theme for compatibility during transition -->
                <ResourceDictionary Source="Themes/LazarusTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global application resources that persist across theme changes -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            
            <!-- Font resources with emoji fallback -->
            <FontFamily x:Key="PrimaryFontFamily">Segoe UI, Segoe UI Emoji, Noto Color Emoji</FontFamily>
            <FontFamily x:Key="MonospaceFontFamily">Consolas, Courier New, monospace</FontFamily>
            
            <!-- Common converters and resources -->
            <Style x:Key="FadeInAnimation" TargetType="FrameworkElement">
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                From="0" To="1" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>