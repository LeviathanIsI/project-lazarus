<Application x:Class="Lazarus.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary
            xmlns:vm="clr-namespace:Lazarus.Desktop.ViewModels"
            xmlns:views="clr-namespace:Lazarus.Desktop.Views"
            xmlns:vmtraining="clr-namespace:Lazarus.Desktop.ViewModels.Training"
            xmlns:viewstraining="clr-namespace:Lazarus.Desktop.Views.Training"
            xmlns:converters="clr-namespace:Lazarus.Desktop.Converters"
            xmlns:behaviors="clr-namespace:Lazarus.Desktop.Behaviors">
            <ResourceDictionary.MergedDictionaries>
                <!-- Load in dependency order -->
                <ResourceDictionary Source="Themes/BaseResources.xaml"/>
                <ResourceDictionary Source="Resources/Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Resources/Themes/RainbowGradients.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Chips.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Bubbles.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Tabs.xaml"/>
                <ResourceDictionary Source="Themes/Glassmorphic.xaml"/>
                <ResourceDictionary Source="Themes/GlassmorphicControls.xaml"/>

                <!-- Rest of resources -->
                <ResourceDictionary Source="Resources/Icons/LazarusLogo.xaml"/>
                <ResourceDictionary Source="Themes/UXEnhancements.xaml"/>
                <ResourceDictionary Source="Templates/EmptyStateTemplates.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ComboBoxes.xaml"/>
                <!-- Settings section view templates -->
                <ResourceDictionary Source="Resources/SettingsTemplates.xaml"/>
                <!-- Training resources (panels, chips, dataset previews) -->
                <ResourceDictionary Source="Resources/Training/TrainingResources.xaml"/>
                <ResourceDictionary Source="Resources/TrainingStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:StringToBooleanConverter x:Key="StringToBooleanConverter"/>
            <converters:ModalityToLeftHeaderConverter x:Key="ModalityToLeftHeaderConverter"/>
            <converters:ModalityToRightHeaderConverter x:Key="ModalityToRightHeaderConverter"/>
            <converters:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter"/>
            <converters:EqualityConverter x:Key="EqualityConverter"/>
            <converters:LfStatusToBrushConverter x:Key="LfStatusToBrush"/>
            <converters:LfStatusToGlyphConverter x:Key="LfStatusToGlyph"/>

            <!-- Ensure all ScrollViewers respond to mouse wheel scrolling -->
            <Style TargetType="ScrollViewer">
                <Setter Property="behaviors:MouseWheelScrollBehavior.Enable" Value="True"/>
                <Setter Property="PanningMode" Value="VerticalFirst"/>
            </Style>

            <!-- Keyless, global DataTemplates mapping section VMs to Views -->
            <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
                <views:GeneralSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PathsSettingsViewModel}">
                <views:PathsSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrchestratorSettingsViewModel}">
                <views:OrchestratorSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RunnersSettingsViewModel}">
                <views:RunnersSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModelsSettingsViewModel}">
                <views:ModelsSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AudioSettingsViewModel}">
                <views:AudioSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RagSettingsViewModel}">
                <views:RagSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrainingSettingsViewModel}">
                <views:TrainingSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoggingSettingsViewModel}">
                <views:LoggingSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdvancedSettingsViewModel}">
                <views:AdvancedSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AvatarsSettingsViewModel}">
                <views:AvatarSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GlobalActionsViewModel}">
                <views:GlobalActionsView/>
            </DataTemplate>
            
            <!-- Training modality designer templates -->
            <DataTemplate DataType="{x:Type vmtraining:ConversationsDesignerViewModel}">
                <viewstraining:ConversationsDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:VoiceDesignerViewModel}">
                <viewstraining:VoiceDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:ImagesDesignerViewModel}">
                <viewstraining:ImagesDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:ThreeDModelsDesignerViewModel}">
                <viewstraining:ThreeDModelsDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:EntitiesDesignerViewModel}">
                <viewstraining:EntitiesDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:VideosDesignerViewModel}">
                <viewstraining:VideosDesignerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmtraining:DesignProgressViewModel}">
                <viewstraining:DesignProgressView/>
            </DataTemplate>

            <!-- Fallback debug template: shows when no specific template matches -->
            <DataTemplate DataType="{x:Type vm:SettingsSectionBase}">
                <Border BorderBrush="Tomato" BorderThickness="2" Background="#10FF6347" Padding="8" CornerRadius="6">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
