{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "OrchestratorHost": {
    "ProcessMonitoringIntervalSeconds": 30,
    "EnableResourceMonitoring": true,
    "CpuThresholdPercent": 80.0,
    "MemoryThresholdMB": 1024,
    "DiskThresholdPercent": 90.0,
    "MaxConcurrentTrainingProcesses": 4,
    "TrainingProcessTimeoutMinutes": 30
  }
}