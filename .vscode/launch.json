{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Lazarus Desktop App",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-desktop",
            "program": "${workspaceFolder}/src/App.Desktop/bin/Debug/net8.0-windows/Lazarus.App.Desktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/App.Desktop",
            "console": "internalConsole",
            "stopAtEntry": false,
            "requireExactSource": false
        },
        {
            "name": "Launch Lazarus Desktop App (Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-desktop-release",
            "program": "${workspaceFolder}/src/App.Desktop/bin/Release/net8.0-windows/Lazarus.App.Desktop.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/App.Desktop",
            "console": "internalConsole",
            "stopAtEntry": false,
            "requireExactSource": false
        }
    ]
}