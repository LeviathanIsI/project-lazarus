<Project>

  <!-- Global Build Configuration for Lazarus WPF Stack -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Release Configuration Quality Gates -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <!-- Specific warnings to treat as errors -->
    <WarningsAsErrors>CS1998;CS8602;CS0168</WarningsAsErrors>
  </PropertyGroup>

  <!-- Assembly Information -->
  <PropertyGroup>
    <Company>Lazarus Development Authority</Company>
    <Product>Lazarus WPF LLM Inference Platform</Product>
    <Copyright>Copyright © 2025 Lazarus Development Authority</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-alpha</InformationalVersion>
  </PropertyGroup>

</Project>